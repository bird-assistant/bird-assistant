.speech-note{margin:12px 0;min-width:0;color:#285b49;font-size:12px}.speech-notice,.speech-preview>.speech-text{display:block;color:#71816c;font-size:11px;line-height:1.7;margin-bottom:8px}.speech-hold{padding:13px 10px;border:1px solid #d8e3d2;border-radius:12px;background:#edf3e7;text-align:center;line-height:20px}.speech-recording{background:#e1ead9}.speech-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:10px 0}.speech-actions .speech-button,.speech-preview .speech-button{min-height:34px;margin:0;padding:5px 10px;font-size:12px;line-height:24px;background:#edf3e7;color:#285b49;border-radius:9px}.speech-actions .speech-button::after,.speech-preview .speech-button::after{border:0}.speech-preview{margin-top:12px}.speech-preview .speech-input{box-sizing:border-box;width:100%;min-height:64px;padding:10px;margin-bottom:10px;border:1px solid #d8e3d2;border-radius:10px;background:#fffef9;color:#263f35;font-size:14px;line-height:1.6}.speech-error{display:block;color:#a25c48;line-height:1.7;margin-top:10px}
