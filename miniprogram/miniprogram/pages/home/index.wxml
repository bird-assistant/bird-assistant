<app-header title="{{sheet ? (detail ? '观察详情' : regionName) : '羽迹'}}" back="{{sheet || searchOpen}}" bindback="back" />
<field-map wx:if="{{!demoMap}}"/><view wx:else class="map-screen {{mapMoving ? 'map-moving' : ''}}" style="height:{{height}}px" bindtap="closeSearch">
  <view class="map-gesture" catchtap="closeSearch" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel"><view class="map-world" style="width:{{worldW}}px;height:{{worldH}}px;margin-left:-{{worldW/2}}px;margin-top:-{{worldH/2}}px;transform:translate({{x}}px,{{y}}px) scale({{zoom}})">
    <image wx:for="{{tiles}}" wx:key="id" src="/assets/map-preview.png" class="map-tile" mode="scaleToFill" style="left:{{item.x}}%;top:{{item.y}}%" /><text class="map-label lake">湖畔公园</text><text class="map-label wood">林间小径</text><text class="map-label water">湖面</text><view class="user-dot" style="left:50.75%;top:72.65625%;transform:translate(-50%,-50%) scale({{invZoom}})" />
  </view></view>
    <button wx:for="{{screenMarkers}}" wx:key="id" class="map-pin {{item.private ? 'private-pin' : ''}}" style="left:{{item.screenX}}px;top:{{item.screenY}}px;transform:translate(-50%,-50%)" data-id="{{item.id}}" catchtap="marker" aria-label="{{item.private ? '我的私人标记' : '公开观察'}}"><image wx:if="{{item.private}}" src="/assets/icons/pin.png" class="i" /><text wx:else>{{item.count}}</text></button>
    <view wx:if="{{focusPin}}" class="map-focus" style="left:{{focusPin.screenX}}px;top:{{focusPin.screenY}}px;transform:translate(-50%,-50%)"><image src="/assets/icons/pin.png" class="i" /></view>

  <view class="map-top" catchtap="noop"><view class="search-box"><image src="/assets/icons/search.png" class="i" /><input placeholder="搜地点，找一处新发现" value="{{query}}" focus="{{searchFocused}}" bindinput="search" bindfocus="searchFocus" bindblur="searchBlur" /><button class="text-button" bindtap="searchAction">{{searchOpen ? '取消' : '查找'}}</button></view>
    <scroll-view wx:if="{{searchOpen}}" scroll-y class="search-results" style="height:{{results.length > 3 ? 174 : (results.length ? results.length * 57 : 50)}}px"><button wx:for="{{results}}" wx:key="id" class="place-result" data-id="{{item.id}}" bindtap="choosePlace"><text>{{item.name}}</text><text class="tiny">示例地点 · 点击定位</text></button><view wx:if="{{!results.length}}" class="pad-small muted">暂无匹配地点</view></scroll-view>
    <view class="map-filters"><picker range="{{visibilityOptions}}" value="{{visibility}}" data-key="visibility" bindchange="filter"><view class="filter">{{visibilityOptions[visibility]}}<view class="chevron" /></view></picker><picker range="{{dateOptions}}" value="{{date}}" data-key="date" bindchange="filter"><view class="filter">{{dateOptions[date]}}<view class="chevron" /></view></picker><picker range="{{speciesOptions}}" value="{{species}}" data-key="species" bindchange="filter"><view class="filter">{{speciesOptions[species]}}<view class="chevron" /></view></picker></view>
  </view>
  <view class="map-controls"><button data-delta="0.2" catchtap="zoom" aria-label="放大"><image class="i" src="/assets/icons/plus.png" /></button><button data-delta="-0.2" catchtap="zoom" aria-label="缩小"><image class="i" src="/assets/icons/minus.png" /></button><button catchtap="locate" aria-label="回到示例位置"><image class="i" src="/assets/icons/locate.png" /></button></view>
  <view class="map-legend">● 公开观察　◇ 我的私人标记</view><button class="map-summary" catchtap="openSummary"><view class="row between"><text class="strong">{{regionName}}</text><text class="pill">{{sheetRecords.length}} 条记录</text></view><view class="muted">地图中心附近 · 点开查看地点与公开活动</view></button><view class="map-credit">示意地图 · 虚构地点 · 演示数据</view>
  <view wx:if="{{sheet}}" class="sheet-backdrop" catchtap="closeSheet" /><scroll-view wx:if="{{sheet}}" scroll-y catchtap="noop" class="map-sheet" style="height:{{sheetHeight}}px"><view class="map-sheet-body"><view class="handle" /><view class="row between"><view class="section-title">{{detail ? detail.name : regionName}}</view><button class="icon-button" bindtap="closeSheet" aria-label="关闭地点面板"><image class="i" src="/assets/icons/close.png" /></button></view>
    <block wx:if="{{detail}}"><button class="text-button" bindtap="backToPlace">返回地点观察</button><image class="detail-image" src="{{detail.image}}" mode="aspectFill" /><view class="note">示例插画 · {{detail.author}} · {{detail.date}}<view>{{detail.private ? '私人示例标记' : '公开观察示例'}}；不是实际物种识别。</view></view></block>
    <block wx:else><view class="muted">{{sheetRecords.length}} 条公开示例观察，记录数不代表鸟的个体数量。</view><view class="row spaced place-actions"><button data-kind="saved" bindtap="activity">{{saved ? '已收藏 · 示例' : '公开收藏'}}</button><button data-kind="checked" bindtap="activity">{{checked ? '已打卡 · 示例' : '公开打卡'}}</button></view><view wx:for="{{sheetRecords}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="openRecord"><image class="record-image" src="{{item.image}}" mode="aspectFill" /><view class="record-copy"><view class="strong">{{item.name}}</view><view class="muted">{{item.author}} · {{item.date}}</view><view class="tiny">示例公开观察</view></view><image class="i" src="/assets/icons/arrow.png" /></view><view wx:if="{{!sheetRecords.length}}" class="empty">此筛选条件下暂无公开记录</view></block>
  </view></scroll-view>
</view>
