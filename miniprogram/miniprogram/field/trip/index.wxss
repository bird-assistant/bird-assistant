.trip{padding:32rpx 28rpx 90rpx;color:#254839;background:#f6f8ef;min-height:100vh}.title{font-size:42rpx;font-weight:650}.card{background:#fffef8;padding:24rpx;margin:20rpx 0;border-radius:24rpx;line-height:1.7}.heading{font-size:34rpx;font-weight:600}.muted,.weather{font-size:25rpx;color:#52685c}.controls{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0}.controls button,.controls picker,.card button{background:#eaf2e7;color:#225742;border-radius:15rpx;padding:8rpx 18rpx;font-size:26rpx;line-height:1.6;margin:0}.trip textarea{box-sizing:border-box;width:100%;height:140rpx;background:white;border-radius:20rpx;padding:16rpx}.ask{background:#285b49;color:white;margin:16rpx 0}.advisory,.error{color:#755326;margin:10rpx 0}

.advice-overview{background:linear-gradient(140deg,#e8efde,#fffef8);border:1px solid #d8e3cf;padding:28rpx}.advice-kicker{display:block;margin-bottom:9rpx;font-size:21rpx;letter-spacing:2rpx;color:#7c8e6e}.advice-headline{font-size:36rpx;font-weight:600;line-height:1.65;color:#285b49}.advice-window{margin-top:16rpx;font-size:22rpx}.advice-focus{margin-top:10rpx;font-size:24rpx}.advice-section-title{font-size:29rpx;font-weight:600;margin-bottom:14rpx}.advice-line{display:flex;align-items:flex-start;gap:14rpx;font-size:27rpx;line-height:1.85;margin:10rpx 0}.advice-dot{width:8rpx;height:8rpx;flex:none;border-radius:50%;background:#94ab7e;margin-top:21rpx}.advice-paragraph{display:block;margin-top:18rpx;font-size:27rpx;line-height:1.9}.disclosure-button{width:100%;display:flex;align-items:center;justify-content:space-between;min-height:44px;background:transparent;color:#6d825e;font-size:24rpx;text-align:left}.disclosure-button::after{border:0}.disclosure-chevron{width:12rpx;height:12rpx;border-right:1.5px solid #7e9470;border-bottom:1.5px solid #7e9470;transform:rotate(45deg);transition:transform .18s}.disclosure-open{transform:rotate(225deg)}.source-line{display:flex;gap:14rpx;font-size:23rpx;margin-bottom:14rpx}.source-label{color:#70885f;flex:none}.itinerary-row{display:flex;gap:18rpx;margin-top:22rpx;font-size:26rpx}.itinerary-time{flex:none;width:78rpx;color:#8ba077;font-variant-numeric:tabular-nums}.itinerary-action{flex:1;min-width:0;line-height:1.8}.stop-actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.stop-actions button{display:flex;align-items:center;justify-content:center;min-height:42px;flex:1;gap:8rpx}.stop-actions .stop-navigate{background:#285b49;color:#fffef9}.navigate-icon{width:26rpx;height:30rpx;filter:brightness(0) invert(1)}.trip .card{border:1px solid #e0e7d7}.card .controls{gap:10rpx}.card .controls button{font-size:22rpx;min-height:36px}.weather{padding:8rpx 0;font-variant-numeric:tabular-nums}@media(prefers-reduced-motion:reduce){.disclosure-chevron{transition:none}}

.history-row{width:100%;text-align:left;margin-top:14px;white-space:normal}.reference-places{display:flex;flex-direction:column;gap:8px;margin:12px 0}.reference-places button{display:flex;align-items:center;gap:8px;min-height:44px;padding:10px;text-align:left;font-size:13px}.reference-places image{width:17px;height:19px;flex:none}.reference-places button>text:first-of-type{flex:1;min-width:0}.history-row .heading{overflow-wrap:anywhere}

.trip-heading{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}.trip-heading>.title{flex:1;min-width:0;margin:0;font-size:22px;line-height:1.45}.trip-heading>.text-button{flex:none;width:auto;max-width:90px;min-height:36px;padding:6px 0;white-space:nowrap;font-size:12px}

.controls picker{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:42px}.picker-chevron{width:6px;height:6px;border-bottom:1.5px solid currentColor;border-right:1.5px solid currentColor;transform:rotate(45deg);margin-top:-3px;flex:none}.trip-section-heading{display:flex;align-items:center;justify-content:flex-start;width:100%;min-height:48px;padding:0!important;background:transparent!important;text-align:left;gap:12px;font-size:16px!important;font-weight:600}.trip-section-heading>image{width:25px;height:25px;flex:none}.trip-section-heading>text,.trip-section-heading>view:not(.disclosure-chevron){flex:1;min-width:0}.trip-section-heading text{display:block}.trip-section-kicker{font-size:10px;letter-spacing:1px;color:#7b8c70;font-weight:400;margin-bottom:2px}.weather-card{border-left:3px solid #b5c7d6!important}.visit-card{border-left:3px solid #9bb29b!important}.stop-card{border-left:3px solid #d0bc96!important}.advice-section{border-left:3px solid #c0ccb0!important}.trip .card .disclosure-button{padding-left:0;padding-right:0;background:transparent;margin-top:12px}.trip .heading{font-size:17px}

.trip{max-width:700px;margin:0 auto;padding:22px 20px calc(40px + env(safe-area-inset-bottom));background:linear-gradient(150deg,#f1f5e9 0,#fafbf5 46%);min-height:100vh}.trip-heading{align-items:center;margin:2px 0 22px;justify-content:space-between}.trip-heading>view{flex:1;min-width:0}.trip-heading .title{font-size:25px;line-height:1.4;letter-spacing:.2px;margin:5px 0 0}.trip-eyebrow{font-size:10px;color:#879d75;letter-spacing:2px}.trip .card{padding:18px;border-radius:20px;margin:16px 0;background:#fffef9;box-shadow:0 3px 14px #285b4906}.trip-origin{border-top:3px solid #8eaa79!important}.origin-kicker{display:block;font-size:10px;color:#8a997c;letter-spacing:1px;margin-bottom:7px}.trip-origin .heading{font-size:20px;font-weight:600;line-height:1.5}.origin-actions{margin:14px 0 16px!important}.trip .origin-actions button{flex:1;width:0;min-height:40px;padding:9px 8px;font-size:12px;border-radius:12px}.condition-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px!important;margin:10px 0!important}.trip .card .trip-condition{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:72px;padding:12px;border:1px solid #e0e8d7;border-radius:14px;background:#f3f6ec;text-align:left;width:100%;box-sizing:border-box}.condition-copy{flex:1;min-width:0}.condition-label{display:block;font-size:10px;color:#7b906d;margin-bottom:6px}.condition-value{display:block;font-size:14px;color:#315e47;font-variant-numeric:tabular-nums}.picker-chevron{align-self:center;flex:none;margin:0 2px 4px 0;width:7px;height:7px}.question-label{display:flex;justify-content:space-between;font-size:14px;font-weight:600;margin:20px 0 9px}.question-label text{font-size:11px;font-weight:400;color:#8c9c7c}.trip textarea{font-size:14px;min-height:100px;height:100px;border:1px solid #dbe5d1;background:#fffef9;border-radius:16px;line-height:1.8;padding:13px}.trip .ask{min-height:50px;border-radius:15px;font-size:16px;margin:18px 0 22px;box-shadow:0 5px 16px #285b491c}.trip>.muted{font-size:11px;line-height:1.8;color:#87977a;margin-top:10px}.advice-headline{font-size:22px;line-height:1.5}.advice-section-title{font-size:15px;color:#345b45}.trip .trip-section-heading{min-height:52px;font-size:17px!important;line-height:1.5}.trip-section-heading>.disclosure-chevron{margin-left:auto;flex:none}.trip .advice-line{font-size:14px;margin:12px 0}.trip .advice-paragraph{font-size:14px;line-height:1.9}.trip .weather{padding:11px 0;border-bottom:1px solid #e6ecdf;font-size:13px}.weather-card{background:#f5f8f8!important}.stop-card{background:#f9f7f0!important}.trip .itinerary-time{width:54px;font-size:12px;color:#506f4e}.trip .itinerary-action{font-size:14px}.trip .source-line{flex-wrap:wrap;line-height:1.8}.trip .muted{line-height:1.8}.trip .disclosure-chevron{flex:none;min-width:7px;min-height:7px}@media(min-width:700px){.trip{padding:32px 40px}.trip-origin .condition-grid{gap:16px!important}.trip .card{padding:24px}.trip-heading .title{font-size:29px}}@media(max-width:350px){.trip{padding-left:14px;padding-right:14px}.trip .card{padding:14px}.condition-value{font-size:12px}.trip-heading .title{font-size:22px}}
