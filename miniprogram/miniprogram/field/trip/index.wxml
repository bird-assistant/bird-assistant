<view class="page trip"><view wx:if="{{accountChecking}}" class="note">正在确认当前账号…<view wx:if="{{error}}">{{error}}<button bindtap="checkAccount">重试</button></view></view><block wx:else><block wx:if="{{showHistory}}"><view class="trip-heading"><view class="title">观鸟咨询记录</view><button class="text-button" bindtap="newConsultation">新咨询</button></view><view class="muted">当前社区账号在本机的最近 20 次咨询，每次保留最近 6 轮。切换设备不会同步。</view><view wx:if="{{historyLoading}}" class="note">正在读取…</view><view wx:if="{{error}}" class="error note">{{error}}<button bindtap="loadHistory">重试</button></view><view wx:for="{{historyRows}}" wx:key="id" class="consultation-card"><button class="consultation-main" data-id="{{item.id}}" bindtap="openHistory"><view class="consultation-date"><image src="/assets/icons/clock.png"/><text>{{item.updated}}</text><text class="consultation-turns">{{item.turns}} 轮咨询</text></view><view class="consultation-question">{{item.question}}</view><view class="consultation-place"><image src="/assets/icons/pin.png"/><text>{{item.place}}</text></view><view class="consultation-conditions">{{item.date}} · {{item.conditions}}</view><view class="consultation-excerpt">{{item.excerpt}}</view></button><view class="consultation-footer"><button data-id="{{item.id}}" bindtap="openHistory">查看这次咨询<view class="picker-chevron"/></button><button class="consultation-remove" data-id="{{item.id}}" bindtap="removeHistory">删除记录</button></view></view><view wx:if="{{!historyLoading && !historyRows.length && !error}}" class="note">还没有保存的咨询。生成建议后会自动出现在这里。</view></block><block wx:else>
  <view class="trip-heading"><view><text class="trip-eyebrow">羽迹 · 出行顾问</text><view class="title">这次想去哪里看鸟？</view></view><button class="text-button" bindtap="listHistory">咨询记录</button></view><view wx:if="{{historyNotice}}" class="note">{{historyNotice}}</view>
  <view class="card trip-origin"><text class="origin-kicker">从这里出发</text><view class="heading">{{place}}</view><view wx:if="{{regionLabel}}" class="origin-region">{{regionLabel}}<text>附近区域推断</text></view><view class="muted" wx:if="{{point}}">约 {{point.latitude}}°, {{point.longitude}}° · 仅使用大致区域</view>
    <view class="controls origin-actions"><button bindtap="locate">使用我的位置</button><button bindtap="pick">地图选点</button></view>
    <view class="controls condition-grid"><button class="trip-condition" data-field="date" bindtap="openCondition"><view class="condition-copy"><text class="condition-label">出发日期</text><text class="condition-value">{{date}}</text></view><view class="picker-chevron"/></button>
      <button class="trip-condition" data-field="hour" bindtap="openCondition"><view class="condition-copy"><text class="condition-label">出发时间</text><text class="condition-value">{{times[hour]}}</text></view><view class="picker-chevron"/></button></view>
    <view class="controls condition-grid"><button class="trip-condition" data-field="hours" bindtap="openCondition"><view class="condition-copy"><text class="condition-label">停留时长</text><text class="condition-value">{{hours}} 小时</text></view><view class="picker-chevron"/></button>
      <button class="trip-condition" data-field="radius" bindtap="openCondition"><view class="condition-copy"><text class="condition-label">附近范围</text><text class="condition-value">{{radius}} 公里</text></view><view class="picker-chevron"/></button></view>
    <view class="condition-help">停留为观鸟时间；范围为直线距离，不含路程。</view><view class="muted">北京时间 · {{speciesLabel}}</view><button wx:if="{{species}}" bindtap="allBirds">改看所有鸟种</button></view>
  <view class="controls"><button data-text="第一次观鸟，哪个区域比较近？" bindtap="prompt">第一次观鸟</button><button data-text="想拍鸟，哪里近期记录比较多？" bindtap="prompt">摄影选点</button></view>
<button wx:if="{{exchanges.length}}" class="disclosure-button" bindtap="history">{{historyOpen ? '收起前面的咨询' : '前面的咨询 · '+exchanges.length}}<view class="disclosure-chevron {{historyOpen ? 'disclosure-open' : ''}}"/></button><block wx:if="{{historyOpen}}"><view wx:for="{{exchanges}}" wx:key="turn" class="card"><view class="heading">{{item.question}}</view><text class="advice-paragraph" user-select>{{item.answer}}</text></view></block>
  <view class="question-label">这次想怎么逛？<text>选填</text></view><textarea placeholder="想看什么鸟？有多少时间？也可以继续追问。" value="{{question}}" maxlength="240" bindinput="input" disabled="{{busy}}"/>
  <view class="muted">提交后将问题、大致区域、出行条件和必要的对话上下文发给阿里云百炼。</view>
  <button class="ask" bindtap="ask" disabled="{{busy}}" loading="{{busy}}">{{busy?'正在查询天气和鸟讯':answer?'继续咨询':'生成出行建议'}}</button><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{answer}}"><view wx:if="{{historySaved}}" class="muted">{{historySaved}}</view><view wx:if="{{answer.legacyWarning}}" class="note">{{answer.legacyWarning}}</view><view class="card advice-overview"><text class="advice-kicker">这次出行</text><view class="advice-headline">{{answer.brief ? answer.brief.headline : asked}}</view><view class="muted advice-window">{{windowLabel}} · 北京时间</view><view wx:if="{{answer.focus}}" class="advice-focus">目标 · {{answer.focus}}</view><block wx:if="{{!answer.brief}}"><text wx:for="{{paragraphs}}" wx:if="{{answerExpanded || index === 0}}" wx:key="index" class="advice-paragraph" user-select>{{item}}</text><button wx:if="{{paragraphs.length > 1}}" class="disclosure-button" bindtap="toggleAnswer">{{answerExpanded ? '收起建议' : '展开完整建议'}}<view class="disclosure-chevron {{answerExpanded ? 'disclosure-open' : ''}}"/></button></block></view>
    <view wx:if="{{answer.referenceMap.length}}" class="reference-places"><button wx:for="{{answer.referenceMap}}" wx:key="id" data-id="{{item.id}}" bindtap="referenceMap"><image src="/assets/icons/pin.png"/><text>{{item.name}}</text><text class="muted">{{item.kind === 'park' ? '地点' : '公开区域'}} · {{item.km}} 公里</text></button></view>
    <view wx:for="{{answer.visits}}" wx:key="destination" class="card visit-card"><button class="trip-section-heading" data-id="visit-{{index}}" bindtap="toggleTripSection"><image src="/assets/icons/scan.png"/><view><text class="trip-section-kicker">怎么观察</text><text>{{item.name}}</text></view><view class="disclosure-chevron {{tripExpanded['visit-'+index] ? 'disclosure-open' : ''}}"/></button><view class="advice-paragraph">{{item.why}}</view><block wx:if="{{tripExpanded['visit-'+index]}}"><view class="advice-section-title">优先找的环境 · 一般观察建议</view><view wx:for="{{item.habitats}}" wx:key="*this" class="advice-paragraph">{{item}}</view><view class="advice-section-title">留意什么</view><view wx:for="{{item.watchFor}}" wx:key="*this" class="advice-paragraph">{{item}}</view><view class="advice-paragraph">{{item.timing}}</view><view class="muted">{{item.uncertainty}}</view></block></view>
    <view wx:for="{{sections}}" wx:key="title" class="card advice-section"><button class="trip-section-heading" data-id="section-{{index}}" bindtap="toggleTripSection"><image src="/assets/icons/{{index === 0 ? 'pin' : index === 1 ? 'leaf' : index === 2 ? 'settings' : 'clock'}}.png"/><text>{{item.title}}</text><view class="disclosure-chevron {{tripExpanded['section-'+index] ? 'disclosure-open' : ''}}"/></button><view wx:for="{{item.lines}}" wx:for-index="lineIndex" wx:if="{{tripExpanded['section-'+index] || lineIndex === 0}}" wx:key="index" class="advice-line"><view class="advice-dot"/><text user-select>{{item}}</text></view></view>
    <view wx:if="{{answer.brief}}" class="advice-disclosure"><button class="disclosure-button" bindtap="details">{{detailOpen ? '收起完整说明' : '查看完整说明'}}<view class="disclosure-chevron {{detailOpen ? 'disclosure-open' : ''}}"/></button><view wx:if="{{detailOpen}}" class="card"><text wx:for="{{paragraphs}}" wx:key="index" class="advice-paragraph" user-select>{{item}}</text></view></view>
    <view class="advice-disclosure"><button class="disclosure-button" bindtap="sources">{{sourcesOpen ? '收起参考来源' : '参考来源 · '+answer.sources.length}}<view class="disclosure-chevron {{sourcesOpen ? 'disclosure-open' : ''}}"/></button><view wx:if="{{sourcesOpen}}" class="card"><view wx:for="{{answer.sources}}" wx:key="id" class="source-line"><text class="source-label">{{item.id}}</text><text>{{item.label}}</text><button wx:if="{{item.url}}" class="text-button" data-url="{{item.url}}" bindtap="copySource">复制来源链接</button><button wx:if="{{item.record}}" class="text-button" data-id="{{item.record}}" bindtap="record">查看社区讨论</button></view><view class="muted">{{answer.model}}</view></view></view>
    <view wx:if="{{answer.communityCards.length}}" class="card"><view class="heading">社区经验参考</view><view wx:for="{{answer.communityCards}}" wx:key="id"><view class="advice-section-title">{{item.title}}</view><view class="muted">发布 {{item.published}} · 关联观察 {{item.observed}}</view><view class="advice-paragraph">{{item.excerpt}}</view><view class="muted">{{item.basis}}</view><button class="text-button" data-id="{{item.record}}" bindtap="record">查看原讨论</button></view></view>
    <view class="controls"><button wx:for="{{answer.guideCards}}" wx:key="id" data-id="{{item.id}}" bindtap="bird">{{item.name}}图鉴</button><button bindtap="restart">开始新咨询</button></view>
    <view class="card weather-card" wx:for="{{answer.weatherCards}}" wx:key="id" wx:for-item="forecast"><button class="trip-section-heading" data-id="weather-{{index}}" bindtap="toggleTripSection"><image src="/assets/decorations/sun.png"/><view><text class="trip-section-kicker">天气</text><text>{{forecast.area}}</text></view><view class="disclosure-chevron {{tripExpanded['weather-'+index] ? 'disclosure-open' : ''}}"/></button><view wx:if="{{!forecast.available}}">该时段暂无预报</view>
      <view wx:for="{{forecast.hours}}" wx:for-index="hourIndex" wx:if="{{tripExpanded['weather-'+index] || hourIndex === 0}}" wx:key="hour" class="weather">{{item.hour}}　{{item.temp}} °C　风 {{item.wind}} m/s　{{item.rain===null?'降水量未知':item.rain+' mm/h'}}</view>
      <view class="muted">{{forecast.source}}</view></view>
    <view wx:if="{{answer.stages.length}}" class="card"><view class="heading">观鸟时段安排</view><view wx:for="{{answer.stages}}" wx:key="time" class="itinerary-row"><text class="itinerary-time">{{item.time}}</text><text class="itinerary-action">{{item.action}}</text></view></view>
    <view wx:if="{{answer.parks.length}}" class="card"><view class="heading">可以踏查的公园</view><view class="muted">出发前请核对入口和开放时间。</view>
      <button wx:for="{{answer.parks}}" wx:key="source" data-index="{{index}}" bindtap="park">{{item.name}} · 距起点约 {{item.km}} 公里</button></view>
    <view class="card stop-card" wx:for="{{answer.stops}}" wx:key="index" wx:for-item="stop"><button class="trip-section-heading" data-id="stop-{{index}}" bindtap="toggleTripSection"><image src="/assets/icons/pin.png"/><view><text class="trip-section-kicker">公开鸟讯区域 {{index+1}}</text><text>{{stop.name}}</text></view><view class="disclosure-chevron {{tripExpanded['stop-'+index] ? 'disclosure-open' : ''}}"/></button>
      <view>距起点约 {{stop.km}} 公里（直线）</view><view class="muted">近一年 {{stop.count}} 条公开记录 · 最近 {{stop.latest}} · 同月份 {{stop.seasonal}} 条</view>
      <view wx:if="{{tripExpanded['stop-'+index]}}" wx:for="{{stop.birds}}" wx:key="id" wx:for-item="species"><view>{{species.name}} · 曾记录 {{species.count}} 次</view>
        <view class="controls"><button data-id="{{species.id}}" bindtap="bird">鸟种图鉴</button><button data-id="{{species.record}}" bindtap="record">查看鸟讯</button></view></view>
      <view class="stop-actions"><button data-index="{{index}}" bindtap="map">羽迹地图</button><button class="stop-navigate" data-index="{{index}}" bindtap="externalMap"><image class="navigate-icon" src="/assets/icons/pin.png"/>打开区域位置</button></view>
      <button wx:if="{{stop.park}}" data-source="site" data-index="{{index}}" bindtap="park">附近参观点 · {{stop.park.name}}</button></view>
    <view class="muted">鸟讯显示约十公里的公开区域。历史记录供选择地点时参考，实际遇见的鸟种随当天情况变化。</view></block>
</block></block></view>

<choice-sheet max-body="{{filterMaxBody}}" open="{{filterOpen}}" title="{{filterTitle}}" options="{{filterOptions}}" selected="{{filterSelected}}" bindchange="chooseCondition" bindclose="closeCondition"/>
<date-calendar open="{{calendarOpen}}" from="{{date}}" to="{{date}}" single min="{{today}}" max="{{lastDay}}" bindchange="chooseDate" bindclose="closeCondition"/>
