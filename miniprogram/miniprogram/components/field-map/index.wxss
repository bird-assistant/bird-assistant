:host{display:block}
.field{position:fixed;left:0;right:0;overflow:hidden;background:#e5ecdf;color:#253c34;box-sizing:border-box}
.map-toolbar{position:absolute;top:0;left:0;right:0;z-index:8;padding:10px 14px 12px;background:#fafbf5;box-sizing:border-box;border-bottom:1px solid #dce5d7}
.search-row{display:flex;align-items:center;gap:8px;height:44px;max-width:760px;margin:0 auto}
.place-button,.search-button,.clear-search,.map-action,.summary-main,.guide-link,.trip-entry,.sheet-close,.record-main,.record-guide,.more-button,.notice-retry,.retry-button,.results-close,.species-result{box-sizing:border-box;min-width:0;min-height:0;margin:0;line-height:1.4;font-size:14px;border-radius:12px;display:flex;align-items:center;justify-content:center;border:0;padding:0}
.place-button::after,.search-button::after,.clear-search::after,.map-action::after,.summary-main::after,.guide-link::after,.trip-entry::after,.sheet-close::after,.record-main::after,.record-guide::after,.more-button::after,.notice-retry::after,.retry-button::after,.results-close::after,.species-result::after{border:0}
.place-button{width:90px;height:44px;padding:0 10px;gap:4px;flex:none;background:#edf3e7;color:#285b49;border:1px solid #d6e2cf;font-size:13px}
.place-icon{width:17px;height:20px;flex:none}.search-button{width:54px;height:44px;min-width:54px;padding:0 12px;flex:none;background:#285b49;color:white}
.species-input{height:44px;flex:1;min-width:0;display:flex;align-items:center;background:#fffef9;border:1px solid #d6e2cf;border-radius:12px;overflow:hidden}
.bird-input{flex:1;width:0;min-width:0;min-height:0;height:42px;line-height:42px;padding:0 10px;border:0;border-radius:0;background:transparent;font-size:14px;color:#253c34;box-sizing:border-box}
.clear-search{width:32px;height:42px;flex:none;background:transparent;color:#72826c;font-size:22px}
.filter-row{display:flex;gap:8px;height:34px;margin:10px auto 0;max-width:760px}.filter-picker{flex:1;width:0;min-width:0}.filter-button{height:34px;padding:0 10px;border-radius:17px;background:#edf3e7;display:flex;align-items:center;justify-content:space-between;gap:4px;box-sizing:border-box}.filter-text{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.filter-arrow{width:6px;height:6px;flex:none;border-right:1.4px solid #60765e;border-bottom:1.4px solid #60765e;transform:rotate(45deg);margin-top:-3px}
.map-canvas{position:absolute;left:0;right:0;overflow:hidden}.native{position:absolute;inset:0;width:100%;height:100%}
.map-actions{position:absolute;z-index:4;right:14px;top:16px;display:flex;flex-direction:column;gap:8px}.map-action{width:44px;height:44px;background:#fffef9;border:1px solid #dce5d7;box-shadow:0 3px 12px #253c3417}.action-icon{width:22px;height:22px}
.map-dock{position:absolute;z-index:4;bottom:36px;left:14px;right:14px;max-width:470px}.summary-card{display:flex;align-items:center;padding:0 12px;background:#fffef9;border:1px solid #dce5d7;border-radius:17px;box-shadow:0 4px 16px #253c3418;overflow:hidden}.summary-main{flex:1;min-width:0;height:72px;padding:10px 0;justify-content:space-between;gap:12px;text-align:left;background:transparent;color:#285b49}.summary-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px}.summary-heading{font-size:16px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.summary-meta{font-size:12px;color:#71816b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-count{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums;flex:none}.summary-chevron{font-size:23px;color:#8c9a82;flex:none}.guide-link{height:38px;margin-left:8px;padding:0 9px;flex:none;background:#edf3e7;color:#285b49;font-size:12px;border:1px solid #d6e2cf}
.trip-entry{height:44px;width:100%;margin-top:8px;padding:0 14px;justify-content:space-between;background:#edf3e7;color:#285b49;border:1px solid #d2dfca;box-shadow:0 2px 9px #253c3410}.trip-copy{display:flex;align-items:center;gap:8px}.trip-icon{width:18px;height:18px}.trip-chevron{font-size:23px;color:#72866b}
.map-notice{display:flex;align-items:center;gap:8px;padding:8px 10px;margin-bottom:8px;background:#fff6ee;color:#835c42;border-radius:12px;border:1px solid #ead6c5}.notice-text{flex:1;font-size:12px}.notice-retry{min-height:34px;flex:none;padding:0 8px;background:transparent;color:#835c42;font-size:13px}
.record-sheet{position:absolute;z-index:6;left:12px;max-width:calc(100% - 24px);padding:0 14px;background:#fafbf5f5;border:1px solid #d6e2cf;border-radius:18px;box-shadow:0 5px 22px #253c3424;box-sizing:border-box;overflow:hidden;transition:height .18s ease}.sheet-header{height:64px;display:flex;align-items:center;justify-content:space-between;gap:10px}.sheet-header-copy{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;margin:0;padding:0;background:transparent;border:0;border-radius:0;line-height:1.4;text-align:left}.sheet-header-copy::after{border:0}.sheet-toggle{margin-left:8px;color:#8a9b81;font-size:16px}.sheet-fade{position:absolute;bottom:0;left:0;right:0;height:22px;pointer-events:none;background:linear-gradient(0deg,#fafbf5,transparent)}.sheet-title{display:block;font-size:16px;font-weight:600}.sheet-count{font-size:12px;color:#71816b}.sheet-close{height:40px;width:40px;flex:none;background:#edf3e7;color:#285b49;font-size:25px}.record-scroll{width:100%;overflow:hidden}.record-row{display:flex;align-items:center;border-top:1px solid #e1e8da;gap:8px}.record-main{flex:1;width:0;min-width:0;height:73px;min-height:73px;padding:11px 0;flex-direction:column;align-items:stretch;gap:5px;text-align:left;background:transparent;color:#253c34}.record-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.record-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:600}.record-date{font-size:12px;color:#71816b;flex:none}.record-meta{font-size:12px;color:#71816b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-guide{width:46px;height:38px;min-height:38px;flex:none;padding:0;color:#285b49;background:#e8efdf;border:1px solid #d2dfca;font-size:12px}.more-button,.retry-button{min-height:44px;margin:8px 0;width:100%;background:#edf3e7;color:#285b49}.list-message{padding:15px 0;color:#71816b;font-size:13px;text-align:center}.list-end{padding:12px 0 4px;font-size:12px;text-align:center;color:#7d8b75}
.search-results{position:absolute;left:14px;right:14px;z-index:12;max-width:730px;margin:0 auto;background:#fffef9;border:1px solid #d6e2cf;border-radius:14px;box-shadow:0 8px 24px #253c3430;overflow:hidden}.results-heading{display:flex;align-items:center;justify-content:space-between;padding-left:12px;font-size:13px;color:#71816b}.results-close{width:40px;height:40px;background:transparent;color:#285b49;font-size:24px}.results-scroll{max-height:176px;height:176px}.species-result{width:100%;min-height:44px;padding:10px 12px;justify-content:space-between;gap:12px;text-align:left;border-radius:0;border-top:1px solid #e1e8da;background:#fffef9;color:#285b49}.species-latin{max-width:50%;font-size:12px;color:#71816b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.field-wide .map-dock{left:24px;width:420px}.field-wide .record-sheet{left:16px;right:auto}.field-wide .map-actions{right:24px;top:24px}

/* Short windows keep the map and every primary action within one bounded row. */
.field-compact .map-toolbar{padding:8px 14px 10px}.field-compact .search-row{height:40px}.field-compact .place-button,.field-compact .search-button,.field-compact .species-input{height:40px}.field-compact .bird-input,.field-compact .clear-search{height:38px;line-height:38px}.field-compact .filter-row{height:30px;margin-top:8px}.field-compact .filter-button{height:30px}.compact-actions{display:flex;align-items:center;gap:6px;padding:4px;border:1px solid #d6e2cf;border-radius:15px;background:#fffef9;box-shadow:0 3px 12px #253c3417}.compact-actions .map-action{border:0;box-shadow:none;background:#edf3e7}.compact-records{flex:1;min-width:0;height:44px;margin:0;padding:0 4px;font-size:14px;line-height:1.4;display:flex;align-items:center;justify-content:center;background:transparent;color:#285b49;border:0}.compact-records::after{border:0}.field-compact .sheet-header-copy{gap:1px}.field-compact .sheet-title{font-size:14px}.field-compact .sheet-count{white-space:nowrap;font-size:11px}

/* The drawer meets the tab boundary; content fades before the clear map-credit footer. */
.record-sheet{border-bottom:0;border-radius:18px 18px 0 0;background:linear-gradient(to bottom,#fafbf5f2 calc(100% - 24px),transparent calc(100% - 24px));}
.sheet-title{display:flex;align-items:center;gap:9px}.sheet-toggle{width:8px;height:8px;margin:0 0 4px;border-right:1.7px solid #6d8564;border-bottom:1.7px solid #6d8564;transform:rotate(45deg);transition:transform .2s ease}.sheet-toggle.toggle-up{transform:rotate(225deg);margin-top:7px}.sheet-close{font-size:0;position:relative}.sheet-close::before,.sheet-close::after{content:"";position:absolute;left:12px;top:19px;width:16px;height:2px;border:0;border-radius:2px;background:#285b49;transform:rotate(45deg)}.sheet-close::after{transform:rotate(-45deg)}.sheet-fade{height:42px;background:linear-gradient(to top,#fafbf5 10%,#fafbf5cc 44%,transparent);z-index:1}.sheet-credit{pointer-events:none}.record-scroll{box-sizing:border-box}.sheet-scroll-tail{height:42px}.record-sheet{animation:drawer-arrive .2s ease-out}@keyframes drawer-arrive{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.record-sheet{animation:none;transition:none}.sheet-toggle{transition:none}}

.focus-notice{position:absolute;left:12px;right:68px;top:12px;padding:7px 10px;border-radius:10px;background:#fafbf5e8;color:#5c7652;font-size:11px;pointer-events:none;z-index:3}

.sheet-order{font-size:10px;color:#87957d;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
