:host{display:block;min-width:0}

.search-shell{position:relative;min-width:0}

.search-field{height:46px;display:flex;align-items:center;gap:8px;border:1px solid #d7e2d2;border-radius:12px;background:#fffef9;padding:0 10px;box-sizing:border-box}

.search-icon{width:18px;height:18px;flex:none;opacity:.65}

.search-input{flex:1;min-width:0;width:0;height:44px;min-height:0;padding:0;border:0;background:transparent;line-height:44px;font-size:14px;color:#253c34}

.search-clear,.search-close,.search-option,.search-more,.search-retry{display:flex;align-items:center;justify-content:center;box-sizing:border-box;margin:0;min-width:0;min-height:0;border:0;background:transparent;padding:0;line-height:1.4}

.search-clear::after,.search-close::after,.search-option::after,.search-more::after,.search-retry::after{border:0}

.search-clear,.search-close{width:38px;height:40px;flex:none;font-size:24px;color:#647b5e}

.search-panel{position:absolute;left:0;right:0;top:52px;z-index:30;overflow:hidden;background:#fffef9;border:1px solid #d7e2d2;border-radius:14px;box-shadow:0 8px 24px #253c3426}

.search-heading{display:flex;align-items:center;justify-content:space-between;height:40px;padding-left:12px;font-size:12px;color:#71816b}

.search-scroll{width:100%}

.option-row{display:flex;align-items:center;border-top:1px solid #e6ecdf}
.search-option{flex:1;width:0;min-height:54px;justify-content:space-between;gap:12px;padding:9px 12px;text-align:left;border-radius:0;color:#285b49}
.option-guide{flex:none;margin:0 8px 0 0;padding:0 10px;min-height:44px;line-height:44px;background:transparent;color:#285b49;font-size:13px}
.option-guide::after{border:0}

.search-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}

.option-name{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.option-latin{font-size:11px;color:#7d8a76;font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.option-action{flex:none;font-size:18px}

.search-message{padding:14px;font-size:12px;color:#7d8a76}

.search-more,.search-retry{width:100%;height:42px;color:#285b49;font-size:13px}


.search-panel-above{top:auto;bottom:calc(100% + 6px)}

.check-symbol{width:15px;height:15px;flex:none}
