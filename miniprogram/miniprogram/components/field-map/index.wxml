<view class="field"><view class="tools"><button bindtap="place">搜地点</button><input placeholder="鸟种名" value="{{keyword}}" bindinput="input" bindconfirm="search"/><button bindtap="search">查鸟种</button></view>
<view class="choices" wx:if="{{matches.length}}"><button wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name || item.english}}" bindtap="species">{{item.name || item.english}}</button></view>
<view class="tools"><picker range="{{scopes}}" value="{{scope}}" data-field="scope" bindchange="filter">{{scopes[scope]}} ▾</picker><picker range="{{periods}}" value="{{period}}" data-field="period" bindchange="filter">{{periods[period]}} ▾</picker><picker range="{{origins}}" value="{{origin}}" data-field="origin" bindchange="filter">{{origins[origin]}} ▾</picker></view>
<map id="field-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" bindregionchange="moved" bindmarkertap="marker" bindcallouttap="marker" class="native"/>
<view class="tools"><button bindtap="position">定位</button><button bindtap="load" loading="{{loading}}">{{dirty ? '搜索此区域' : '刷新区域'}}</button><button bindtap="list">{{selected.length ? '收起' : '看列表'}} · {{items.length}}/{{total}} 条</button></view>
<view wx:if="{{error}}">{{error}}</view><scroll-view scroll-y class="list" wx:if="{{selected.length}}"><button wx:for="{{selected}}" wx:key="id" data-id="{{item.id}}" bindtap="go">{{item.speciesName}} · {{item.placeName}}<view>{{item.source}} · {{item.date || '日期未知'}}</view></button></scroll-view></view>
