.notebook{max-width:740px;padding-bottom:calc(32px + env(safe-area-inset-bottom));color:#304e40}.notes-heading{display:flex;align-items:center;gap:12px;margin:14px 0 24px}.notes-heading>view{flex:1;min-width:0}.eyebrow{font-size:10px;letter-spacing:1.5px;color:#8b9b7c}.notes-title{font-family:serif;font-size:27px;line-height:1.5;margin:7px 0}.notes-heading .muted{font-size:11px}.notebook button.new-note{display:flex;align-items:center;justify-content:center;gap:5px;flex:none;min-height:44px;font-size:13px;padding:8px 12px;margin:0}.new-note image{width:16px;height:16px}.notes-search{margin:0 0 12px;font-size:14px}.notes-tags{white-space:nowrap;margin-bottom:15px;height:42px}.notes-tags button{display:inline-block;font-size:12px;margin:0 8px 0 0;padding:6px 12px;background:#eef2e7;color:#7d9071;border-radius:20px;line-height:26px}.notes-tags button.on{background:#285b49;color:#fffef9}.note-row{display:block;width:100%;text-align:left;padding:17px 18px;margin:12px 0;background:#fffef9;border:1px solid #e1e8d9;border-radius:17px;line-height:1.6}.note-pinned{border-left:4px solid #91ab7b}.note-row-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#8a987d;font-size:10px}.note-row-meta image{width:15px;height:15px;flex:none}.note-row-title{font-size:17px;font-weight:600;margin:9px 0 5px;overflow-wrap:anywhere}.note-excerpt{font-size:13px;color:#7b8871;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap;overflow-wrap:anywhere}.note-labels{display:flex;flex-wrap:wrap;gap:8px;color:#79915f;font-size:10px;margin-top:10px}.note-link{font-size:10px;color:#698263;margin-top:10px;padding-top:8px;border-top:1px solid #edf1e6}.notes-empty{text-align:center;padding:48px 12px;color:#879779}.notes-empty image{width:38px;height:38px;margin-bottom:14px;opacity:.6}.notes-empty text{display:block;font-size:11px;line-height:1.7;margin-top:10px}.notes-trash{display:block;margin:24px auto;font-size:11px}.editor-status{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#8a997b;font-size:11px;margin-bottom:12px}.editor-status button{font-size:12px}.notebook .note-title-input{font-size:21px;font-weight:600;border:0;border-bottom:1px solid #dfe7d4;border-radius:0;padding:9px 0 15px;background:transparent}.notebook .note-body-input{box-sizing:border-box;width:100%;height:44vh;min-height:170px;max-height:500px;margin:18px 0 0;background:transparent;border:0;padding:0;font-size:16px;line-height:1.9}.editor-count{text-align:right;color:#96a18c;font-size:10px;margin:8px 0 18px}.note-section{display:flex;align-items:center;justify-content:space-between;font-size:12px;margin:20px 0 8px}.note-section text{font-size:10px;color:#93a087}.link-observation{display:flex;align-items:center;gap:8px;text-align:left;width:100%;padding:12px;margin:16px 0;background:#eef3e6;font-size:12px}.link-observation image{width:18px;height:18px;flex:none}.link-observation text{flex:1;min-width:0;overflow-wrap:anywhere}.note-link-picker{max-height:220px;overflow:auto;background:#fffef9;border:1px solid #dfe7d4;border-radius:14px;padding:8px}.note-link-picker button{width:100%;text-align:left;font-size:12px;padding:9px;margin:0;background:transparent}.editor-actions{display:flex;gap:9px;flex-wrap:wrap;margin:24px 0 12px}.editor-actions button{flex:1;min-width:90px;font-size:12px;padding:10px;margin:0}.notebook .tiny{line-height:1.9;font-size:10px;color:#8d9a81}@media(max-width:340px){.notes-title{font-size:22px}.notes-heading{gap:5px}.notebook button.new-note{padding:8px;font-size:11px}.editor-actions{gap:6px}}
