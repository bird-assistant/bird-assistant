<block wx:if="{{open}}"><view class="calendar-shade" catchtap="close" catchtouchmove="noop"/><view class="calendar-panel" aria-role="dialog" aria-label="{{single ? '选择日期' : '选择日期范围'}}"><view class="calendar-heading"><view class="calendar-heading-copy"><text class="calendar-title">{{single ? '选择出发日期' : '选择日期范围'}}</text><text class="calendar-hint">{{single ? '点击一天，再确认' : '点起止日期；点已选端点可取消，也可拖动选范围'}}</text></view><button class="calendar-close" bindtap="close" aria-label="关闭日历"><image class="calendar-close-icon" src="/assets/icons/close.png"/></button></view><view wx:if="{{!single}}" class="calendar-endpoints"><button class="calendar-endpoint {{activeEdge === 'start' ? 'endpoint-active' : ''}}" data-edge="start" bindtap="edge"><text class="endpoint-caption">开始</text><text class="endpoint-value">{{draftFrom || '选择日期'}}</text></button><view class="calendar-endpoint-divider"/><button class="calendar-endpoint {{activeEdge === 'end' ? 'endpoint-active' : ''}}" data-edge="end" bindtap="edge"><text class="endpoint-caption">结束</text><text class="endpoint-value">{{draftTo || '选择日期'}}</text></button></view><scroll-view scroll-y="{{!dragging}}" style="height:{{bodyHeight}}px"><view class="calendar-month"><button class="calendar-month-step" data-delta="-1" bindtap="monthChange" aria-label="上个月"><view class="calendar-arrow previous"/></button><text>{{label}}</text><button class="calendar-month-step" data-delta="1" bindtap="monthChange" aria-label="下个月"><view class="calendar-arrow"/></button></view><view class="calendar-week"><text class="calendar-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid" bindtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragEnd"><button wx:for="{{cells}}" wx:key="value" data-date="{{item.value}}" bindtap="select" bindtouchstart="dragStart" disabled="{{item.disabled}}" class="calendar-day {{item.disabled ? 'calendar-day-disabled' : ''}} {{!item.current ? 'other-month' : ''}}" aria-label="{{item.value}}" aria-pressed="{{item.start || item.end || item.within}}"><view wx:if="{{item.band}}" class="calendar-band {{item.start ? 'band-start' : ''}} {{item.end ? 'band-end' : ''}}"/><view class="calendar-day-face {{item.start ? 'date-start' : ''}} {{item.end ? 'date-end' : ''}} {{item.single ? 'date-one-day' : ''}}">{{item.day}}</view></button></view><view class="calendar-selection">{{draftFrom || '未选择日期'}}{{draftTo && draftTo !== draftFrom ? ' 至 '+draftTo : ''}}</view></scroll-view><view class="calendar-actions"><button class="calendar-action" wx:if="{{!single}}" bindtap="clear">不限日期</button><button class="calendar-action calendar-apply {{!draftFrom ? 'calendar-apply-disabled' : ''}}" disabled="{{!draftFrom}}" bindtap="apply">确定</button></view></view></block>
