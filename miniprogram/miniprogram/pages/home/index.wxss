.map-screen{position:relative;overflow:hidden;background:#e5ecd8;min-height:280px}.map-gesture{position:absolute;inset:0}.map-world{position:absolute;left:50%;top:50%;transform-origin:center}.map-art{position:absolute;width:100%;height:100%}.map-label{position:absolute;font-size:11px;color:#7c8c68}.lake{left:7%;top:36%}.wood{left:61%;top:15%}.water{left:48%;top:65%;color:#6d9190}.user-dot{position:absolute;width:17px;height:17px;background:#7296ad;border:3px solid white;border-radius:50%;box-shadow:0 0 0 11px #7296ad24}.map-pin{position:absolute;border:3px solid #fff;width:44px;height:44px;min-height:0;border-radius:50%;padding:0;background:#285b49;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 8px #31563816;overflow:visible}.private-pin{background:#f6faff;border:2px solid #7894aa;box-shadow:0 3px 10px #38532b22}.map-top{position:absolute;top:15px;left:14px;right:14px}.search-box{display:flex;align-items:center;gap:9px;padding:10px 12px;background:#fffef9f5;border-radius:12px;box-shadow:0 3px 12px #45652910}.search-box input{padding:0;border:0;background:none;height:28px;min-height:28px;flex:1;width:0;font-size:13px}.search-results{max-height:174px;background:#fffef9;border-radius:12px;margin-top:6px;box-shadow:0 8px 22px #253c3426}.place-result{display:flex;flex-direction:column;text-align:left;padding:10px 13px;border-radius:0;background:none;border-bottom:1px solid #e2e8db;height:57px}.map-filters{display:flex;gap:6px;margin-top:8px}.map-filters picker{flex:1;min-width:0}.filter{height:34px;border-radius:18px;background:#fffef9f5;display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-size:11px;white-space:nowrap}.map-controls{position:absolute;right:14px;bottom:176px;display:flex;flex-direction:column;gap:6px}.map-controls button{width:44px;height:44px;padding:10px;background:#fffef9;box-shadow:0 2px 7px #253c3410}.map-legend{position:absolute;bottom:170px;left:14px;padding:7px 8px;background:#fffef9df;border-radius:8px;font-size:10px;color:#49623e}.map-summary{position:absolute;left:14px;right:14px;bottom:52px;background:#fffef9f5;padding:15px;text-align:left;border-radius:15px;box-shadow:0 4px 15px #3e5e3014}.map-summary .muted{font-size:12px;margin-top:7px}.map-credit{position:absolute;bottom:28px;width:100%;text-align:center;font-size:9px;color:#566b4c;pointer-events:none}.map-sheet{position:absolute;left:0;right:0;bottom:0;max-height:70%;background:#fafbf5;border-radius:22px 22px 0 0;padding:8px 18px 26px;z-index:12;box-sizing:border-box}.map-sheet .section-title{margin:6px 0}.detail-image{width:100%;height:190px;border-radius:12px}.sheet-backdrop{position:absolute;inset:0;background:#253c341e;z-index:11}
.map-pin{min-width:44px;max-width:44px;flex:none;margin:0}.map-summary{width:calc(100% - 28px);margin:0}.map-filters picker{flex:1 1 0;width:0;min-width:0}.map-controls button{flex:none;min-width:44px;max-width:44px;display:flex;align-items:center;justify-content:center}.search-box{min-width:0}.search-box .text-button{width:auto;flex:none;white-space:nowrap}.search-results{width:100%}.place-result{width:100%;box-sizing:border-box;flex-shrink:0}.place-result>text{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.map-sheet{width:100%;padding:0;max-height:none}.map-sheet-body{padding:8px 18px 26px}.place-actions>button{flex:1 1 0;width:0;min-width:0}.map-focus{position:absolute;width:38px;height:38px;padding:7px;background:#fffef9;border:2px solid #b3915e;border-radius:50%;box-shadow:0 0 0 6px #b3915e22;pointer-events:none}.map-focus .i{width:20px;height:20px}.map-tile{position:absolute;width:100%;height:100%;pointer-events:none}

.map-sheet{position:fixed;bottom:0;max-height:70vh}

.map-pin{font-size:11px}.map-controls button{min-height:44px}

/* Tap targets are siblings of the gesture surface, above decorative artwork. */
.map-gesture{z-index:0}.map-world{pointer-events:none}.map-pin{z-index:2;touch-action:manipulation}.map-focus{z-index:3}.map-top{z-index:10}.map-controls,.map-summary{z-index:6}.map-legend,.map-credit{z-index:5;pointer-events:none}.place-result{justify-content:center;line-height:18px;padding-top:8px;padding-bottom:8px}.map-sheet-body{padding-bottom:calc(24px + env(safe-area-inset-bottom))}

.map-summary{flex-direction:column;align-items:stretch;justify-content:center;gap:0}.place-result{align-items:flex-start}
.map-moving .map-world{transition:transform 500ms cubic-bezier(.333333,1,.666667,1)}
.map-moving .map-pin,.map-moving .map-focus{transition:left 500ms cubic-bezier(.333333,1,.666667,1),top 500ms cubic-bezier(.333333,1,.666667,1)}
.map-moving .user-dot{transition:transform 500ms cubic-bezier(.333333,1,.666667,1)}

/* Only the background surface owns drag events; controls and sheets remain siblings. */
.map-gesture{pointer-events:auto;touch-action:none}

.map-filters .demo-filter{flex:1;width:0;padding:0;background:transparent}.demo-filter .filter{width:100%}
