<block wx:if="{{open}}"><view class="calendar-shade" catchtap="close" catchtouchmove="noop"/><view class="calendar-panel" aria-role="dialog" aria-label="{{single ? '选择日期' : '选择日期范围'}}"><view class="calendar-heading"><view class="calendar-heading-copy"><text class="calendar-title">{{single ? '选择出发日期' : '选择日期范围'}}</text><text class="calendar-hint">{{single ? '点击一天，再确认' : '点击开始和结束；选好开始日，再从该日拖到结束'}}</text></view><button class="calendar-close" bindtap="close" aria-label="关闭日历"><image class="calendar-close-icon" src="/assets/icons/close.png"/></button></view><scroll-view scroll-y="{{!dragging}}" style="height:{{bodyHeight}}px"><view class="calendar-month"><button class="calendar-month-step" data-delta="-1" bindtap="monthChange" aria-label="上个月"><view class="calendar-arrow previous"/></button><text>{{label}}</text><button class="calendar-month-step" data-delta="1" bindtap="monthChange" aria-label="下个月"><view class="calendar-arrow"/></button></view><view class="calendar-week"><text class="calendar-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid" bindtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragEnd"><button wx:for="{{cells}}" wx:key="value" data-date="{{item.value}}" bindtap="select" bindtouchstart="dragStart" disabled="{{item.disabled}}" class="calendar-day {{item.disabled ? 'calendar-day-disabled' : ''}} {{!item.current ? 'other-month' : ''}} {{item.within ? 'range-day' : ''}} {{item.start || item.end ? 'edge-day' : ''}}" aria-label="{{item.value}}" aria-pressed="{{item.start || item.end || item.within}}">{{item.day}}</button></view><view class="calendar-selection">{{draftFrom || '未选择日期'}}{{draftTo && draftTo !== draftFrom ? ' 至 '+draftTo : ''}}</view></scroll-view><view class="calendar-actions"><button class="calendar-action" wx:if="{{!single}}" bindtap="clear">不限日期</button><button class="calendar-action calendar-apply {{!draftFrom ? 'calendar-apply-disabled' : ''}}" disabled="{{!draftFrom}}" bindtap="apply">确定</button></view></view></block>
