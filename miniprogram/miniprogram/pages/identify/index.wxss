.page>.title{font-size:25px;margin-top:9px}.import-drop{padding:25px 17px;gap:11px}.import-drop>image{width:35px;height:35px}.import-drop .strong{font-size:14px}

.pause-button{min-height:40px}.view-tags>button{min-height:0}.mode-caption{min-height:0}.recognition-error{bottom:18px}

.import-drop{min-height:0;justify-content:flex-start}.import-drop .tiny{font-size:10px;line-height:1.4}.page>.segments{padding:3px;gap:3px;margin:16px 0}.page>.segments>button{min-height:40px;font-size:13px;padding:10px 6px}.view-tags>text{min-height:24px;display:flex;align-items:center}

/* Match the reference portrait overlay; no paper-colored rectangle below the card. */
.live-bottom{padding:18px 12px 12px;background:linear-gradient(0deg,#102e24ed,transparent)}
.clue-panel{padding:0;overflow:hidden;border:1px solid #edf2df99;background:#f6f8edf2;border-radius:14px;box-shadow:none;margin-bottom:12px}
.clue-tabs{min-height:42px;padding:3px 4px 0;gap:3px}.clue-tabs>button{min-height:38px;line-height:18px;padding:5px 8px;border-radius:12px;font-size:11px}.clue-tabs .i{width:16px;height:16px}.clue-tabs .expand-button{width:38px;min-width:38px;max-width:38px;min-height:38px;padding:8px}
.clue-summary{padding:1px 12px 9px;align-items:baseline;gap:8px}.clue-summary .strong{line-height:19px}.clue-summary .tiny{line-height:14px}.clue-detail{padding:0 12px 12px;line-height:1.7}.clue-detail>text{display:block}
.capture-row{background:transparent;padding:9px 8px 0}.capture-side,.capture-hint{background:transparent;color:#f3f7e8}.capture-icon{filter:brightness(0) invert(1)}.shutter{background:transparent;border-color:#edf4e2}.shutter>view{background:#eff5e1}.shutter.video-recording>view{background:#b9654d}
.media-icon-box{width:84px;height:68px;flex:none;display:flex;align-items:center;justify-content:center;background:#eaf0e2;border-radius:6px}
.evidence-item .media-icon-box .media-icon{width:32px;height:32px;min-width:32px;min-height:32px;flex:none;padding:0;background:transparent;border-radius:0}
.zoom-control{margin:0 0 12px;color:#eff5df;user-select:none}
.zoom-presets{display:flex;align-items:center;gap:8px;height:28px}
.zoom-preset-list{display:flex;align-items:center;justify-content:center;gap:7px;flex:1;min-width:0}
.zoom-presets button{display:flex;align-items:center;justify-content:center;flex:none;margin:0;padding:0;height:28px;min-height:28px;border:1px solid #ffffff45;color:#f3f8e8;background:#244a3d88;line-height:18px;font-size:11px}
.zoom-presets .zoom-step{width:28px;min-width:28px;border-radius:50%;font-size:16px}
.zoom-presets .zoom-preset{width:37px;min-width:37px;border-radius:16px}
.zoom-presets .zoom-selected{border-color:#e0edae;color:#ecf5c4;background:#52724c88}
.zoom-presets button[disabled]{opacity:.4}
.zoom-scale{position:relative;height:62px;overflow:hidden;touch-action:none}
.zoom-readout{position:absolute;top:4px;left:0;right:0;text-align:center;font-size:17px;line-height:22px;font-weight:600;color:#edf4c9}
.zoom-readout text{font-size:11px;margin-left:2px}
.zoom-track{position:absolute;left:0;right:0;top:29px;height:33px;pointer-events:none}
.zoom-axis{position:absolute;left:0;right:0;top:13px;height:1px;background:#ffffff45}
.zoom-tick{position:absolute;top:0;width:30px;margin-left:-15px;height:33px;text-align:center}
.zoom-tick-line{width:1px;height:7px;background:#e9f2d8aa;position:absolute;left:50%;top:7px}
.zoom-major .zoom-tick-line{height:13px;top:1px;background:#edf4df}
.zoom-tick text{position:absolute;top:17px;left:0;right:0;font-size:9px;line-height:13px;color:#e9f2d8}
.zoom-centre{position:absolute;left:50%;top:-1px;width:2px;height:18px;margin-left:-1px;background:#e5efad;box-shadow:0 0 5px #e5efad55}
.zoom-range{text-align:center;font-size:9px;line-height:13px;min-height:13px;color:#e4eddbbf}
.zoom-disabled .zoom-scale{opacity:.55}

/* Keep the hint above the centre tab's 22px protrusion, including a clear gap. */
.live-bottom{padding-bottom:34px}.capture-hint{font-size:10px;line-height:16px;min-height:24px;padding-top:8px}
.camera-cover{top:128px;padding:14px;gap:8px}.camera-cover-heading{display:flex;align-items:center;justify-content:center;gap:8px;min-height:22px}.camera-cover-heading .i{width:18px;height:18px}.camera-cover .strong{font-size:15px;line-height:22px}.camera-cover-copy{font-size:12px;line-height:18px}.camera-cover-actions{display:flex;align-items:stretch;gap:8px;width:100%;margin-top:4px}.camera-cover-actions>button{flex:1 1 0;min-width:0;width:0;max-width:none;min-height:38px;padding:8px 6px;font-size:12px;line-height:20px}
.observation-context{margin-top:18px;border:1px solid #dce5d7;border-radius:12px;background:#fffef9;overflow:hidden}
.context-toggle{width:100%;min-height:64px;gap:12px;padding:12px;background:transparent;justify-content:space-between;text-align:left;border-radius:0}
.context-heading{display:flex;flex-direction:column;min-width:0;gap:4px;flex:1}
.context-heading .strong{font-size:12px;line-height:18px}.context-heading .tiny{line-height:17px;overflow-wrap:anywhere}
.context-toggle-label{flex:none;font-size:12px;line-height:20px}.context-fields{padding:0 12px 14px;border-top:1px solid #e7ecdf}
.context-pickers{display:flex;gap:10px;margin-top:12px}.context-pickers>view{flex:1;min-width:0}
.context-label{display:block;font-size:12px;line-height:18px;margin-bottom:5px;color:#62775b}
.context-field{display:flex;align-items:center;min-height:44px;padding:8px 10px;border:1px solid #d8e3d2;border-radius:10px;font-size:12px;line-height:20px;color:#285b49}
.context-disabled{opacity:.5}.context-clear{display:flex;justify-content:flex-end;gap:14px;margin-top:5px}.context-clear .text-button{min-height:32px;font-size:11px}
.context-fields .label{margin-top:12px}.context-help{margin-top:9px}
