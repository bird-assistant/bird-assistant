.pause-button{width:40px;min-width:40px;max-width:40px;height:40px;min-height:40px;flex:none;margin:0;padding:9px;background:#edf2e3dd;border:1px solid #f3f5e6a0;border-radius:12px}.pause-button .i{width:20px;height:20px}
