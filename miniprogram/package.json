{
  "name": "bird-assistant-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "羽迹微信原生小程序，Issue #14 地图模块",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "format:check": "prettier --check \"app/**/*.js\" \"app/**/*.json\" \"scripts/*.cjs\" \"tests/*.cjs\" \"*.json\" && prettier --check --parser css \"app/**/*.wxss\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "glass-easel-stylesheet-compiler": "1.2.1",
    "glass-easel-template-compiler": "1.2.1",
    "prettier": "3.6.2"
  }
}
