.trip{padding:32rpx 28rpx 90rpx;color:#254839;background:#f6f8ef;min-height:100vh}.title{font-size:42rpx;font-weight:650}.card{background:#fffef8;padding:24rpx;margin:20rpx 0;border-radius:24rpx;line-height:1.7}.heading{font-size:34rpx;font-weight:600}.muted,.weather{font-size:25rpx;color:#52685c}.controls{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0}.controls button,.controls picker,.card button{background:#eaf2e7;color:#225742;border-radius:15rpx;padding:8rpx 18rpx;font-size:26rpx;line-height:1.6;margin:0}.trip textarea{box-sizing:border-box;width:100%;height:140rpx;background:white;border-radius:20rpx;padding:16rpx}.ask{background:#285b49;color:white;margin:16rpx 0}.advisory,.error{color:#755326;margin:10rpx 0}

.advice-overview{background:linear-gradient(140deg,#e8efde,#fffef8);border:1px solid #d8e3cf;padding:28rpx}.advice-kicker{display:block;margin-bottom:9rpx;font-size:21rpx;letter-spacing:2rpx;color:#7c8e6e}.advice-headline{font-size:36rpx;font-weight:600;line-height:1.65;color:#285b49}.advice-window{margin-top:16rpx;font-size:22rpx}.advice-focus{margin-top:10rpx;font-size:24rpx}.advice-section-title{font-size:29rpx;font-weight:600;margin-bottom:14rpx}.advice-line{display:flex;align-items:flex-start;gap:14rpx;font-size:27rpx;line-height:1.85;margin:10rpx 0}.advice-dot{width:8rpx;height:8rpx;flex:none;border-radius:50%;background:#94ab7e;margin-top:21rpx}.advice-paragraph{display:block;margin-top:18rpx;font-size:27rpx;line-height:1.9}.disclosure-button{width:100%;display:flex;align-items:center;justify-content:space-between;min-height:44px;background:transparent;color:#6d825e;font-size:24rpx;text-align:left}.disclosure-button::after{border:0}.disclosure-chevron{width:12rpx;height:12rpx;border-right:1.5px solid #7e9470;border-bottom:1.5px solid #7e9470;transform:rotate(45deg);transition:transform .18s}.disclosure-open{transform:rotate(225deg)}.source-line{display:flex;gap:14rpx;font-size:23rpx;margin-bottom:14rpx}.source-label{color:#70885f;flex:none}.itinerary-row{display:flex;gap:18rpx;margin-top:22rpx;font-size:26rpx}.itinerary-time{flex:none;width:78rpx;color:#8ba077;font-variant-numeric:tabular-nums}.itinerary-action{flex:1;min-width:0;line-height:1.8}.stop-actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.stop-actions button{display:flex;align-items:center;justify-content:center;min-height:42px;flex:1;gap:8rpx}.stop-actions .stop-navigate{background:#285b49;color:#fffef9}.navigate-icon{width:26rpx;height:30rpx;filter:brightness(0) invert(1)}.trip .card{border:1px solid #e0e7d7}.card .controls{gap:10rpx}.card .controls button{font-size:22rpx;min-height:36px}.weather{padding:8rpx 0;font-variant-numeric:tabular-nums}@media(prefers-reduced-motion:reduce){.disclosure-chevron{transition:none}}
