.profile-head{display:flex;align-items:center;gap:17px;margin:9px 0 22px}.avatar-large{width:74px;height:74px;border-radius:50%;flex-shrink:0;background:#e4ecd8}.profile-name{font-size:23px;font-weight:600;margin-bottom:5px}.edit-link{display:block;margin-top:4px}.stats{display:flex;justify-content:space-around;background:#eef3e7;border-radius:14px;margin:20px 0 10px;padding:18px 0;text-align:center}.stats>view{flex:1}.stats text{font-size:25px;color:#426c4e}.stats>view>view{font-size:11px;color:#7b8b71;margin-top:4px}.profile-menu{margin-top:14px}.menu-arrow{width:15px;height:15px;opacity:.6}.avatar-editor{margin:12px 0}.avatar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.avatar-grid button{display:flex;flex-direction:column;align-items:center;gap:8px;font-size:11px;padding:12px 7px;background:#fffef9;border:1px solid #dfe7d8}.avatar-grid image{width:51px;height:51px;border-radius:50%}.detail-photo{width:100%;height:250px;background:#e6eddb;border-radius:12px}.metadata{border-top:1px solid #dfe7d8;margin-top:22px}.metadata>view{display:flex;justify-content:space-between;font-size:13px;border-bottom:1px solid #dfe7d8;padding:12px 0}.metadata>view>text:first-child{color:#7b8b71}.media-thumb{padding:13px}.friend-avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;background:#e6eddb}.crop-stage{width:220px;height:220px;position:relative;overflow:hidden;background:#d8e2cd;margin:30px auto}.crop-image{position:absolute;max-width:none}.crop-circle{position:absolute;inset:0;border:2px solid #fffef9;border-radius:50%;box-shadow:0 0 0 100px #20382f66;pointer-events:none}.avatar-export{position:fixed;left:-4000px;top:-4000px;pointer-events:none}
.profile-menu,.menu-row{width:100%;min-width:0;max-width:100%}.menu-row{margin:0;font-weight:400}.profile-head>view{flex:1;min-width:0}.edit-link{width:auto;text-align:left}.avatar-grid{grid-template-columns:repeat(3,minmax(0,1fr));width:100%;min-width:0}.avatar-grid>button{width:100%;min-width:0}.metadata>view>text{min-width:0}.avatar-export{left:-2000px;top:0;width:1px!important;height:1px!important}

.avatar-large{width:64px;height:64px}.profile-name{font-size:22px}.stats{padding:16px 4px;margin:23px 0 14px}.stats text{font-size:23px}.stats>view>view{font-size:10px;margin-top:6px}.menu-row{min-height:54px;font-size:13px;padding:16px 2px;gap:11px}.menu-row .i{width:21px;height:21px}.menu-arrow{width:12px;height:12px}.profile-head{gap:12px}

.crop-stage+ .label{line-height:22px}.rotation-label .label{font-weight:400;font-size:12px;color:#62775b}
.metadata>view{align-items:flex-start;gap:12px}.metadata>view>text:first-child{flex:none}.metadata>view>text:last-child{min-width:0;text-align:right;overflow-wrap:anywhere}

.profile-menu-group{margin-top:22px}.profile-group-title{font-size:12px;color:#7a8c73;margin:0 2px 8px;letter-spacing:.5px}.profile-menu-group .profile-menu{margin-top:0}.profile-menu-group .menu-row{gap:12px;min-height:58px;padding:10px 13px}.menu-icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;flex:none;border-radius:11px;background:#edf3e7}.menu-icon image{display:block;width:20px;height:20px}.menu-label{flex:1;min-width:0}.place-card{margin-top:16px}.place-card .strong{flex:1;min-width:0;overflow-wrap:anywhere}.place-icon{width:22px;height:22px;flex:none}.place-card .muted{margin:8px 0;line-height:1.8}.place-card .choice-row{margin-top:16px;gap:8px}.settings-divider{height:1px;background:#e1e8da;margin:20px 0}.compact-empty{padding:28px 15px;margin:22px 0}.compact-empty>image{display:block;width:30px;height:30px;margin:0 auto 12px;opacity:.55}.compact-empty text{display:block;font-size:12px;color:#829077;margin-top:6px}
