<app-header title="{{view === 'live' ? '羽迹' : view === 'import' ? '导入识别' : '素材复核'}}" back="{{view !== 'live'}}" bindback="back" />
<view wx:if="{{view === 'live'}}" class="live-screen {{cameraShort ? 'camera-short' : ''}}" style="height:{{height}}px">
  <view class="viewfinder"><camera wx:if="{{demo ? false : !paused}}" class="native-camera" device-position="back" flash="off" resolution="high" frame-size="large" bindinitdone="cameraReady" binderror="cameraError" bindstop="cameraStopped" />
    <canvas id="vision-encoder" type="2d" class="vision-encoder" />
    <cover-view wx:for="{{liveTracks}}" wx:key="id" class="vision-box vision-{{item.appearance}}" style="{{item.style}}"><cover-view class="vision-tag">{{item.id}} · {{item.label}}</cover-view></cover-view>
    <image wx:if="{{demo}}" src="/assets/samples/live-scene.png" class="demo-scene" mode="aspectFill" style="transform:scale({{zoom}})" /><view class="view-tags"><text>{{demo ? '示例取景 · 非真实识别' : '实时取景'}}</text><button wx:if="{{expanded || demo}}" bindtap="demo">{{demo ? '使用相机' : '查看示例'}}</button></view>
    <view wx:if="{{demo ? !paused : false}}" class="bird-box"><text>树麻雀 86%</text><view class="corner tl" /><view class="corner tr" /><view class="corner bl" /><view class="corner br" /></view>
    <view wx:if="{{paused || cameraError}}" class="camera-cover"><view class="camera-cover-heading"><image class="i" src="/assets/icons/camera.png" /><text class="strong">{{paused ? '取景已暂停' : '相机暂不可用'}}</text></view><text class="camera-cover-copy">{{paused ? '需要时恢复取景，继续留下线索' : cameraError}}</text><view class="camera-cover-actions"><button bindtap="resumeOrDemo">{{paused ? '恢复取景' : '查看取景示例'}}</button><button class="quiet" bindtap="import">导入素材</button></view></view>
  </view>
  <view class="live-mode"><view class="segments"><button class="{{mode === 'quick' ? 'on' : ''}}" data-id="quick" bindtap="mode">快速识别</button><button class="{{mode === 'wait' ? 'on' : ''}}" data-id="wait" bindtap="mode">等候模式</button></view><button class="pause-button" bindtap="pause" aria-label="暂停或恢复取景"><image class="i" src="/assets/icons/{{paused ? 'video' : 'minus'}}.png" /></button></view>
  <button class="mode-caption" bindtap="help">{{mode === 'quick' ? '快速模式久用可能发热 · 查看建议' : '长时间观鸟，用等候模式 · 查看说明'}}</button>
  <view wx:if="{{help}}" class="mode-advice"><view class="strong">拍得从容，也留住瞬间</view><view>持续取景可能发热、耗电。等候模式会放慢分析频率，必要时可暂停取景。</view><view class="capture-advice">{{zoomProfile === 'pura70proplus' ? 'Pura 70 Pro+ 已加入 3.5× 快捷点。拍高速飞鸟，可先用系统相机的闪拍，再从相册导入原片。' : '拍高速移动的鸟，可用系统相机拍摄，再从相册导入原片。'}}</view><text class="advice-note">可用倍率以当前相机为准。</text><view class="advice-actions"><button data-id="wait" bindtap="mode">切换等候模式</button><button bindtap="help">知道了</button></view></view>
  <view class="live-bottom"><view wx:if="{{!paused && !cameraError}}" class="zoom-control {{zoomEnabled ? '' : 'zoom-disabled'}}" catchtouchstart="zoomStart" catchtouchmove="zoomMove" catchtouchend="zoomEnd" catchtouchcancel="zoomEnd">
    <view class="zoom-presets"><button class="zoom-step" data-delta="-0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom <= 1}}" aria-label="缩小 0.1 倍">−</button><view class="zoom-preset-list"><button wx:for="{{zoomShortcuts}}" wx:key="value" class="zoom-preset {{zoom === item.value ? 'zoom-selected' : ''}}" data-zoom="{{item.value}}" bindtap="zoom" disabled="{{!zoomEnabled}}">{{item.label}}</button></view><button class="zoom-step" data-delta="0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom >= (demo ? 5 : maxZoom)}}" aria-label="放大 0.1 倍">＋</button></view>
    <button class="zoom-chip" bindtap="toggleZoom" aria-expanded="{{zoomOpen}}" aria-label="{{zoomOpen ? '收起变焦刻度' : '展开变焦刻度'}}"><text class="zoom-current">{{zoomText}}×</text><text class="zoom-swipe-hint">{{zoomOpen ? '下滑收起' : '上滑展开刻度'}}<text class="zoom-chevron">{{zoomOpen ? '⌄' : '⌃'}}</text></text></button>
    <block wx:if="{{zoomOpen}}"><view class="zoom-scale" aria-label="左右滑动调整变焦，当前 {{zoomText}} 倍"><view class="zoom-track"><view class="zoom-axis"/><view wx:for="{{zoomTicks}}" wx:key="id" class="zoom-tick {{item.major ? 'zoom-major' : ''}}" style="left:calc(50% + {{item.offset}}px)"><view class="zoom-tick-line"/><text wx:if="{{item.major}}">{{item.label}}</text></view><view class="zoom-centre"/></view></view><view class="zoom-range">{{zoomRange}}{{zoomEnabled ? ' · 左右滑动，± 微调' : ''}}</view></block>
  </view>
    <view class="clue-panel"><view class="clue-tabs"><button class="{{focus === 'visual' ? 'on' : ''}}" data-id="visual" bindtap="focus"><image class="i" src="/assets/icons/scan.png"/>画面线索<view wx:if="{{liveActive}}" class="clue-dot"/></button><button class="{{focus === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="focus"><image class="i" src="/assets/icons/mic.png"/>声音线索<view wx:if="{{audioRecording}}" class="clue-dot recording-dot"/></button><button class="expand-button" bindtap="expand" aria-expanded="{{expanded}}" aria-label="{{expanded ? '收起识别线索详情' : '展开识别线索详情'}}"><image class="i {{expanded ? 'turned' : ''}}" src="/assets/icons/chevron.png"/></button></view>
      <view class="clue-summary"><view class="clue-copy"><text class="clue-title">{{focus === 'visual' ? (demo ? '示例候选 · 树麻雀' : liveText) : (audioRecording ? '正在留下鸟鸣' : '留一段鸟鸣，稍后辨认')}}</text><text class="clue-note">{{focus === 'visual' ? (demo ? '示例取景，非真实识别' : liveActive ? '候选供你复核，轻触快门保留高清照片' : '开启后分析画面，也可先拍下来') : '录音可私人保留；声音分析暂未开放'}}</text></view><button wx:if="{{focus === 'visual' && !demo && !paused && !cameraError}}" class="vision-toggle {{liveActive ? 'vision-on' : ''}}" disabled="{{!cameraReady}}" bindtap="toggleVision">{{liveActive ? '停止' : '开启'}}</button><button wx:elif="{{focus === 'audio'}}" class="audio-capture" disabled="{{recording || busy}}" bindtap="recordAudio">{{audioRecording ? '保留' : '录音'}}</button></view>
      <scroll-view wx:if="{{expanded}}" scroll-y class="clue-detail"><view wx:if="{{focus === 'audio'}}" class="clue-detail-copy">声音单独保留，不直接替画面下结论。录音结束后可在复核素材中回听。</view><view wx:else class="vision-list"><view wx:for="{{liveTracks}}" wx:key="id" wx:for-item="track" class="vision-subject"><text class="strong">目标 {{track.id}} · {{track.label}}</text><text wx:if="{{track.scope}}"> · {{track.scope}}</text><view wx:if="{{track.candidates.length}}">{{track.state === 'unknown' ? '可能是 · 供人工复核' : '候选 · 相对相似度'}}</view><view wx:for="{{track.candidates}}" wx:key="rank">{{item.name}} · {{item.scoreText}}</view></view><button wx:if="{{liveTracks.length}}" bindtap="keepFrame">保留本帧并复核</button><view wx:else class="clue-detail-copy">让鸟体尽量清晰、完整。没有可靠候选时，也能保留照片，交给自己或鸟友复核。</view></view></scroll-view>
    </view>
    <view class="capture-row"><button class="capture-side" bindtap="import"><image class="capture-icon" src="/assets/icons/image.png" /><text>相册 / 文件</text></button><button class="shutter {{recording ? 'video-recording' : ''}}" disabled="{{paused || busy}}" bindtouchstart="shutterStart" bindtouchend="shutterEnd" bindtouchcancel="shutterCancel" bindtap="shutterPhoto" aria-label="{{liveActive ? '拍摄高清照片并识别，长按录像' : '轻触拍照，长按录像'}}"><view /></button><button class="capture-side" bindtap="review"><view class="evidence-count">{{assets.length}}</view><text>复核素材</text></button></view><view class="capture-hint">{{recording ? '正在录像 '+recordSeconds+' 秒 · 松开结束' : liveActive ? '轻触快门，用高清照片识别 · 长按录像' : '轻触拍照，长按录像'}}</view>
  </view>
</view>
<view wx:elif="{{view === 'import'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><view class="eyebrow">先拍下来，也可以稍后辨认</view><view class="title">导入识别</view><view class="subtitle">保留系统相机拍摄的原件。导入不改动设备文件。</view><view class="segments"><button class="{{importKind === 'gallery' ? 'on' : ''}}" data-id="gallery" bindtap="importKind">照片 / 视频</button><button class="{{importKind === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="importKind">音频文件</button></view><button class="import-drop" loading="{{picking}}" disabled="{{picking}}" bindtap="chooseFiles"><image src="/assets/icons/{{importKind === 'audio' ? 'mic' : 'image'}}.png" /><text class="strong">{{importKind === 'audio' ? '选择音频文件' : '从设备选择照片或视频'}}</text><text class="tiny">{{importKind === 'audio' ? 'MP3 · WAV · AAC · M4A / MP4 · OGG' : '照片与视频 · 保留原件'}}</text></button><view class="tiny">{{importKind === 'audio' ? '以上音频格式可保留原件。OGG 目前仅支持本机保留；识别服务尚未开放。' : '照片可上传分析；视频可先私人保留，稍后复核。'}}</view><button wx:if="{{importKind === 'gallery'}}" class="quiet wide spaced" data-source="album" bindtap="choose">单张照片入口</button><view class="divider" /><view class="muted">没有文件？先用明确标注的示例体验</view><button class="small-button spaced" bindtap="addSample">添加图片示例</button><view class="row between section-title"><text>本次素材 · {{assets.length}}</text><button class="primary small-button" bindtap="review">复核所选素材</button></view><view class="note">拍摄时间、地点未知时保持未知，不套用当前天气或位置。</view></view>
<view wx:else class="page {{focusedPage ? 'focused-page' : ''}}"><view class="title">留下这次发现</view><view class="subtitle">确认素材，补充感想。保存默认只对自己可见。</view><scroll-view scroll-x class="evidence-strip"><view wx:for="{{assets}}" wx:key="id" class="evidence-item {{currentId === item.id ? 'evidence-selected' : ''}}"><button data-id="{{item.id}}" bindtap="selectEvidence"><image wx:if="{{item.kind === 'photo'}}" src="{{item.path}}" mode="aspectFill" /><view wx:else class="media-icon-box"><image class="media-icon" mode="aspectFit" src="/assets/icons/{{item.kind === 'audio' ? 'mic' : 'video'}}.png" /></view><text>{{item.sample ? '示例插画' : item.kind === 'photo' ? '照片' : item.kind === 'video' ? '视频' : '音频'}}</text></button><button class="evidence-remove" data-id="{{item.id}}" bindtap="removeEvidence" aria-label="移除素材">×</button></view></scroll-view>
  <view wx:if="{{savedDraft && !imagePath}}" class="card"><view>已存入我的观察 · {{savedDraft.speciesName}}</view><button class="primary" bindtap="shareSaved">{{savedDraft.species ? '分享这次观察' : '请鸟友帮我认'}}</button></view><view wx:elif="{{!assets.length}}" class="empty">还没有保留素材。<view>可返回取景，或导入已有照片、视频和声音。</view></view><block wx:if="{{imagePath}}"><view wx:if="{{mediaKind === 'photo' && analysis.subjects.length}}" class="review-targets" bindtap="preview"><image src="{{imagePath}}" mode="widthFix" /><view wx:for="{{analysis.subjects}}" wx:key="rank" class="vision-box" style="left:{{100*item.box.x1}}%;top:{{100*item.box.y1}}%;width:{{100*(item.box.x2-item.box.x1)}}%;height:{{100*(item.box.y2-item.box.y1)}}%"><text class="vision-tag">目标 {{item.rank}}</text></view></view><image wx:elif="{{mediaKind === 'photo'}}" class="review-photo" src="{{imagePath}}" mode="aspectFit" bindtap="preview" /><video wx:elif="{{mediaKind === 'video'}}" class="review-photo" src="{{imagePath}}" controls /><button wx:else class="wide spaced" bindtap="preview">回听所选音频</button><view class="row between"><text class="muted">{{albumStatus}}</text><button wx:if="{{source === 'camera'}}" class="text-button" bindtap="retryAlbum">重试保存相册</button></view><text class="label">识别线索</text>
    <block wx:if="{{mediaKind === 'photo' && !isSample}}"><button class="quiet wide" bindtap="analyse" disabled="{{analyzing || busy}}" loading="{{analyzing}}">{{analyzing ? '正在分析照片' : analysis ? '重新分析照片' : '上传并分析照片'}}</button><button wx:if="{{analyzing}}" class="text-button" bindtap="cancelAnalysis">取消分析</button></block>
    <view wx:else class="note">{{isSample ? '示例素材仅供体验' : '视觉分析支持照片，可先保留这份素材'}}</view>
    <view wx:if="{{analysis}}" class="vision-result"><view class="strong">{{analysis.example ? '示例模型结果' : analysis.state === 'candidate' ? '鸟种候选' : analysis.reason === 'no_bird_detected' ? '照片中未检出鸟类' : analysis.reason === 'subject_below_minimum_size' ? '鸟体太小，请靠近或换一张照片' : '暂时无法可靠识别'}}</view><view class="tiny">{{analysis.model.name}} · {{analysis.model.catalogVersion}}</view>
      <view wx:for="{{analysis.subjects}}" wx:key="rank" wx:for-item="subject" class="vision-subject"><bird-crop src="{{imagePath}}" box="{{subject.box}}"/><button wx:if="{{subject.candidates.length && !analysis.example}}" data-rank="{{subject.rank}}" bindtap="compareTarget">对照图鉴 · 比较候选鸟种</button><text class="strong">目标 {{subject.rank}} · {{subject.state === 'candidate' ? '候选' : '待鉴定'}}</text><view wx:if="{{subject.candidates.length}}" class="tiny">{{subject.state === 'unknown' ? '可能是 · 供人工复核' : '按相对相似度排序'}}</view><view wx:else class="tiny">可尝试放大鸟体，选用更清晰的画面。</view><view wx:for="{{subject.candidates}}" wx:key="rank" class="candidate-actions"><button class="vision-choice" disabled="{{analysis.example || busy}}" data-subject="{{subject.rank}}" data-rank="{{item.rank}}" bindtap="confirmCandidate"><text>{{item.name}} · {{item.scoreText}}</text><text>{{birdName === item.name ? '已选' : '选用'}}</text></button><button class="candidate-info" data-subject="{{subject.rank}}" data-rank="{{item.rank}}" bindtap="candidateInfo">查看资料</button></view></view>
      <button class="text-button" bindtap="clearCandidate">保留为待鉴定</button></view><text class="label">鸟名（可留空）</text><input value="{{birdName}}" bindinput="changeName" disabled="{{busy}}" placeholder="待鉴定，或填写你判断的鸟名" /><text class="label">观察笔记</text><textarea auto-height value="{{notes}}" bindinput="changeNotes" disabled="{{busy}}" placeholder="发生了什么？有什么想留下的？" />
    <block wx:if="{{mediaKind === 'photo' && !isSample}}"><button class="quiet wide" bindtap="shareObservation">{{birdName ? '分享这次观察' : '请鸟友帮我认'}} </button><block wx:for="{{analysis.subjects}}" wx:key="rank" wx:for-item="target"><button class="text-button" wx:for="{{target.candidates}}" wx:key="rank" wx:if="{{item.speciesId}}" data-id="{{item.speciesId}}" bindtap="speciesInfo">查资料 · {{item.name}}</button></block></block>
    <view class="observation-context">
      <button class="context-toggle" bindtap="toggleContext" disabled="{{busy}}" aria-label="补充或收起观察时间与地点">
        <view class="context-heading"><text class="strong">观察时间与地点 · 可选</text><text class="tiny">{{observedDate || '时间未知'}}{{observedTime ? ' '+observedTime : ''}} · {{placeName || '地点未填写'}}</text></view><text class="context-toggle-label">{{contextOpen ? '收起' : '补充'}}</text>
      </button>
      <view wx:if="{{contextOpen}}" class="context-fields">
        <block wx:if="{{mediaKind === 'photo' && !isSample}}"><button class="text-button" bindtap="usePhotoMetadata">读取照片拍摄信息</button><text class="tiny">拍摄点 WGS84 · 可选，可清空</text><input value="{{latitude}}" data-key="latitude" bindinput="changeCoordinate" placeholder="纬度" /><input value="{{longitude}}" data-key="longitude" bindinput="changeCoordinate" placeholder="经度" /></block>
        <view class="context-pickers">
          <view><text class="context-label">观察日期</text><picker mode="date" value="{{observedDate || today}}" end="{{today}}" disabled="{{busy}}" data-key="observedDate" bindchange="changeContext"><view class="context-field">{{observedDate || '日期未知 · 选择'}}</view></picker></view>
          <view><text class="context-label">时刻（可选）</text><picker mode="time" value="{{observedTime || '12:00'}}" disabled="{{busy || !observedDate}}" data-key="observedTime" bindchange="changeContext"><view class="context-field {{observedDate ? '' : 'context-disabled'}}">{{observedTime || '时刻未知'}}</view></picker></view>
        </view>
        <view wx:if="{{observedDate}}" class="context-clear"><button wx:if="{{observedTime}}" class="text-button" bindtap="clearObservedTime" disabled="{{busy}}">仅保留日期</button><button class="text-button" bindtap="clearObservedDate" disabled="{{busy}}">清除观察时间</button></view>
        <text class="label">观察地点</text><input value="{{placeName}}" data-key="placeName" bindinput="changeContext" maxlength="80" disabled="{{busy}}" placeholder="公园或区域名称（可留空）" />
        <view class="tiny context-help">时间按北京时间填写；不确定可留空。保存时间不会代替观察时间。</view>
      </view>
    </view>
    <button class="primary wide spaced" loading="{{busy}}" disabled="{{busy || picking || analyzing}}" bindtap="save">保存私人观察到本机</button></block><view class="choice-row"><button bindtap="back">继续取景</button><button bindtap="import">再导入素材</button></view>
</view>
<view wx:if="{{error}}" class="recognition-error">{{error}}</view>
