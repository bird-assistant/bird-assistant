.compare-page{max-width:960px;padding:16px 16px calc(28px + env(safe-area-inset-bottom));overflow:visible}

.own{max-width:320px;width:75%;margin:0 auto 20px}

.own-label{display:block;font-size:13px;font-weight:600;margin-bottom:8px}

.compare-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 14px}

.compare-title{font-size:18px;font-weight:600}

.compare-count{font-size:12px;color:#7b8974}

.compare-search{position:relative;z-index:20}

.compare-note{margin:10px 0 14px;font-size:12px;line-height:1.7;color:#7b8974}

.comparison-scroll{width:100%;overflow:hidden}

.columns{display:flex;align-items:stretch;gap:12px;padding-bottom:4px}

.one-column{justify-content:center}

.column{flex:none;min-width:0;padding:12px;border:1px solid #dce5d7;border-radius:16px;background:#fffef9;box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden}

.column-actions{margin-top:auto;display:flex;flex-direction:column;gap:8px;padding-top:12px}

.choose-bird,.bird-detail,.remove-bird{width:100%;min-height:40px;min-width:0;margin:0;display:flex;align-items:center;justify-content:center;padding:8px;font-size:12px;line-height:1.5;box-sizing:border-box}

.bird-detail{background:#edf3e7;border:1px solid #d7e2d2;color:#285b49}

.choose-bird{background:#285b49;color:white}

.remove-bird{background:transparent;color:#85917d;border:0}

.compare-empty{padding:42px 24px;text-align:center;font-size:13px;line-height:1.9;color:#85917d;border:1px dashed #d7e2d2;border-radius:16px}
