<view class="page hub">
  <view wx:if="{{error}}" class="note error">{{error}} <button wx:if="{{screen !== 'publish'}}" class="text-button" bindtap="load">重新加载</button></view>
  <view wx:if="{{notice}}" class="note">{{notice}}</view>
  <block wx:if="{{screen === 'publish'}}"><view wx:if="{{postSpecies}}" class="topic-banner">鸟种话题 · {{postSpeciesName}}<text wx:if="{{!speciesSupported}}" class="species-source">本帖可发布到讨论首页；鸟种归档待服务更新后启用。</text></view>
    <view wx:if="{{publishAttachments.length}}" class="post-media-grid"><view wx:for="{{publishAttachments}}" wx:key="id" class="post-media-item"><button class="post-media-square" data-index="{{index}}" bindtap="previewGallery" aria-label="查看{{item.label}}"><image src="{{item.path}}" mode="aspectFill"/><text wx:if="{{item.kind === 'journal'}}" class="post-media-badge">手帐</text></button></view></view><image wx:elif="{{photo}}" class="photo" src="{{photo}}" mode="aspectFit"/>
    <view wx:if="{{draft}}" class="card"><text class="strong">{{draft.speciesName}}</text><view>{{draft.date || '日期未知'}} {{draft.time}} · {{draft.place || '地点未填写'}}</view><view>{{draft.device}}</view>
      <input placeholder="搜索或更正鸟种" data-field="keyword" bindinput="field"/><button bindtap="findSpecies">查找鸟种</button>
      <button wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" bindtap="pickSpecies">{{item.name || item.english || item.scientific}}</button>
      <button bindtap="choosePoint">{{draft.point ? '更改地图位置' : '在地图上选择观察地点'}}</button></view>
    <button wx:else bindtap="attach">选择讨论照片</button>
    <input placeholder="标题" maxlength="100" value="{{title}}" data-field="title" bindinput="field"/>
    <textarea placeholder="你观察到了什么？" maxlength="2000" value="{{body}}" data-field="body" bindinput="field"/>
    <photo-editor wx:if="{{photo && !publishAttachments.length}}" value="{{manualCamera}}" bindchange="photoDetails"/><view class="settings"><button data-field="post" bindtap="flag">{{post ? '☑' : '☐'}} 发布到讨论</button><button wx:if="{{draft}}" data-field="map" bindtap="flag">{{map ? '☑' : '☐'}} 添加地图鸟讯</button>
    <button data-field="anonymous" bindtap="flag">{{anonymous ? '☑' : '☐'}} 匿名署名</button><button wx:if="{{photo}}" data-field="sharePhoto" bindtap="flag">{{sharePhoto ? '☑' : '☐'}} 展示照片</button>
    <button wx:if="{{draft}}" data-field="shareDate" bindtap="flag">{{shareDate ? '☑' : '☐'}} 展示日期</button><button wx:if="{{draft || photo}}" data-field="shareCamera" bindtap="flag">{{shareCamera ? '☑' : '☐'}} 展示拍摄设备与参数</button></view>
    <button wx:if="{{draft}}" disabled="{{busy}}" data-mode="private" bindtap="prepare">只保存为云端私人观察</button><view wx:if="{{draft}}" class="tiny">生成预览会把这张照片及所填观察信息同步至你的私人记录。地图公开位置约至十公里。</view>
    <button class="primary wide" disabled="{{busy}}" bindtap="prepare">{{draft ? '同步私人观察并预览' : '预览公开内容'}}</button>
    <view wx:if="{{preview}}" class="card"><view wx:for="{{previewLines}}" wx:key="*this">{{item}}</view><button class="primary wide" disabled="{{busy}}" bindtap="submit">确认提交审核</button></view>
  </block>
  <block wx:elif="{{screen === 'growth'}}"><view class="title">{{record.points || 0}} 积分</view><view class="card">私人观察 {{record.observations || 0}} · 公开贡献 {{record.contributions || 0}} · 回复 {{record.replies || 0}}</view><view wx:for="{{record.badges}}" wx:key="*this" class="pill">{{item}}</view></block>
  <block wx:elif="{{screen === 'record'}}"><block wx:if="{{record}}">
    <view class="record-author"><view class="record-avatar">{{record.initial}}</view><view class="record-byline"><text class="record-name">{{record.publicName || record.source || '鸟友'}}</text><text class="record-time">{{record.visibility === 'private' ? '私人记录' : '发布于 '+(record.posted || '时间未注明')}}</text></view><button wx:if="{{record.visibility !== 'private'}}" class="record-menu" data-op="report" data-id="{{id}}" bindtap="action">举报</button></view>
    <view wx:if="{{record.visibility !== 'private'}}" class="record-kind">{{record.channel === 'map' ? '观察详情 · 公开鸟讯' : '讨论帖 · 在这里交流与回复'}}</view><view class="record-title">{{record.title || record.speciesName || '观察记录'}}</view><view wx:if="{{record.body || record.note}}" class="record-copy">{{record.body || record.note}}</view>
    <view wx:if="{{recordGallery.length > 1}}" class="post-media-grid"><view wx:for="{{recordGallery}}" wx:key="image" class="post-media-item"><button class="post-media-square" data-index="{{index}}" bindtap="selectRecordImage" aria-label="选择第{{index+1}}张图片"><image src="{{item.image}}" mode="aspectFill"/><text wx:if="{{item.kind === 'journal'}}" class="post-media-badge">手帐</text></button></view></view>
    <photo-card can-save="{{record.visibility === 'public'}}" saving="{{savingPhoto}}" bindsave="saveRecordImage" wx:if="{{photo && !photoFailed}}" src="{{photo}}" width="{{photoWidth}}" height="{{photoHeight}}" file-info="{{photoInfo}}" manual-info="{{manualPhotoInfo}}" resolution="{{displayResolution}}" bindloaded="photoLoaded" bindfailed="photoError"/><view wx:if="{{photoFailed}}" class="photo-unavailable">照片暂不可用，记录仍可查看。</view>
    <view wx:if="{{record.date || record.placeName || record.place}}" class="record-context"><view wx:if="{{record.date}}" class="context-detail"><image class="context-icon" src="/assets/icons/clock.png"/><text>观察日期 {{record.date}}</text></view><view wx:if="{{record.placeName || record.place}}" class="context-detail"><image class="context-icon" src="/assets/icons/pin.png"/><text>{{record.placeName || record.place}}</text></view></view>
    <view wx:if="{{record.channel === 'post' && !record.related && record.visibility !== 'private'}}" class="related-explanation">此帖未附地图鸟讯；拍摄信息由作者选择是否公开。</view>
    <view wx:if="{{record.related}}" class="related-explanation">观察详情保存地点与鸟讯；回复和交流集中在讨论帖。</view>
    <view class="record-links"><button wx:if="{{record.visibility === 'private'}}" class="record-link" bindtap="shareExisting">分享到讨论或地图</button><button wx:if="{{record.related}}" class="record-link" data-id="{{record.related.id}}" data-screen="record" bindtap="go">{{record.related.channel === 'map' ? '查看观察详情' : '返回讨论帖'}}</button><button wx:if="{{record.displayLocation || record.ownedSighting}}" class="record-link" bindtap="viewMap" loading="{{mapOpening}}" disabled="{{mapOpening}}">{{record.visibility === 'private' || record.ownedSighting ? '查看我的拍摄位置' : '查看公开位置区域'}}</button><button wx:if="{{record.speciesId}}" class="record-link" data-id="{{record.speciesId}}" data-screen="species" bindtap="go">鸟种资料与出现地点</button></view>
    <view wx:if="{{record.sourcePhoto}}" class="source-card"><view>照片 · {{record.sourcePhoto.credit}} · {{record.sourcePhoto.license}}</view><view class="source-links"><button class="reply-link" bindtap="copyCredit" data-url="{{record.sourcePhoto.sourceUrl}}">照片出处 ↗</button><button class="reply-link" bindtap="copyCredit" data-url="{{record.sourcePhoto.licenseUrl}}">照片许可 ↗</button></view></view>
    <view wx:if="{{record.sourceUrl}}" class="source-card"><view>{{record.source}} · {{record.attribution}} · {{record.licence}}</view><view>{{record.precisionLabel}}</view><view class="source-links"><button wx:if="{{record.licenceUrl}}" class="reply-link" bindtap="copyCredit" data-url="{{record.licenceUrl}}">记录许可 ↗</button><button class="reply-link" data-op="source" bindtap="action">原始记录 ↗</button><button class="reply-link" open-type="share">微信分享</button></view><button class="start-discussion" bindtap="discussExternal">围绕这条鸟讯发起讨论</button></view><button wx:if="{{record.sourceRecord}}" class="record-link" data-screen="record" data-id="{{record.sourceRecord}}" bindtap="go">查看引用的外部鸟讯</button>
    <block wx:if="{{record.channel === 'post' && record.visibility !== 'private'}}"><view class="record-actions"><button class="record-action {{record.liked ? 'is-on' : ''}}" data-op="like" catchtap="action" hover-class="record-action-hover" hover-stop-propagation aria-busy="{{reactionBusy.like}}"><image class="record-action-icon" src="/assets/icons/heart.png"/>{{record.liked ? '已赞' : '赞'}}{{record.hasLikes ? ' '+record.likes : ''}}</button><button class="record-action" bindtap="focusReplies"><image class="record-action-icon" src="/assets/icons/chat.png"/>回复 {{record.replyCount || 0}}</button><button class="record-action {{record.bookmarked ? 'is-on' : ''}}" data-op="bookmark" catchtap="action" hover-class="record-action-hover" hover-stop-propagation aria-busy="{{reactionBusy.bookmark}}"><image class="record-action-icon" src="/assets/icons/collection.png"/>{{record.bookmarked ? '已收藏' : '收藏'}}</button></view>
    <view class="discussion-heading"><text>回复 · {{record.replyCount || 0}}</text><button class="reply-link" bindtap="focusReplies">写回复</button></view><view wx:if="{{!replyThreads.length}}" class="reply-empty">还没有公开回复，来聊聊你的观察吧。</view>
    <view wx:for="{{replyThreads}}" wx:key="id" class="reply-thread"><view class="reply-head"><view class="reply-avatar">{{item.root.initial}}</view><view class="reply-byline"><text class="reply-name">{{item.root.publicName}}</text><text class="reply-time">{{item.root.posted}}</text></view><text wx:if="{{item.root.status === 'pending'}}" class="pending-label">待审核</text></view><view class="reply-text"><text wx:if="{{item.root.replyToName}}" class="reply-to">回复 {{item.root.replyToName}}：</text><text>{{item.root.body}}</text></view><view class="reply-tools"><button wx:if="{{item.root.status !== 'pending'}}" class="reply-link" data-id="{{item.root.id}}" bindtap="replyTo">回复</button><button wx:if="{{item.root.species}}" class="reply-link" data-screen="species" data-id="{{item.root.species}}" bindtap="go">查看建议鸟种</button><button wx:if="{{record.ownedSighting && item.root.species && item.root.status !== 'pending'}}" class="reply-link" data-id="{{item.root.id}}" data-op="adopt" bindtap="action">采纳到我的观察</button></view><view wx:if="{{item.children.length}}" class="thread-children"><view wx:for="{{item.children}}" wx:for-item="child" wx:key="id" class="child-reply"><view class="reply-head"><view class="reply-avatar">{{child.initial}}</view><view class="reply-byline"><text class="reply-name">{{child.publicName}}</text><text class="reply-time">{{child.posted}}</text></view><text wx:if="{{child.status === 'pending'}}" class="pending-label">待审核</text></view><view class="reply-text"><text wx:if="{{child.replyToName}}" class="reply-to">回复 {{child.replyToName}}：</text><text>{{child.body}}</text></view><view class="reply-tools"><button wx:if="{{child.status !== 'pending'}}" class="reply-link" data-id="{{child.id}}" bindtap="replyTo">回复</button><button wx:if="{{child.species}}" class="reply-link" data-screen="species" data-id="{{child.species}}" bindtap="go">查看建议鸟种</button><button wx:if="{{record.ownedSighting && child.species && child.status !== 'pending'}}" class="reply-link" data-id="{{child.id}}" data-op="adopt" bindtap="action">采纳到我的观察</button></view></view></view></view>
    <button wx:if="{{record.replyHasMore}}" class="places-more" bindtap="moreReplies">加载更早的回复</button><button wx:if="{{record.visibility === 'public'}}" open-type="share" class="quiet wide spaced">分享这条公开内容</button><view id="reply-composer" class="reply-composer"><view class="reply-compose-heading"><text>{{replyTarget ? '回复 '+replyTarget.name : '写下你的回复'}}</text><button wx:if="{{replyTarget}}" class="reply-link" bindtap="cancelReply">取消</button></view><textarea class="reply-input" maxlength="2000" value="{{body}}" data-field="body" bindinput="field" focus="{{replyFocused}}" bindblur="blurReply" placeholder="分享观察、辨识依据，或继续这段讨论…"/><view class="reply-extra"><button class="reply-link" bindtap="toggleReplySpecies">{{selectedSpecies ? '建议鸟种：'+selectedSpecies : '附加鸟种建议（选填）'}}</button><text class="reply-counter">{{body.length}} / 2000</text></view><view wx:if="{{replySuggestOpen}}" class="reply-species-search"><species-search placeholder="输入鸟名，附加到回复" bindselect="chooseReplySpecies"/></view><button wx:if="{{selectedSpecies}}" class="reply-link" bindtap="clearReplySpecies">移除鸟种建议</button><button class="send-reply" disabled="{{busy || !body}}" loading="{{busy}}" data-op="reply" bindtap="action">发送回复</button><text class="reply-policy">提交后先进入审核；未发送的文字会在请求失败时保留。</text></view>
    </block></block></block>
  <block wx:elif="{{screen === 'chat'}}"><view class="settings"><button data-op="block" bindtap="action">屏蔽</button><button data-op="unblock" bindtap="action">取消屏蔽</button><button bindtap="load">刷新</button></view>
    <view wx:for="{{items}}" wx:key="id" class="card"><text class="tiny">{{item.sender === self ? '我' : '对方'}}</text><view>{{item.body}}</view><button wx:if="{{item.sender !== self}}" data-op="report" data-id="{{item.id}}" bindtap="action">举报</button></view>
    <textarea data-field="body" value="{{body}}" bindinput="field" placeholder="写消息"/><button class="primary wide" disabled="{{busy}}" data-op="send" bindtap="action">发送</button></block>
  <block wx:else>
    <block wx:if="{{screen === 'library'}}"><input placeholder="中文名、英文名或学名" data-field="keyword" bindinput="field" bindconfirm="load"/><view class="library-actions"><button bindtap="load">搜索资料库</button><button bindtap="compareSpecies">并排对比鸟种</button></view><view wx:if="{{!keyword}}" class="featured"><button class="featured-bird" wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" data-screen="species" bindtap="go"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><text class="featured-name">{{item.name || item.english}}</text><view wx:if="{{item.photo}}" class="tiny featured-credit">{{item.photo.credit}} · {{item.photo.license}}</view></button></view><button wx:if="{{!keyword}}" bindtap="sparrowPair">树麻雀和家麻雀怎么分？</button></block>
    <block wx:if="{{screen === 'species' && record}}"><view class="species-heading"><view class="species-name">{{record.name || record.english}}</view><text class="species-scientific">{{record.scientific}}</text><text class="species-family">{{record.english}} · {{record.family}}</text></view><view class="species-tabs"><button class="species-tab {{tab === 'identity' ? 'is-selected' : ''}}" data-tab="identity" bindtap="changeTab">图鉴</button><button class="species-tab {{tab === 'places' ? 'is-selected' : ''}}" data-tab="places" bindtap="changeTab">出现地点 {{placeCount}}</button><button class="species-tab {{tab === 'posts' ? 'is-selected' : ''}}" data-tab="posts" bindtap="changeTab">相关讨论</button></view>
    <view wx:if="{{tab === 'identity'}}" class="species-panel"><guide-card bird-id="{{id}}" profile="{{record}}" hide-heading/><button class="start-discussion" bindtap="compareSpecies">与其他鸟种并排对比</button><view class="species-summary">{{placeCount}} 个公开区域 · {{recordCount}} 条鸟讯</view><text class="species-source">{{record.source}}</text></view>
    <block wx:elif="{{tab === 'places'}}"><view class="places-intro">{{placeCount}} 个公开区域 · {{recordCount}} 条历史记录 · 区域内按观察日期从新到旧</view><view class="place-sort"><button data-sort="distance" bindtap="sortPlaces" disabled="{{!placePoint}}" class="{{placeSort === 'distance' ? 'active' : ''}}">距离最近</button><button data-sort="recent" bindtap="sortPlaces" class="{{placeSort === 'recent' ? 'active' : ''}}">观察最新</button></view><view wx:if="{{!placePoint}}" class="tiny">在首页地图选择区域后可按距离排序。</view><view wx:if="{{placesError}}" class="note error">{{placesError}}<button bindtap="load">重试</button></view><view wx:if="{{!placeCount}}" class="species-empty">暂无获准公开的地点。</view><button wx:for="{{places}}" wx:key="id" class="place-card" data-id="{{item.id}}" bindtap="speciesMap"><view class="place-pin"><image class="place-icon" src="/assets/icons/pin.png"/></view><view class="place-copy"><view class="place-heading"><text class="place-name">{{item.placeName || '公开观测区域'}}</text><text class="place-count">{{item.records}} 条</text></view><text wx:if="{{item.distanceLabel}}" class="place-distance">{{item.distanceLabel}}</text><text class="place-date">{{item.latest ? '最近记录 '+item.latest : '日期未知'}}</text></view><view class="drawn-next"/></button><button wx:if="{{places.length < placeCount}}" class="places-more" bindtap="morePlaces" loading="{{placeLoading}}" disabled="{{placeLoading}}">加载更多区域</button></block>
    <block wx:else><view wx:if="{{postsError}}" class="note error">{{postsError}}<button bindtap="load">重试</button></view><view class="places-intro">围绕这个鸟种分享观察、提问和辨识依据。</view><button class="start-discussion" bindtap="startSpeciesDiscussion">发起关于{{record.name || record.english}}的讨论</button><view wx:if="{{!speciesPosts.length}}" class="species-empty">还没有相关的公开讨论。</view><view wx:for="{{speciesPosts}}" wx:key="id" class="species-post" data-screen="record" data-id="{{item.id}}" bindtap="go"><text class="species-post-author">{{item.publicName}}</text><text class="species-post-title">{{item.title}}</text><view class="species-post-body">{{item.body}}</view><view class="species-post-footer">查看讨论</view></view></block></block>
    <button wx:if="{{screen === 'feed'}}" data-screen="publish" data-id="compose" bindtap="go">发布讨论</button>
    <view wx:if="{{screen !== 'species' && !items.length && !busy && !error}}" class="note">暂无记录</view>
    <block wx:if="{{screen === 'bookmarks'}}"><view class="saved-heading"><view class="section-title">收藏的公开内容</view><text class="muted">{{items.length}} 份</text></view><view class="saved-card" wx:for="{{items}}" wx:key="id"><button class="saved-main" data-screen="record" data-id="{{item.id}}" bindtap="go"><image wx:if="{{item.image}}" class="saved-image" src="{{item.image}}" mode="aspectFill"/><view class="saved-copy"><view class="saved-kind">{{item.channel === 'map' ? '地图鸟讯' : '鸟友帖子'}}</view><view class="saved-title">{{item.title || item.speciesName || '未命名内容'}}</view><view wx:if="{{item.body || item.note}}" class="saved-excerpt">{{item.body || item.note}}</view><view class="muted">{{item.source || '羽迹社区'}} · {{item.date || '观察日期未知'}}</view></view><view class="drawn-next"/></button><view class="saved-footer"><button class="text-button" disabled="{{busy}}" data-op="unbookmark" data-id="{{item.id}}" bindtap="action">取消收藏</button></view></view></block>
    <view wx:for="{{items}}" wx:if="{{screen !== 'species' && screen !== 'bookmarks'}}" wx:key="id" class="card hub-list-card"><button class="rowbtn hub-list-main" data-id="{{screen === 'inbox' ? item.peer : item.id}}" data-screen="{{screen === 'library' ? 'species' : screen === 'inbox' ? 'chat' : 'record'}}" disabled="{{screen === 'mine' && item.status !== 'approved'}}" bindtap="go"><view class="hub-list-copy"><text class="hub-list-title">{{item.title || item.name || item.english || item.scientific || item.body || item.place || '私人观察'}}</text><text class="hub-list-subtitle">{{item.source || ''}} {{item.date || item.created || ''}} {{item.placeName || ''}}</text></view><view class="drawn-next"/></button>
    <view wx:if="{{screen === 'mine'}}" class="hub-list-controls"><text class="hub-list-status">{{item.channel === 'map' ? '地图' : '讨论'}} · {{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已公开' : item.status === 'withdrawn' ? '已撤回' : '审核未通过'}}</text><view wx:if="{{item.reason}}">审核反馈 · {{item.reason}}</view><button wx:if="{{item.ownedSighting}}" data-screen="record" data-id="{{item.ownedSighting}}" bindtap="go">查看原观察</button><button wx:if="{{item.status !== 'withdrawn'}}" class="hub-list-action" data-op="withdraw" data-id="{{item.id}}" bindtap="action">撤回</button></view>
    <button class="hub-list-action bookmark-remove" wx:if="{{screen === 'bookmarks'}}" data-op="unbookmark" data-id="{{item.id}}" bindtap="action">取消收藏</button></view>
    <view wx:if="{{screen === 'external'}}" class="settings"><button disabled="{{busy || externalPage === 0}}" data-direction="-1" bindtap="externalPage">上一页</button><text>第 {{externalPage + 1}} 页</text><button disabled="{{busy || !externalNext}}" data-direction="1" bindtap="externalPage">下一页</button></view>
  </block>
</view>
