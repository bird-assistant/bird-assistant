<view class="page compare-page"><view wx:if="{{subject}}" class="own"><text class="own-label">这次拍到的鸟</text><bird-crop src="{{subject.src}}" box="{{subject.box}}"/></view><view class="compare-heading"><text class="compare-title">并排看，仔细比</text><text class="compare-count">{{ids.length}} / 3 鸟种</text></view><view wx:if="{{ids.length<3}}" class="compare-search"><species-search placeholder="输入鸟名，添加到对比" selected-ids="{{ids}}" bindselect="add"/></view><view class="compare-note">{{ids.length === 3 ? '向左滑动可查看后面的鸟种' : '输入关键词即可搜索；照片与资料保留来源。'}}</view><view wx:if="{{!ids.length}}" class="compare-empty">先添加一个鸟种，再选择想比较的鸟种。</view><view wx:if="{{notice}}" class="compare-note">{{notice}}</view>
<scroll-view scroll-x class="comparison-scroll"><view class="columns {{ids.length === 1 ? 'one-column' : ''}}"><view wx:for="{{ids}}" wx:key="*this" class="column" style="width:{{columnWidth}}px"><guide-card bird-id="{{item}}" compact/><view class="column-actions"><button wx:for="{{candidates}}" wx:for-item="candidate" wx:key="*this" wx:if="{{candidate === item}}" class="choose-bird" data-id="{{item}}" bindtap="choose">选用此候选</button><button class="bird-detail" data-id="{{item}}" bindtap="detail">查看鸟种资料</button><button class="remove-bird" data-id="{{item}}" bindtap="remove">移出对比</button></view></view></view></scroll-view></view>
