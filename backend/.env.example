BIRD_VISION_ENVIRONMENT=development
BIRD_VISION_LOG_LEVEL=INFO

# mock is safe for API development; yolo loads the real detector.
BIRD_VISION_DETECTOR_BACKEND=mock
BIRD_VISION_DEVICE=cpu
BIRD_VISION_MODEL_PATH=../鸟类识别预研/models/yolo11n.pt
# Production requires the SHA-256 of the exact local weight file.
BIRD_VISION_MODEL_SHA256=
BIRD_VISION_MODEL_IMAGE_SIZE=640
BIRD_VISION_DETECTION_CONFIDENCE=0.25
BIRD_VISION_DETECTION_IOU=0.50
BIRD_VISION_DETECTION_CLASS_IDS=14
BIRD_VISION_DETECTION_EXPECTED_CLASS_NAMES=bird
BIRD_VISION_DETECTION_MAX_DETECTIONS=50

# disabled supports API development without loading BioCLIP; the full catalog
# remains queryable. Set bioclip on the GPU worker for real species candidates.
BIRD_VISION_SPECIES_BACKEND=disabled
BIRD_VISION_SPECIES_CATALOG_PATH=config/catalog/avilist_v2026_global.csv
BIRD_VISION_BIOCLIP_MODEL=hf-hub:imageomics/bioclip-2
# Production hf-hub sources require a full 40-character commit SHA and the
# fingerprint reported by a reviewed startup/check_runtime run.
BIRD_VISION_BIOCLIP_MODEL_REVISION=
BIRD_VISION_BIOCLIP_EXPECTED_FINGERPRINT=
BIRD_VISION_SPECIES_TOP_K=5
BIRD_VISION_SPECIES_BATCH_SIZE=8
BIRD_VISION_SPECIES_TEXT_BATCH_SIZE=256
BIRD_VISION_SPECIES_PRECISION=auto
BIRD_VISION_SPECIES_TEXT_CACHE_DIR=runtime/species-text-cache
BIRD_VISION_SPECIES_DEFAULT_REGION_CODE=CN
# Region is a ranking prior, never a hard filter. Thresholds must be calibrated
# on the project's held-out field-photo set before claiming accuracy.
BIRD_VISION_SPECIES_REGION_PRIOR_BONUS=0.015
BIRD_VISION_SPECIES_MIN_SIMILARITY=0.20
BIRD_VISION_SPECIES_MIN_MARGIN=0.01

# Comma-separated server-side keys. Never ship them in the mini program.
# Leave empty only in development/test.
BIRD_VISION_API_KEYS=
BIRD_VISION_ALLOW_ANONYMOUS=true

BIRD_VISION_MAX_IMAGE_BYTES=6291456
BIRD_VISION_MAX_IMAGE_PIXELS=8294400
BIRD_VISION_MAX_SESSIONS=64
BIRD_VISION_MAX_SESSIONS_PER_PRINCIPAL=8
BIRD_VISION_MAX_FRAME_RATE=5.0
BIRD_VISION_MAX_FRAMES_PER_SESSION=100000
BIRD_VISION_FRAME_MAX_QUEUE_AGE_MS=2000
BIRD_VISION_SESSION_IDLE_TTL_SECONDS=300
BIRD_VISION_MAX_CONCURRENT_INFERENCE=1
BIRD_VISION_INFERENCE_TIMEOUT_SECONDS=30
BIRD_VISION_MAX_CONCURRENT_DECODES=4
BIRD_VISION_UPLOAD_TIMEOUT_SECONDS=15
BIRD_VISION_MAX_BUFFERED_IMAGE_BYTES=536870912
BIRD_VISION_MAX_SAVED_CROP_BYTES=134217728
BIRD_VISION_MAX_SUBSCRIBERS_PER_SESSION=2

# auto selects ByteTrack with YOLO and the lightweight motion tracker with mock.
BIRD_VISION_TRACKER_BACKEND=auto
BIRD_VISION_TRACK_IOU_THRESHOLD=0.30
BIRD_VISION_TRACK_HIGH_CONFIDENCE=0.25
BIRD_VISION_TRACK_LOW_CONFIDENCE=0.10
BIRD_VISION_TRACK_MAX_MISSED_FRAMES=5
BIRD_VISION_TRACK_CONFIRM_HITS=3
BIRD_VISION_MIN_RECOGNIZABLE_SIDE_PX=64
BIRD_VISION_SPECIES_MAX_CROP_SIDE_PX=1024
BIRD_VISION_CLASSIFICATION_COOLDOWN_SECONDS=5.0
BIRD_VISION_CLASSIFICATION_MIN_QUALITY_GAIN=0.10
BIRD_VISION_CLASSIFICATION_REFRESH_SECONDS=15.0
BIRD_VISION_SPECIES_EVIDENCE_WINDOW=5
