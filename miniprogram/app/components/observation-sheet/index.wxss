@import '../../styles/common.wxss';
:host {
  display: block;
  height: 100%;
}
.sheet {
  box-sizing: border-box;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fafbf6;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -12rpx 50rpx #243b3520;
  padding: 14rpx 26rpx calc(24rpx + env(safe-area-inset-bottom));
}
.handle {
  width: 64rpx;
  height: 7rpx;
  background: #d8e2cf;
  border-radius: 8rpx;
  margin: 0 auto 22rpx;
}
.heading {
  align-items: flex-start;
  margin-bottom: 18rpx;
  flex-shrink: 0;
}
.close-button {
  margin: 0;
  border-radius: 20rpx;
  line-height: 1.5;
  font-size: 24rpx;
  color: #285c49;
  background: #edf3e7;
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  min-height: 76rpx;
}
.records {
  flex: 1;
  height: 0;
  min-height: 0;
}
.record {
  box-sizing: border-box;
  color: #243b35;
  line-height: 1.5;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  padding: 20rpx;
  margin-bottom: 14rpx;
  text-align: left;
  background: #fffef9;
  border: 1rpx solid #dfe7d8;
  border-radius: 24rpx;
}
.thumbnail {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #607369;
  background: #eaf1e2;
}
.record-name {
  font-weight: 600;
  overflow-wrap: anywhere;
}
.muted {
  font-size: 22rpx;
}
.private-label {
  font-size: 20rpx;
  color: #42617b;
}
.record-info {
  overflow: hidden;
}
.close-button::after,
.record::after {
  border: 0;
}
