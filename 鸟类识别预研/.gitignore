# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- build output ----
build/
dist/
*.spec

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- local runtime output ----
results/gui/
*.log

# ---- large assets: restore with `python scripts/fetch_assets.py` ----
# model weights (yolo11x is 109 MB > GitHub's 100 MB per-file limit)
models/*.pt
models/birdnet/*.tflite
models/birdnet/*.txt
models/torch_hub/
models/ultralytics/

# raw media (videos ~44 MB, audio ~23 MB)
data/videos/*.webm
data/videos/*.mp4
data/videos/*.mov
data/videos/variants/
data/audio/*.ogg
data/audio/*.mp3
data/audio/wav/

# rendered outputs (regenerated by the experiment scripts)
results/**/*.mp4
