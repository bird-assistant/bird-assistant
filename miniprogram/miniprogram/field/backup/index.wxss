.local-backup{padding-bottom:calc(30px + env(safe-area-inset-bottom))}.local-backup .title{font-size:27px;line-height:1.5}.backup-explanation{font-size:12px;line-height:1.9;color:#78916a;margin:15px 0 22px}.backup-explanation>text{display:block;margin-top:8px;color:#8d947b}.backup-card{margin:18px 0;padding:18px;border:1px solid #dce5d2;border-radius:18px;background:#fffef9}.backup-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#486b47;font-weight:600;font-size:17px;margin-bottom:12px}.backup-heading>text{font-size:10px;font-weight:400;color:#8da17c;flex:none}.backup-included{font-size:13px;margin:8px 0;color:#66875b}.local-backup .tiny{font-size:10px;line-height:1.9;color:#8d9e80}.backup-selection-heading{display:flex;align-items:center;justify-content:space-between;font-size:12px;margin:18px 0 8px}.backup-selection-heading button{font-size:11px;padding:5px 0;margin:0}.backup-journal-list{max-height:230px;height:180px;border:1px solid #e1e8d8;border-radius:12px;padding:6px;background:#f7f9f1}.backup-journal-row{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:10px 7px;margin:0;border-radius:7px;background:transparent;min-height:40px;font-size:12px}.backup-journal-row>text{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.backup-check{width:18px;height:18px;border:1px solid #b7c8a7;border-radius:5px;flex:none;display:flex;align-items:center;justify-content:center;background:#fffef9}.backup-check.checked{background:#d9e7cd;border-color:#9eb88a}.backup-check image{width:13px;height:13px}.backup-ready{margin:18px 0 0;padding:14px;border-radius:13px;background:#edf3e3;color:#6d875c;font-size:11px;line-height:1.9}.backup-ready .strong{font-size:13px}.backup-ready>text{display:block;margin-top:7px}.backup-ready>view:last-child{font-size:10px;color:#8a9b79;margin-top:12px}.backup-import-info{border-top:1px solid #e0e7d5;padding-top:14px;margin-top:17px;font-size:12px;line-height:1.9;color:#7c936a}.backup-status{padding:12px 14px;border:1px solid #d4e2c6;background:#edf4e5;border-radius:12px;color:#71905f;font-size:12px;line-height:1.8}.backup-cancel{display:block;margin:12px auto;font-size:12px}.local-backup button.wide{font-size:13px;min-height:43px}@media(max-width:340px){.local-backup .title{font-size:23px}.backup-card{padding:14px}.backup-heading{font-size:15px}}
