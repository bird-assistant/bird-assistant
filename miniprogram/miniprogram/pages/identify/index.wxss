.mode-advice{position:absolute;z-index:12;top:102px;left:14px;right:14px;max-width:480px;margin:auto;padding:17px;border:1px solid #d8e2d0;border-radius:16px;background:#fffef9f5;color:#6b7f61;font-size:12px;line-height:1.8;box-shadow:0 8px 28px #17352b30}.mode-advice .strong{font-size:15px;color:#285b49;margin-bottom:6px}.capture-advice{margin-top:8px}.advice-note{display:block;font-size:10px;margin-top:6px;color:#8b987f}.advice-actions{display:flex;gap:8px;margin-top:12px}.advice-actions>button{flex:1;min-width:0;min-height:36px;margin:0;padding:6px;font-size:12px;background:#edf3e7;color:#285b49}
.bird-box{position:absolute;left:28%;top:28%;width:49%;height:26%;border:1px solid #e5efcf66}.bird-box>text{position:absolute;top:-29px;left:0;padding:4px 8px;background:#e5efcf;color:#285b49;font-size:11px;border-radius:7px 7px 0 0;white-space:nowrap}.corner{position:absolute;width:15px;height:15px;border-color:#e5efcf;border-style:solid}.tl{left:-1px;top:-1px;border-width:3px 0 0 3px}.tr{right:-1px;top:-1px;border-width:3px 3px 0 0}.bl{left:-1px;bottom:-1px;border-width:0 0 3px 3px}.br{right:-1px;bottom:-1px;border-width:0 3px 3px 0}
.camera-cover{position:absolute;top:140px;left:22px;right:22px;max-width:420px;margin:auto;display:flex;flex-direction:column;align-items:center;gap:8px;padding:14px;border-radius:14px;background:#eff4e8ed;text-align:center;color:#285b49;box-sizing:border-box}.camera-cover-heading{display:flex;align-items:center;justify-content:center;gap:8px}.camera-cover-heading .i{width:18px;height:18px}.camera-cover .strong{font-size:15px;line-height:22px}.camera-cover-copy{font-size:12px;line-height:18px}.camera-cover-actions{display:flex;gap:8px;width:100%;margin-top:4px}.camera-cover-actions>button{flex:1;width:0;min-width:0;min-height:38px;margin:0;padding:8px 6px;font-size:12px;line-height:20px}
.live-bottom{position:absolute;bottom:0;left:0;right:0;max-width:650px;margin:auto;padding:22px 12px 34px;box-sizing:border-box;background:linear-gradient(0deg,#102e24ed,#102e2490 65%,transparent)}
.zoom-control{margin-bottom:10px;user-select:none;color:#eff5df;touch-action:none}.zoom-presets{display:flex;align-items:center;gap:7px;height:30px}.zoom-preset-list{display:flex;align-items:center;justify-content:center;gap:7px;flex:1;min-width:0}.zoom-presets button{display:flex;align-items:center;justify-content:center;flex:none;height:30px;min-height:30px;margin:0;padding:0;border:1px solid #ffffff45;background:#173c3180;color:#f3f8e8;font-size:11px;line-height:18px;box-sizing:border-box}.zoom-presets .zoom-step{width:30px;min-width:30px;border-radius:50%;font-size:16px}.zoom-presets .zoom-preset{width:39px;min-width:39px;border-radius:16px}.zoom-presets .zoom-selected{border-color:#e0edae;color:#edf6c7;background:#65845188}.zoom-presets button[disabled]{opacity:.4}
.zoom-chip{display:flex;align-items:baseline;justify-content:center;gap:8px;width:auto;min-width:0;min-height:32px;margin:5px auto 0;padding:3px 12px;border:0;border-radius:18px;background:#173c3145;color:#edf4cc;line-height:22px}.zoom-chip::after{border:0}.zoom-current{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}.zoom-swipe-hint{font-size:10px;font-weight:400;color:#e9f1dbbf}.zoom-chevron{font-size:15px;margin-left:5px}
.zoom-scale{position:relative;height:43px;overflow:hidden;touch-action:none}.zoom-track{position:absolute;inset:4px 0 0;height:38px;pointer-events:none}.zoom-axis{position:absolute;left:0;right:0;top:15px;height:1px;background:#ffffff45}.zoom-tick{position:absolute;top:0;width:30px;margin-left:-15px;height:36px;text-align:center}.zoom-tick-line{position:absolute;left:50%;top:8px;width:1px;height:7px;background:#e9f2d8aa}.zoom-major .zoom-tick-line{top:2px;height:13px;background:#edf4df}.zoom-tick text{position:absolute;top:20px;left:0;right:0;color:#e9f2d8;font-size:9px;line-height:13px}.zoom-centre{position:absolute;left:50%;top:0;width:2px;height:19px;margin-left:-1px;background:#e5efad;box-shadow:0 0 5px #e5efad55}.zoom-range{text-align:center;font-size:9px;line-height:15px;color:#e4eddbbf}.zoom-disabled .zoom-scale{opacity:.5}
.clue-panel{margin-bottom:10px;padding:4px;border:1px solid #eff3e2b0;border-radius:17px;background:#f1f5e8e8;box-sizing:border-box;overflow:hidden}.clue-tabs{display:flex;align-items:center;gap:3px}.clue-tabs>button{flex:1;width:0;min-width:0;display:flex;align-items:center;justify-content:center;gap:5px;height:39px;min-height:39px;margin:0;padding:6px 3px;border:0;border-radius:12px;background:transparent;color:#748767;font-size:12px;line-height:19px;white-space:nowrap}.clue-tabs>button.on{background:#fffef9;color:#285b49;font-weight:600}.clue-tabs .i{width:18px;height:18px;flex:none}.clue-tabs .expand-button{width:32px;min-width:32px;max-width:32px;flex:none;padding:6px}.expand-button .i{width:15px;height:15px;transform:rotate(90deg)}.expand-button .i.turned{transform:rotate(-90deg)}.clue-dot{width:5px;height:5px;flex:none;border-radius:50%;background:#6a914f}.recording-dot{background:#b7674b}
.clue-summary{display:flex;align-items:center;gap:10px;padding:10px 8px 8px}.clue-copy{display:flex;flex-direction:column;flex:1;min-width:0;gap:3px}.clue-title{font-size:13px;line-height:19px;font-weight:600;color:#385444;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.clue-note{font-size:10px;line-height:15px;color:#819076}.vision-toggle,.audio-capture{flex:none;min-width:48px;min-height:34px;margin:0;padding:7px 10px;border:1px solid #c7d6ba;border-radius:11px;background:#285b49;color:#fffef9;font-size:12px;line-height:18px}.vision-on{background:#edf3e7;color:#285b49}.clue-detail{height:100px;max-height:100px;box-sizing:border-box;padding:0 8px;color:#6b7f61;font-size:11px;line-height:1.7}.clue-detail-copy{padding:4px 0 10px}.clue-detail button{width:100%;min-height:34px;padding:6px;margin:8px 0;font-size:11px}
.capture-row{display:flex;align-items:center;justify-content:space-around;gap:15px;padding:8px 8px 0}.capture-side{display:flex;flex:1;min-width:0;max-width:95px;flex-direction:column;align-items:center;gap:6px;margin:0;padding:0;background:transparent;color:#f3f7e8;font-size:11px;line-height:18px;white-space:nowrap}.capture-icon{width:25px;height:25px;filter:brightness(0) invert(1)}.shutter{flex:none;box-sizing:border-box;width:66px;min-width:66px;max-width:66px;height:66px;min-height:66px;margin:0;padding:4px;border:2px solid #edf4e2;border-radius:50%;background:transparent}.shutter>view{width:100%;height:100%;border-radius:50%;background:#eff5e1}.shutter.video-recording>view{background:#b9654d;border-radius:10px;transform:scale(.65)}.evidence-count{display:flex;align-items:center;justify-content:center;width:31px;height:27px;border-radius:11px;background:#e2ebd6;color:#526b48;font-size:14px;font-weight:600}.capture-hint{min-height:24px;padding-top:8px;color:#e9f1df;text-align:center;font-size:10px;line-height:16px}
.camera-short .live-bottom{padding-top:10px;padding-bottom:28px}.camera-short .clue-summary{padding:6px 8px}.camera-short .clue-note{display:none}.camera-short .clue-detail{height:60px}.camera-short .capture-row{padding-top:3px}.camera-short .shutter{width:54px;min-width:54px;max-width:54px;height:54px;min-height:54px}.camera-short .capture-hint{padding-top:4px;min-height:18px}.camera-short .clue-tabs>button{min-height:34px}.camera-short .zoom-control{margin-bottom:6px}.camera-short .mode-caption{display:none}.camera-short .view-tags{top:72px}.camera-short .camera-cover{top:112px}
@media (max-width:350px){.zoom-preset-list{gap:4px}.zoom-presets .zoom-preset{width:34px;min-width:34px}.zoom-presets{gap:4px}.live-mode .segments>button{font-size:13px}.clue-tabs>button{font-size:11px}}

/* Import, review and evidence remain independent of the live camera. */
.evidence-count{display:flex;align-items:center;justify-content:center;width:31px;height:27px;border-radius:11px;background:#e2ebd6;font-size:14px;font-weight:600}
.import-drop{margin:18px 0 12px;min-height:170px;width:100%;border:1px dashed #aec19b;background:#edf3e4;display:flex;flex-direction:column;gap:12px;align-items:center;justify-content:center;padding:22px}
.import-drop image{width:36px;height:36px}
.divider{border-top:1px solid #dfe7d8;margin:22px 0}
.evidence-strip{width:100%;white-space:nowrap;margin:18px 0}
.evidence-item{position:relative;display:inline-block;vertical-align:top;width:94px;margin-right:9px;padding:4px;border:1px solid #d8e3d2;border-radius:10px;background:#fffef9}
.evidence-item>button:first-child{padding:0;background:none;display:flex;align-items:center;flex-direction:column;gap:4px;font-size:10px}
.evidence-item image{width:84px;height:68px;border-radius:6px}
.evidence-item .media-icon{padding:17px;background:#eaf0e2}
.evidence-selected{border:2px solid #285b49;padding:3px}
.evidence-remove{position:absolute;right:0;top:0;width:24px;height:24px;min-height:0;line-height:22px;padding:0;background:#fffef9db;border-radius:50%;font-size:18px}
.review-photo{width:100%;height:230px;background:#e6eddf;border-radius:12px}
.recognition-error{position:fixed;bottom:100px;left:18px;right:18px;z-index:30;padding:12px 14px;border-radius:12px;background:#fff4e9f5;color:#96503f;font-size:12px;box-shadow:0 3px 15px #253c3422}
.import-drop{width:100%;max-width:100%;box-sizing:border-box}
.evidence-strip{height:118px;box-sizing:border-box}
.evidence-item{max-width:94px}
.evidence-item>button:first-child{width:100%}
.page>.title{font-size:25px;margin-top:9px}
.import-drop{padding:25px 17px;gap:11px}
.import-drop>image{width:35px;height:35px}
.import-drop .strong{font-size:14px}
.recognition-error{bottom:18px}
.import-drop{min-height:0;justify-content:flex-start}
.import-drop .tiny{font-size:10px;line-height:1.4}
.page>.segments{padding:3px;gap:3px;margin:16px 0}
.page>.segments>button{min-height:40px;font-size:13px;padding:10px 6px}
.media-icon-box{width:84px;height:68px;flex:none;display:flex;align-items:center;justify-content:center;background:#eaf0e2;border-radius:6px}
.evidence-item .media-icon-box .media-icon{width:32px;height:32px;min-width:32px;min-height:32px;flex:none;padding:0;background:transparent;border-radius:0}
.observation-context{margin-top:18px;border:1px solid #dce5d7;border-radius:12px;background:#fffef9;overflow:hidden}
.context-toggle{width:100%;min-height:64px;gap:12px;padding:12px;background:transparent;justify-content:space-between;text-align:left;border-radius:0}
.context-heading{display:flex;flex-direction:column;min-width:0;gap:4px;flex:1}
.context-heading .strong{font-size:12px;line-height:18px}
.context-heading .tiny{line-height:17px;overflow-wrap:anywhere}
.context-toggle-label{flex:none;font-size:12px;line-height:20px}
.context-fields{padding:0 12px 14px;border-top:1px solid #e7ecdf}
.context-pickers{display:flex;gap:10px;margin-top:12px}
.context-pickers>view{flex:1;min-width:0}
.context-label{display:block;font-size:12px;line-height:18px;margin-bottom:5px;color:#62775b}
.context-field{display:flex;align-items:center;min-height:44px;padding:8px 10px;border:1px solid #d8e3d2;border-radius:10px;font-size:12px;line-height:20px;color:#285b49}
.context-disabled{opacity:.5}
.context-clear{display:flex;justify-content:flex-end;gap:14px;margin-top:5px}
.context-clear .text-button{min-height:32px;font-size:11px}
.context-fields .label{margin-top:12px}
.context-help{margin-top:9px}
.vision-encoder{position:fixed;left:-2000px;top:0;width:1px;height:1px;pointer-events:none}
.vision-box{position:absolute;box-sizing:border-box;border:2px solid #94f3ac;pointer-events:none}
.vision-tentative{border:2px dashed #f2d98c}
.vision-lost{border:1px dashed #d8dddc;opacity:.72}
.vision-tag{background:#254638;color:white;font-size:11px;line-height:18px;height:18px;padding:0 4px}
.vision-list{padding-bottom:8px}
.vision-result{background:#f2f5ed;border-radius:12px;padding:12px;margin-top:8px}
.vision-subject{margin:8px 0;padding-top:6px;border-top:1px solid #cbd7c9}
.vision-choice{display:flex;justify-content:space-between;align-items:center;width:100%;padding:6px 8px;margin-top:4px;background:white;color:#285b49;font-size:13px}
.review-targets{position:relative;width:100%;overflow:hidden;border-radius:12px}
.review-targets image{width:100%;display:block}
.candidate-actions{display:flex;gap:8px;align-items:stretch}
.candidate-actions .vision-choice{flex:1;min-width:0}
.candidate-info{flex:none;font-size:12px;background:#e0eadd;border:1px solid #aac2a5;color:#285b49;padding:9px;min-height:44px}
.recognition-error{bottom:calc(90px + env(safe-area-inset-bottom))}

/* Two independent compact handles leave the shutter and viewfinder available. */
.live-bottom{padding-top:12px;padding-bottom:22px}.zoom-control{margin-bottom:7px}.zoom-chip{display:flex;align-items:center;justify-content:center;gap:9px;width:auto;min-width:98px;min-height:32px;height:32px;margin:0 auto;padding:5px 12px;background:#183e3299;border:1px solid #eff5df44;border-radius:18px}.zoom-current{font-size:18px;line-height:22px}.zoom-swipe-hint{font-size:10px;line-height:16px;color:#e3ebd3cc}.control-chevron{width:7px;height:7px;margin:4px 2px 0;border-left:1.7px solid currentColor;border-top:1.7px solid currentColor;transform:rotate(45deg);flex:none;transition:transform .2s ease}.control-chevron-down{transform:rotate(225deg);margin-top:-3px}.zoom-body,.clue-body{max-height:0;opacity:0;overflow:hidden;pointer-events:none;transform:translateY(5px);transition:max-height .22s ease,opacity .18s ease,transform .22s ease}.zoom-body.control-open{max-height:110px;opacity:1;pointer-events:auto;transform:translateY(0);padding-top:9px}.clue-body.control-open{max-height:250px;opacity:1;pointer-events:auto;transform:translateY(0)}.clue-handle{display:flex;align-items:center;gap:7px;width:100%;height:33px;min-height:33px;margin:0;padding:5px 8px;border-radius:12px;background:transparent;color:#42634f;line-height:20px}.clue-handle .i{width:17px;height:17px;flex:none}.clue-handle-title{font-size:12px;font-weight:600;white-space:nowrap}.clue-handle-status{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;text-align:right;color:#7b8f71}.clue-handle .control-chevron{margin-left:5px}.clue-panel{margin-bottom:9px}.camera-short .live-bottom{padding-bottom:12px}.camera-short .clue-handle{height:30px;min-height:30px}
@media(prefers-reduced-motion:reduce){.zoom-body,.clue-body,.control-chevron{transition:none}}

.zoom-chip{box-sizing:border-box;width:132px;flex-wrap:nowrap;white-space:nowrap}.zoom-current,.zoom-swipe-hint{flex:none;white-space:nowrap}.zoom-swipe-hint{min-width:24px}.clue-handle-title{letter-spacing:.2px}

.import-modes{display:flex;gap:6px;margin-top:18px}.import-mode{flex:1;min-width:0;min-height:42px;margin:0;padding:8px 4px;border:1px solid #dce5d7;border-radius:12px;background:#f2f6eb;color:#75876b;font-size:12px;line-height:1.5}.import-mode-on{background:#285b49;color:#fffef9;border-color:#285b49}.import-help{margin-top:9px;min-height:34px}.import-empty{padding:24px 10px;text-align:center;color:#829577;font-size:12px;border:1px dashed #d6e2cf;border-radius:14px}.audio-candidates{margin-bottom:16px}

.clue-detail,.camera-short .clue-detail{max-height:130px;padding:0 8px}.clue-detail-content{padding-bottom:4px}.audio-file{width:84px;height:68px;border-radius:6px;background:#eaf0e2;display:flex;flex-direction:column;justify-content:center;padding:8px;gap:5px}.audio-file-name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:normal;overflow-wrap:anywhere;font-size:11px;text-align:left;line-height:16px;color:#285b49}.audio-file-size{font-size:9px;color:#7b8974;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.evidence-name,.evidence-state{display:block;width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10px;text-align:center}.evidence-state{margin:5px 0;color:#7b8974}.evidence-item .evidence-view{display:block;width:100%;padding:4px 0;font-size:10px;min-height:26px;background:#edf3e7}.evidence-selected{border:2px solid #285b49;padding:3px}
