<app-header title="{{crop ? '裁剪头像' : pageTitle}}" back="{{view !== 'profile'}}" bindback="back" />
<view class="page {{focusedPage ? 'focused-page' : ''}}"><block wx:if="{{crop}}"><view class="title">让头像刚刚好</view><view class="subtitle">拖动图片调整位置，圆形外的部分不会显示。</view><view class="crop-stage" catchtouchstart="cropStart" catchtouchmove="cropMove" catchtouchend="cropEnd" catchtouchcancel="cropEnd"><image src="{{cropPath}}" class="crop-image" style="width:{{cropDisplayW}}px;height:{{cropDisplayH}}px;left:{{110+cropX}}px;top:{{110+cropY}}px;transform:translate(-50%,-50%) rotate({{cropRotation}}deg)" /><view class="crop-circle" /></view><view class="value-row"><text>缩放</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropZoom' ? numberDrafts.cropZoom : cropZoom}}" data-key="cropZoom" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropZoom" /><text class="number-unit">×</text></view></view><slider min="1" max="3" step="0.01" value="{{cropZoom}}" bindchanging="cropZoom" bindchange="cropZoom" activeColor="#285b49" /><view class="row between rotation-label"><view class="value-row"><text>旋转</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropRotation' ? numberDrafts.cropRotation : cropRotation}}" data-key="cropRotation" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropRotation" /><text class="number-unit">°</text></view></view><button class="text-button reset-rotation" bindtap="resetCropRotation" disabled="{{cropRotation === 0}}">归零 0°</button></view><view class="choice-row"><button data-delta="-90" bindtap="rotate">向左旋转 90°</button><button data-delta="90" bindtap="rotate">向右旋转 90°</button></view><button class="primary wide spaced" bindtap="useCrop" loading="{{cropBusy}}" disabled="{{cropBusy}}">使用这个裁剪</button><button class="quiet wide spaced" bindtap="cancelCrop" disabled="{{cropBusy}}">取消裁剪</button></block>
<block wx:elif="{{view === 'profile'}}"><button class="wide" data-id="account" bindtap="menu"><image wx:if="{{communityAvatar}}" class="i" src="{{communityAvatar}}" />{{communityName ? communityName + ' · 社区账号' : '微信登录 / 注册社区账号'}}</button><view class="profile-head"><image class="avatar-large" src="{{avatar}}" mode="aspectFill" /><view><view class="profile-name">{{name}}</view><text class="pill">本机资料</text><button class="text-button edit-link" bindtap="edit">编辑本机资料</button></view></view><view class="stats"><view><text>{{observationCount}}</text><view>我的观察</view></view><view><text>{{speciesCount}}</text><view>已标注鸟名</view></view><view><text>{{favoriteCount}}</text><view>收藏记录</view></view></view><view class="tiny">鸟名按本人填写的名称去重，未作物种核验。示例不计入以上统计，可在历史中查看。</view><view class="profile-menu"><button wx:for="{{menu}}" wx:key="id" class="menu-row" data-id="{{item.id}}" bindtap="menu"><image class="i" src="/assets/icons/{{item.icon}}.png" /><text class="menu-label">{{item.name}}</text><text class="end"></text><image class="menu-arrow" src="/assets/icons/arrow.png" /></button></view><view class="note">社区账号可跨设备查看，手帐原件保存在本机。</view></block>
<block wx:elif="{{view === 'edit'}}"><view class="title">编辑个人资料</view><text class="label">显示名称</text><input value="{{draftName}}" bindinput="changeName" disabled="{{busy}}" /><text class="label">头像</text><view class="row avatar-editor"><image class="avatar-large" src="{{draftAvatar}}" mode="aspectFill" /><view class="stack"><button class="small-button" disabled="{{busy}}" bindtap="chooseFallback">上传自己的图片</button><button wx:if="{{nativeAvatar}}" class="quiet small-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarError" disabled="{{busy}}">使用系统头像选择</button></view></view><view class="tiny">上传后可移动、缩放、旋转；圆形预览就是显示范围。</view><view class="section-title">也可以选一个默认头像</view><view class="avatar-grid"><button wx:for="{{avatars}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseDefault" disabled="{{busy}}"><image src="/assets/avatars/{{item.id}}.png" /><text>{{item.name}}</text></button></view><button class="primary wide spaced" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存资料</button><button class="quiet wide spaced" bindtap="cancel" disabled="{{busy}}">取消修改</button></block>
<block wx:elif="{{view === 'history' || view === 'collection'}}"><view class="title">{{pageTitle}}</view><view class="subtitle">自己的记录可以一直保持私密。</view><view wx:for="{{shownRecords}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="openRecord"><image wx:if="{{!item.mediaKind || item.mediaKind === 'photo'}}" class="record-image" src="{{item.imagePath}}" mode="aspectFill" /><image wx:else class="record-image media-thumb" src="/assets/icons/{{item.mediaKind === 'video' ? 'video' : 'mic'}}.png" /><view class="record-copy"><view class="strong">{{item.birdName}}</view><view class="record-note">{{item.notes || '暂未填写观察笔记'}}</view><view class="tiny">{{item.sample ? '示例插画' : '私人记录'}} · {{item.timeLabel === '未知' ? '观察时间未知' : item.timeLabel}}</view></view><image class="i" src="/assets/icons/arrow.png" /></view><view wx:if="{{!shownRecords.length}}" class="empty">这里还没有记录。<view>保存的观察与自己的收藏会分别出现在这里。</view></view></block>
<block wx:elif="{{view === 'detail'}}"><image wx:if="{{!detail.mediaKind || detail.mediaKind === 'photo'}}" class="detail-photo" src="{{detail.imagePath}}" mode="aspectFit" data-id="{{detail.id}}" bindtap="preview" /><video wx:elif="{{detail.mediaKind === 'video'}}" class="detail-photo" src="{{detail.imagePath}}" controls /><button wx:else class="wide spaced" bindtap="playAudio">回听这段鸟鸣线索</button><view class="title spaced">{{detail.birdName}}</view><text class="pill">{{detail.sample ? '示例插画记录' : '私人原始记录'}} · 仅本机</text><view class="note">{{detail.notes || '没有填写观察笔记'}}</view><view class="metadata"><view><text>观察时间</text><text>{{detail.timeLabel}}</text></view><view><text>观察地点</text><text>{{detail.placeLabel}}</text></view><view><text>天气</text><text>未知</text></view><view><text>保存时间</text><text>{{detail.savedLabel}}</text></view></view><view class="tiny">{{detail.timeSource === 'manual' || detail.placeSource === 'manual' ? '观察日期、时刻或地点由本人填写。' : '尚未补充观察时间与地点。'}}</view><button class="wide spaced" bindtap="favorite">加入 / 移出我的收藏</button><view class="tiny spaced">这里显示保存时的观察记录。</view></block>
<block wx:elif="{{view === 'places'}}"><view class="title">地点收藏与打卡</view><view wx:for="{{savedPlaces}}" wx:key="name" class="card"><view class="strong">{{item.name}}</view><view class="muted">{{item.saved ? '已收藏' : ''}} {{item.checked ? '已打卡' : ''}} · 本机示例</view></view><view wx:if="{{!savedPlaces.length}}" class="empty">还没有地点活动。可在首页地图的地点卡片中体验。</view></block>
<block wx:elif="{{view === 'saved'}}"><view class="title">保存的他人内容</view><view class="subtitle">书签不计入本人观察的鸟种。</view><view wx:for="{{savedPosts}}" wx:key="id" class="card"><view class="strong">{{item.title}}</view><view class="tiny">讨论书签 · 示例</view></view><view wx:if="{{!savedPosts.length}}" class="empty">还没有书签。可在讨论帖子中点击保存。</view></block>
<block wx:elif="{{view === 'settings'}}"><view class="title">设置与缓存</view><view class="card"><view class="strong">本机空间</view><view class="muted">当前 storage 使用约 {{storageKB}} KB</view><view class="tiny spaced">不包含系统相册与所有持久媒体文件。</view></view><view class="note">清除小程序数据、更换 AppID 或设备可能让本机资料不可用。保存的图片与手帐不会自动上传或同步。</view><view class="card"><view class="strong">服务状态</view><view class="muted spaced">可在社区账号管理搜索、私信和书签权限。</view></view></block>
<view wx:if="{{error}}" class="note error">{{error}}</view></view>
<canvas id="avatar-export" type="2d" class="avatar-export" />
