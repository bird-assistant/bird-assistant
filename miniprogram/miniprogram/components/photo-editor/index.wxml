<view class="photo-editor"><button class="details-toggle" bindtap="toggle" aria-expanded="{{open}}"><view class="details-copy"><text class="photo-editor-text details-title">{{readonly ? '照片参数' : '摄影参数 · 可选'}}</text><text class="photo-editor-text details-note">{{embedded ? '已读取文件参数' : readonly ? '查看照片附带的信息' : '补充相机、镜头与拍摄设置'}}</text></view><view class="details-chevron {{open ? 'opened' : ''}}"/></button><view wx:if="{{open}}" class="details-fields"><view wx:if="{{embedded}}" class="details-file"><text class="photo-editor-text details-source">{{embedded.source}}</text><text class="photo-editor-text details-file-title">{{embedded.title}}</text><view wx:for="{{embedded.settings}}" wx:key="key" class="details-auto-row"><text class="photo-editor-text">{{item.label}}</text><text class="photo-editor-text">{{item.value}}</text></view></view><text wx:if="{{metadataMessage}}" class="photo-editor-text details-policy">{{metadataMessage}}</text><block wx:if="{{!readonly}}"><text class="photo-editor-text details-policy">仅填写你知道的参数，随帖子公开并标为「作者填写」。文件读取与作者填写分别展示。</text><view wx:for="{{fields}}" wx:key="key" class="details-field"><text class="photo-editor-text details-label">{{item.label}}</text><input disabled="{{disabled}}" class="details-input" value="{{value[item.key] || ''}}" data-key="{{item.key}}" maxlength="80" bindinput="change" placeholder="{{item.placeholder}}"/></view></block></view></view>
