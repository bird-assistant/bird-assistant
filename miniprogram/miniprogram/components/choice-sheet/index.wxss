:host{font-size:14px;color:#294d3e}.choice-shade{position:fixed;inset:0;background:#203b3059;z-index:400}.choice-panel{position:fixed;left:0;right:0;bottom:0;margin:auto;max-width:560px;border-radius:24px 24px 0 0;background:#fafbf5;z-index:401;padding:12px 18px 0;box-sizing:border-box;box-shadow:0 -12px 40px #203b301a;animation:choice-arrive .26s cubic-bezier(.2,.75,.25,1)}.choice-handle{width:32px;height:4px;border-radius:4px;background:#cfdcc7;margin:0 auto 12px}.choice-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;font-size:18px;font-weight:600}.choice-close{display:flex;align-items:center;justify-content:center;width:38px;height:38px;min-height:38px;margin:0;padding:0;border:0;border-radius:50%;background:#edf2e7}.choice-close-icon{width:18px;height:18px}.choice-close::after,.choice-option::after{border:0}.choice-option{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;width:100%;min-height:54px;margin:0;padding:12px 14px;background:transparent;border:0;border-radius:12px;line-height:1.5;color:#586d53;font-size:14px;text-align:left}.choice-label{flex:1;min-width:0}.choice-selected{color:#285b49;background:#e8f0df;font-weight:600}.choice-radio{box-sizing:border-box;width:18px;height:18px;border:1px solid #a5b99a;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;margin-left:12px}.choice-radio-dot{width:10px;height:10px;border-radius:50%;background:#285b49}.choice-safe{height:calc(18px + env(safe-area-inset-bottom))}@keyframes choice-arrive{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.choice-panel{animation:none}}

.choice-close{box-sizing:border-box;flex:0 0 38px;min-width:38px;max-width:38px;min-height:38px;max-height:38px;aspect-ratio:1;line-height:1}.choice-radio{flex:0 0 18px;min-width:18px;max-width:18px;min-height:18px;max-height:18px}
