<view class="page hub">
  <view wx:if="{{error}}" class="note error">{{error}} <button wx:if="{{screen !== 'publish'}}" class="text-button" bindtap="load">重新加载</button></view>
  <view wx:if="{{notice}}" class="note">{{notice}}</view>
  <block wx:if="{{screen === 'publish'}}">
    <image wx:if="{{photo}}" class="photo" src="{{photo}}" mode="aspectFit"/>
    <view wx:if="{{draft}}" class="card"><text class="strong">{{draft.speciesName}}</text><view>{{draft.date || '日期未知'}} {{draft.time}} · {{draft.place || '地点未填写'}}</view><view>{{draft.device}}</view>
      <input placeholder="搜索或更正鸟种" data-field="keyword" bindinput="field"/><button bindtap="findSpecies">查找鸟种</button>
      <button wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" bindtap="pickSpecies">{{item.name || item.english || item.scientific}}</button>
      <button bindtap="choosePoint">{{draft.point ? '更改地图位置' : '在地图上选择观察地点'}}</button></view>
    <button wx:else bindtap="attach">选择讨论照片</button>
    <input placeholder="标题" maxlength="100" value="{{title}}" data-field="title" bindinput="field"/>
    <textarea placeholder="你观察到了什么？" maxlength="2000" value="{{body}}" data-field="body" bindinput="field"/>
    <view class="settings"><button data-field="post" bindtap="flag">{{post ? '☑' : '☐'}} 发布到讨论</button><button wx:if="{{draft}}" data-field="map" bindtap="flag">{{map ? '☑' : '☐'}} 添加地图鸟讯</button>
    <button data-field="anonymous" bindtap="flag">{{anonymous ? '☑' : '☐'}} 匿名署名</button><button wx:if="{{photo}}" data-field="sharePhoto" bindtap="flag">{{sharePhoto ? '☑' : '☐'}} 展示照片</button>
    <button wx:if="{{draft}}" data-field="shareDate" bindtap="flag">{{shareDate ? '☑' : '☐'}} 展示日期</button><button wx:if="{{draft}}" data-field="shareCamera" bindtap="flag">{{shareCamera ? '☑' : '☐'}} 展示拍摄设备与参数</button></view>
    <button wx:if="{{draft}}" disabled="{{busy}}" data-mode="private" bindtap="prepare">只保存为云端私人观察</button><view wx:if="{{draft}}" class="tiny">生成预览会把这张照片及所填观察信息同步至你的私人记录。地图公开位置约至十公里。</view>
    <button class="primary wide" disabled="{{busy}}" bindtap="prepare">{{draft ? '同步私人观察并预览' : '预览公开内容'}}</button>
    <view wx:if="{{preview}}" class="card"><view wx:for="{{previewLines}}" wx:key="*this">{{item}}</view><button class="primary wide" disabled="{{busy}}" bindtap="submit">确认提交审核</button></view>
  </block>
  <block wx:elif="{{screen === 'growth'}}"><view class="title">{{record.points || 0}} 积分</view><view class="card">私人观察 {{record.observations || 0}} · 公开贡献 {{record.contributions || 0}} · 回复 {{record.replies || 0}}</view><view wx:for="{{record.badges}}" wx:key="*this" class="pill">{{item}}</view></block>
  <block wx:elif="{{screen === 'record'}}"><block wx:if="{{record}}"><view class="title">{{record.title || record.speciesName}}</view><view class="muted">{{record.source}} {{record.publicName}} · {{record.date || '日期未知'}}</view>
    <image wx:if="{{photo}}" src="{{photo}}" class="photo" mode="aspectFit"/><view>{{record.body || record.note}}</view><view>{{record.placeName || record.place}}</view><view wx:if="{{record.camera}}">{{record.camera.device}} {{record.camera.make}} {{record.camera.model}} {{record.camera.focal}} {{record.camera.aperture}} {{record.camera.exposure}} {{record.camera.iso}}</view>
    <view wx:if="{{record.visibility === 'private' && record.channels.length}}" class="card"><view class="strong">这次观察的公开进度</view>
    <view wx:for="{{record.channels}}" wx:key="id">{{item.channel === 'map' ? '地图' : '讨论'}} · {{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已公开' : item.status === 'withdrawn' ? '已撤回' : '审核未通过'}}<view wx:if="{{item.reason}}">审核反馈 · {{item.reason}}</view><button wx:if="{{item.status === 'approved'}}" data-screen="record" data-id="{{item.id}}" bindtap="go">查看公开内容</button></view></view>
    <button wx:if="{{record.visibility === 'private'}}" bindtap="shareExisting">分享到讨论或地图</button><button wx:if="{{record.related}}" data-id="{{record.related.id}}" data-screen="record" bindtap="go">{{record.related.channel === 'map' ? '查看关联地图鸟讯' : '查看原讨论'}}</button><button wx:if="{{record.displayLocation}}" bindtap="viewMap">在地图上查看</button><button wx:if="{{record.speciesId}}" data-id="{{record.speciesId}}" data-screen="species" bindtap="go">查看鸟种及出现地点</button>
    <view wx:if="{{record.sourcePhoto}}" class="card">照片缩略图 · {{record.sourcePhoto.credit}} · {{record.sourcePhoto.license}}<button bindtap="copyCredit" data-url="{{record.sourcePhoto.sourceUrl}}">照片出处</button><button bindtap="copyCredit" data-url="{{record.sourcePhoto.licenseUrl}}">照片许可</button></view>
    <view wx:if="{{record.sourceUrl}}" class="card">{{record.source}} · {{record.attribution}} · {{record.licence}}<view>{{record.precisionLabel}}</view><button wx:if="{{record.licenceUrl}}" bindtap="copyCredit" data-url="{{record.licenceUrl}}">记录许可</button><button data-op="source" bindtap="action">复制原始记录链接</button><button open-type="share">分享给微信好友</button><button bindtap="discussExternal">在羽迹发起讨论</button></view><button wx:if="{{record.sourceRecord}}" data-screen="record" data-id="{{record.sourceRecord}}" bindtap="go">查看引用的外部鸟讯</button>
    <block wx:if="{{record.visibility !== 'private'}}"><view class="settings"><button data-op="like" bindtap="action">赞 {{record.likes}}</button><button data-op="bookmark" bindtap="action">{{record.bookmarked ? '取消收藏' : '收藏'}}</button><button data-op="report" data-id="{{id}}" bindtap="action">举报</button><button wx:if="{{record.memberId && record.memberId !== self}}" data-screen="member" data-id="{{record.memberId}}" bindtap="go">{{record.publicName}}的主页</button></view>
    <view class="strong">讨论</view><view wx:for="{{record.replies}}" wx:key="id" class="card">{{item.body}}<button wx:if="{{item.species}}" data-screen="species" data-id="{{item.species}}" bindtap="go">查看建议鸟种</button><button wx:if="{{record.ownedSighting && item.species}}" data-id="{{item.id}}" data-op="adopt" bindtap="action">采纳到我的观察</button><button wx:if="{{item.memberId !== self}}" data-screen="member" data-id="{{item.memberId}}" bindtap="go">{{item.publicName}}的主页</button></view>
    <input placeholder="搜索鉴定建议的鸟种（可选）" data-field="keyword" bindinput="field"/><button bindtap="findSpecies">选择建议鸟种 {{selectedSpecies}}</button><button wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" bindtap="pickSpecies">{{item.name || item.scientific}}</button>
    <textarea value="{{body}}" data-field="body" bindinput="field" placeholder="写下回复或鉴定理由"/><button disabled="{{busy}}" data-op="reply" bindtap="action">提交回复</button></block></block></block>
  <block wx:elif="{{screen === 'chat'}}"><view class="settings"><button data-op="block" bindtap="action">屏蔽</button><button data-op="unblock" bindtap="action">取消屏蔽</button><button bindtap="load">刷新</button></view>
    <view wx:for="{{items}}" wx:key="id" class="card"><text class="tiny">{{item.sender === self ? '我' : '对方'}}</text><view>{{item.body}}</view><button wx:if="{{item.sender !== self}}" data-op="report" data-id="{{item.id}}" bindtap="action">举报</button></view>
    <textarea data-field="body" value="{{body}}" bindinput="field" placeholder="写消息"/><button class="primary wide" disabled="{{busy}}" data-op="send" bindtap="action">发送</button></block>
  <block wx:else>
    <block wx:if="{{screen === 'library'}}"><input placeholder="中文名、英文名或学名" data-field="keyword" bindinput="field" bindconfirm="load"/><button bindtap="load">搜索资料库</button><button bindtap="compareSpecies">并排对比鸟种</button><view wx:if="{{!keyword}}" class="featured"><button wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" data-screen="species" bindtap="go"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><text>{{item.name || item.english}}</text><view wx:if="{{item.photo}}" class="tiny">{{item.photo.credit}} · {{item.photo.license}}</view></button></view><button wx:if="{{!keyword}}" bindtap="sparrowPair">树麻雀和家麻雀怎么分？</button></block>
    <block wx:if="{{screen === 'species' && record}}"><view class="title">{{record.name || record.english}}</view><view>{{record.scientific}}</view><view class="settings"><button data-tab="identity" bindtap="changeTab">辨认</button><button data-tab="places" bindtap="changeTab">出现地点 {{placeCount}}</button><button data-tab="posts" bindtap="changeTab">讨论</button></view>
    <view wx:if="{{tab === 'identity'}}" class="card"><guide-card bird-id="{{id}}" profile="{{record}}"/><button bindtap="compareSpecies">与其他鸟种对比</button><view>{{record.english}} · {{record.family}}</view><view class="tiny">{{record.source}}</view><view>{{placeCount}} 个公开区域，共 {{recordCount}} 条鸟讯</view></view>
    <block wx:elif="{{tab === 'places'}}"><view wx:if="{{!placeCount}}" class="note">暂无获准公开的地点。</view><button wx:for="{{places}}" wx:key="id" data-id="{{item.id}}" bindtap="speciesMap">{{item.placeName}} · {{item.records}} 条<view class="tiny">{{item.latest || '日期未知'}} · 在地图查看</view></button></block>
    <block wx:else><view wx:if="{{!speciesPosts.length}}" class="note">暂无该鸟种的公开讨论。</view><button wx:for="{{speciesPosts}}" wx:key="id" data-screen="record" data-id="{{item.id}}" bindtap="go">{{item.title}} · {{item.publicName}}</button></block></block>
    <button wx:if="{{screen === 'feed'}}" data-screen="publish" data-id="compose" bindtap="go">发布讨论</button>
    <view wx:if="{{screen !== 'species' && !items.length && !busy && !error}}" class="note">暂无记录</view>
    <view wx:for="{{items}}" wx:if="{{screen !== 'species'}}" wx:key="id" class="card"><button class="rowbtn" data-id="{{screen === 'inbox' ? item.peer : item.id}}" data-screen="{{screen === 'library' ? 'species' : screen === 'inbox' ? 'chat' : 'record'}}" disabled="{{screen === 'mine' && item.status !== 'approved'}}" bindtap="go">{{item.title || item.name || item.english || item.scientific || item.body || item.place || '私人观察'}}<view class="tiny">{{item.source || ''}} {{item.date || item.created || ''}} {{item.placeName || ''}}</view></button>
    <block wx:if="{{screen === 'mine'}}"><text>{{item.channel === 'map' ? '地图' : '讨论'}} · {{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已公开' : item.status === 'withdrawn' ? '已撤回' : '审核未通过'}}</text><view wx:if="{{item.reason}}">审核反馈 · {{item.reason}}</view><button wx:if="{{item.ownedSighting}}" data-screen="record" data-id="{{item.ownedSighting}}" bindtap="go">查看原观察</button><button wx:if="{{item.status !== 'withdrawn'}}" data-op="withdraw" data-id="{{item.id}}" bindtap="action">撤回</button></block>
    <button wx:if="{{screen === 'bookmarks'}}" data-op="unbookmark" data-id="{{item.id}}" bindtap="action">取消收藏</button></view>
    <view wx:if="{{screen === 'external'}}" class="settings"><button disabled="{{busy || externalPage === 0}}" data-direction="-1" bindtap="externalPage">上一页</button><text>第 {{externalPage + 1}} 页</text><button disabled="{{busy || !externalNext}}" data-direction="1" bindtap="externalPage">下一页</button></view>
  </block>
</view>
