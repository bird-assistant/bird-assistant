.social {padding-bottom:calc(48rpx + env(safe-area-inset-bottom));overflow-wrap:anywhere}
.social .card,.social .section-title,.social>.primary {margin:28rpx 0 16rpx}
.social .label {margin:24rpx 0 10rpx;font-weight:600}
.social button {margin:10rpx 0;padding:8rpx 20rpx;font-size:28rpx}
.social .line,.social .choices,.identity {display:flex;gap:14rpx;align-items:center}
.social .line {justify-content:space-between}.social .line input {flex:1;min-width:0}
.choices {flex-wrap:wrap}.social .picked,.unread {background:#285b49;color:white;border-radius:12rpx}
.unread {padding:2rpx 10rpx;font-size:22rpx}.identity image {width:108rpx;height:108rpx;flex:none;border-radius:50%}
.avatar-choice image {width:56rpx;height:56rpx;display:block}.social .avatar-choice {padding:8rpx}
.social textarea {box-sizing:border-box;width:100%;height:130rpx;background:#fff;padding:14rpx}
.social .conversation {text-align:left}.excerpt {display:block;color:#536b5f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bubble {background:white;padding:18rpx 24rpx;margin:14rpx 10% 14rpx 0;border-radius:24rpx;white-space:pre-wrap}
.bubble.own {background:#dcebdd;margin:14rpx 0 14rpx 10%}.bubble button {display:block;margin:4rpx 0 0 auto;font-size:21rpx}
.composer {position:sticky;bottom:0;background:#fafbf5;padding:12rpx 0}.social .composer textarea {height:86rpx}

.social{padding-bottom:calc(24px + env(safe-area-inset-bottom))}.social .conversation{display:block;width:100%;padding:14px;border:1px solid #dfe7d8;border-radius:14px;background:#fffef9;margin:10px 0;line-height:1.6}.social .conversation-with-avatar{display:flex;align-items:center;gap:12px}.conversation-copy{flex:1;min-width:0}.conversation-title{display:flex;align-items:center;justify-content:space-between;gap:12px}.conversation-title>text:first-child{min-width:0;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.conversation-title .unread{flex:none;min-width:20px;text-align:center;font-size:10px;line-height:20px;padding:0 5px;border-radius:10px}.excerpt{font-size:12px;margin:4px 0}.social .tiny{color:#829077;font-size:10px}.notification-tools{display:flex;gap:10px;margin:18px 0}.notification-tools button{flex:1;width:0;min-height:72px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:13px;border:1px solid #dce5d7;background:#eef3e7;font-size:13px}.notification-tools image{width:19px;height:19px;flex:none}.notification-count{font-size:11px;background:#fffef9;padding:1px 7px;border-radius:9px}.social-empty{text-align:center;padding:26px 16px;border:1px dashed #dae4d1;border-radius:14px;background:#f6f8f0;color:#7c8d73;font-size:13px;margin:12px 0}.social-empty>image{display:block;width:28px;height:28px;margin:0 auto 10px;opacity:.6}.social-empty>text{display:block;font-size:11px;line-height:1.8;margin-top:5px}.compact-social-empty{padding:18px}.social .group-row{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:14px;border:1px solid #dfe7d8;background:#fffef9;border-radius:14px}.group-symbol{width:24px;height:24px;flex:none}.group-label{flex:1;min-width:0;overflow-wrap:anywhere}.social .composer{display:flex;align-items:flex-end;gap:10px;bottom:0;padding:12px 0 calc(12px + env(safe-area-inset-bottom));border-top:1px solid #dfe7d8;z-index:2}.social .composer textarea{flex:1;min-width:0;min-height:44px;max-height:128px;height:auto;padding:11px 12px;font-size:14px;line-height:1.7}.social .composer button{flex:none;min-width:62px;min-height:44px;margin:0;font-size:14px}.bubble{border:1px solid #e0e8d9;line-height:1.8;overflow-wrap:anywhere}.bubble.own{border-color:#d0dfc6}.social .line>button{flex:none}.identity>view{min-width:0}.social .identity .title{font-size:23px;overflow-wrap:anywhere}

.social-tabs{display:flex;gap:4px;padding:4px;margin:18px 0;border:1px solid #dce5d2;border-radius:14px;background:#edf2e5}.social .social-tabs button{flex:1;width:0;min-width:0;min-height:38px;margin:0;padding:8px 3px;border-radius:10px;background:transparent;font-size:12px;color:#7c8d70;transition:background .22s,color .22s,box-shadow .22s}.social .social-tabs .social-tab-on{background:#fffef9;color:#285b49;font-weight:600;box-shadow:0 2px 9px #285b4910}.social-section-copy{font-size:19px;font-weight:600;line-height:1.5;color:#2d5141;margin:18px 0 12px}.social-section-copy text{display:block;font-size:11px;font-weight:400;color:#87977a;line-height:1.8;margin-top:7px}.friend-card{padding:14px;border:1px solid #dce5d4;border-radius:16px;background:#fffef9;margin:12px 0}.friend-identity{display:flex;align-items:center;gap:11px;min-height:46px}.friend-identity>view{flex:1;min-width:0}.friend-name,.friend-handle{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.friend-name{font-size:15px;font-weight:600;color:#315641}.friend-handle{font-size:11px;color:#8b9a7e;margin-top:3px}.friend-state{font-size:10px;border-radius:8px;padding:3px 7px;background:#edf3e4;color:#779163}.friend-actions{display:flex;align-items:center;gap:9px;margin-top:13px;padding-top:11px;border-top:1px solid #edf1e5}.social .friend-actions button{flex:1;width:0;min-height:36px;margin:0;padding:8px 5px;background:#edf3e6;font-size:12px}.social .friend-actions .friend-accept{background:#285b49;color:#fffef9}.friend-actions>text{flex:1;font-size:11px;color:#8b997f}.social .friend-message{display:flex;align-items:center;justify-content:center;flex:none;width:38px;height:38px;min-height:38px;margin:0;padding:8px;background:#edf3e6;border-radius:12px}.friend-message image{width:20px;height:20px}.group-create{padding:12px;border-radius:14px;background:#edf3e7;border:1px solid #dce6d2}.social .group-create input{background:#fffef9;margin:0;font-size:13px}.social .group-create button{margin:0;background:#285b49;color:#fffef9;font-size:12px}.conversation-context{display:flex;align-items:center;gap:7px;padding:9px 12px;background:#eef3e7;border-radius:10px;color:#819274;font-size:10px;margin:4px 0 12px}.conversation-context image{width:15px;height:15px}.social .bubble{box-shadow:0 3px 10px #285b4905}.social .bubble .tiny{font-size:9px;margin-bottom:5px}.social .bubble.own{background:linear-gradient(130deg,#e1ecd7,#d6e6cf)}@media(prefers-reduced-motion:reduce){.social .social-tabs button{transition:none}}
