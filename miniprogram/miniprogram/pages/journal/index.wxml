<app-header title="{{headerTitle}}" back="{{view !== 'home'}}" bindback="back" />
<view wx:if="{{view === 'home'}}" class="page journal-home"><view class="eyebrow">FIELD NOTES / 出行手帐</view><view class="title">把发现，拼成回忆</view><view class="subtitle">照片与文字之间，留一点自然的呼吸。</view>
  <view class="journal-hero"><view class="mini-cover"><image src="/assets/samples/field-1.png" mode="aspectFill" /><view class="mini-label">FIELD NOTES<view>沿着鸟鸣</view></view></view><view class="hero-copy"><text class="pill">为你整理 · 示例</text><view class="hero-title">湖畔的一页</view><view class="muted">选择 1–2 张插画，试试留白与双图叙事。</view><button class="small-button spaced" data-count="2" bindtap="sample">先试双图构图</button></view></view>
  <button class="primary wide" bindtap="newJournal">＋ 新建手帐</button><view class="resume-session"><button wx:if="{{doc}}" class="wide spaced" bindtap="resume">继续编辑 · {{doc.title}}</button><view wx:if="{{doc}}" class="save-feedback">{{saveStatus || (dirty ? '更改待保存' : '已自动保存到本机')}}</view></view>
  <view class="row between section-title"><text>我的手帐</text><text class="muted">{{drafts.length}} 份</text></view><view wx:if="{{!drafts.length}}" class="empty">还没有手帐。从相册、观察或自己的收藏开始。</view>
  <view class="journal-grid"><view wx:for="{{drafts}}" wx:key="id" class="journal-card" data-id="{{item.id}}" bindtap="openDraft"><image src="{{item.cover}}" mode="aspectFill" /><view class="draft-title">{{item.title}}</view><view class="muted">{{item.ratio}} · 自动保存 · 本机</view><text class="text-link">继续编辑 →</text></view></view><view class="note">手帐保存在本机。Qwen 写作需团队网关配置，生成建议后由你决定是否应用。</view>
</view>
<view wx:elif="{{view === 'picker'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><view class="title">挑选这次的片段</view><view class="subtitle">先选素材，再决定怎样讲述。优先选 1–2 张，让每次发现都有自己的留白；也支持组图。</view><view class="segments journal-source"><button class="{{source === 'album' ? 'on' : ''}}" data-id="album" bindtap="source">手机相册</button><button class="{{source === 'observations' ? 'on' : ''}}" data-id="observations" bindtap="source">我的观察</button><button class="{{source === 'collection' ? 'on' : ''}}" data-id="collection" bindtap="source">我的收藏</button><button class="{{source === 'sample' ? 'on' : ''}}" data-id="sample" bindtap="source">示例素材</button></view>
  <view class="date-fields"><picker mode="date" value="{{from}}" data-key="from" bindchange="date"><view class="label">开始日期</view><view class="select-field">{{from || '不限日期'}}<view class="chevron" /></view></picker><picker mode="date" value="{{to}}" data-key="to" bindchange="date"><view class="label">结束日期</view><view class="select-field">{{to || '不限日期'}}<view class="chevron" /></view></picker></view><view class="row between"><button class="check-option" aria-pressed="{{unknown}}" bindtap="unknown"><text class="check-square">{{unknown ? '✓' : ''}}</text>也显示日期未知的素材</button><button wx:if="{{from || to}}" class="text-button" bindtap="clearDates">清除日期</button></view><view wx:if="{{from && to && from > to}}" class="note error">开始日期不能晚于结束日期。</view>
  <button wx:if="{{source === 'album'}}" class="wide spaced" bindtap="importPhotos">＋ 从设备选择照片</button><view class="asset-grid"><button wx:for="{{assets}}" wx:key="id" class="asset {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="chooseAsset"><image src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" bindload="assetLoaded" style="height:{{assetImageHeight}}px" /><view class="tick">{{item.selected ? '✓' : '＋'}}</view><view class="strong">{{item.label}}</view><view class="tiny">{{item.date || '日期未知'}}{{item.sample ? ' · 插画' : ''}}</view></button></view><view wx:if="{{!assets.length}}" class="empty">暂无照片。可导入相册照片，<view>或切换示例素材。</view></view><view class="row between section-title"><text>已选 {{chosen}}/6</text><button class="text-button" bindtap="clearSelection">清空选择</button></view><view class="picked-list"><view wx:for="{{picked}}" wx:key="id" class="picked-row"><text>{{index+1}}. {{item.label}}</text><button class="reorder" data-id="{{item.id}}" data-delta="-1" bindtap="reorder" aria-label="前移 {{item.label}}"><image class="i" src="/assets/icons/back.png" style="transform:rotate(90deg)" /></button><button class="reorder" data-id="{{item.id}}" data-delta="1" bindtap="reorder" aria-label="后移 {{item.label}}"><image class="i" src="/assets/icons/back.png" style="transform:rotate(-90deg)" /></button></view></view><button class="primary wide" disabled="{{!chosen || (from && to && from > to)}}" bindtap="next">下一步：风格与比例</button><view class="tiny spaced">保留原件；不会为未知日期补写导入时间。</view>
</view>
<view wx:elif="{{view === 'setup'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><text class="pill">本地排版 · 原图保留</text><view class="title spaced">这一页，什么模样？</view><scroll-view scroll-x class="film"><image wx:for="{{assets}}" wx:if="{{item.selected}}" wx:key="id" src="{{item.src}}" mode="aspectFill" /></scroll-view><text class="label">手帐标题</text><input value="{{title}}" bindinput="title" /><text class="label">起始风格</text><view class="choice-row"><button wx:for="{{styles}}" wx:key="id" class="{{style === item.id ? 'active' : ''}}" data-key="style" data-id="{{item.id}}" bindtap="setting">{{item.name}}</button></view><text class="label">画布比例</text><view class="choice-row"><button wx:for="{{ratios}}" wx:key="*this" class="{{ratio === item ? 'active' : ''}}" data-key="ratio" data-id="{{item}}" bindtap="setting">{{item}}</button></view><picker range="{{periods}}" value="{{period}}" bindchange="period"><view class="label">整理类型（仅标记草稿）</view><view class="select-field">{{periods[period]}}<view class="chevron" /></view></picker><button class="check-option" aria-pressed="{{includeNotes}}" bindtap="notes"><text class="check-square">{{includeNotes ? '✓' : ''}}</text>将所选观察的备注加入初稿</button><view class="note">三种风格是起点，画布里的图片、文字和装饰都能调整，也可以更换构图。</view><button class="primary wide" bindtap="generate">生成可编辑初稿</button></view>
<view wx:elif="{{view === 'editor'}}" class="editor-page" style="height:{{editorHeight}}px">
  <view class="stage-sticky"><view class="editor-toolbar"><button class="tool" disabled="{{!canUndo}}" bindtap="undo" aria-label="撤销"><image class="i" src="/assets/icons/undo.png" /></button><button class="tool" disabled="{{!canRedo}}" bindtap="redo" aria-label="重做"><image class="i" src="/assets/icons/redo.png" /></button><text class="toolbar-status">{{saveStatus || (dirty ? '更改待保存' : '已自动保存')}} · {{doc.ratio}}</text><button class="text-button" bindtap="chooseTemplate">选择版式</button><button class="save-small" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存</button></view>
    <view class="canvas-viewport" bindtap="background" style="height:{{stageHeight}}px"><view class="journal-paper" style="margin-left:{{paperLeft}}px;transform-origin:top left;width:{{stageWidth}}px;height:{{docHeight}}px;background:{{doc.background}};transform:translateY(-{{focusY}}px) scale({{paperScale}})">
      <image wx:if="{{paperSource}}" class="paper-texture" src="{{paperSource}}" mode="scaleToFill" style="width:{{stageWidth}}px;height:{{1200 * scale}}px" />
      <view wx:for="{{renderElements}}" wx:key="id" class="journal-element {{item.id === selectedId ? 'element-selected' : ''}} {{item.type === 'photo' ? 'photo-element' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%;width:{{item.width}}%;height:{{item.height}}%;transform:rotate({{item.rotation}}deg);color:{{item.color}}" data-id="{{item.id}}" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd" catchtap="select">
        <view wx:if="{{item.type === 'photo'}}" class="photo-clip"><image src="{{item.src}}" mode="scaleToFill" class="element-photo" data-id="{{item.id}}" bindload="imageLoaded" style="position:absolute;width:{{item.imageW}}px;height:{{item.imageH}}px;left:{{item.imageX}}px;top:{{item.imageY}}px" /></view>
        <view wx:elif="{{item.type === 'text'}}" class="element-text {{item.font}}"><text wx:for="{{item.rows}}" wx:for-item="line" wx:key="index" class="text-line" style="top:{{line.y}}px;font-size:{{line.size}}px;font-weight:{{line.bold ? '600' : '400'}}">{{line.text}}</text></view>
        <view wx:elif="{{item.type === 'tape'}}" class="tape-decoration" style="background:{{item.color}}" />
        <image wx:else class="element-decoration" src="/assets/decorations/{{item.type}}.png" />
        <view wx:if="{{item.id === selectedId}}" class="selection-frame" /><view wx:if="{{item.id === selectedId}}" class="width-handle {{item.type !== 'text' ? 'size-handle' : ''}}" data-id="{{item.id}}" data-resize="yes" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd" />
      </view>
    </view><button class="editor-overview" catchtap="toggleOverview" aria-label="查看全页或聚焦元素"><image class="i" src="/assets/icons/scan.png" /></button></view><view class="stage-caption">{{backgroundSelected ? '已选：背景 · 下方选择纸色' : selectedName ? '已选：'+selectedName+' · 可拖动或调整大小' : '点选画布元素或背景；重叠时可打开图层'}}</view>
  </view>
  <scroll-view class="editor-controls" scroll-y bindscroll="onEditorScroll" style="height:{{controlsHeight}}px"><view class="editor-control-body"><view class="choice-row"><button bindtap="addPhoto">＋ 图片</button><button bindtap="addText">＋ 文字</button><button class="ai-button" bindtap="openAi">✧ AI 写作</button></view><view class="choice-row"><button bindtap="background">背景</button><button bindtap="layoutRatio">纸张比例</button><button bindtap="chooseTemplate">选择版式</button></view><view class="composition-summary"><view><text class="composition-name">{{composition}}</text><text class="muted">{{doc.ratio}} · 先预览再选版式，支持撤销</text></view><button class="secondary small-button" bindtap="changeStyle">更换风格</button></view><view class="selection-summary"><text class="selection-name">{{selectedName || '点选画布元素'}}</text><button class="secondary small-button" bindtap="openLayers">图层 · {{labels.length}}</button></view>
    <view wx:if="{{backgroundSelected}}" class="element-editor background-editor"><view class="strong">纸张与纹理</view><view class="paper-options"><button wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" bindtap="paper" class="{{(doc.paper || 'plain') === item.id ? 'active' : ''}}" aria-pressed="{{(doc.paper || 'plain') === item.id}}">{{item.name}}</button></view><view class="label">纸色</view><view class="paper-colors"><button wx:for="{{paperColors}}" wx:key="*this" data-color="{{item}}" bindtap="backgroundColor" aria-label="选择纸色 {{item}}" aria-pressed="{{doc.background === item}}" class="{{doc.background === item ? 'color-current' : ''}}"><view style="background:{{item}}" /><text>{{doc.background === item ? '✓' : '选择'}}</text></button></view></view><view wx:if="{{selected}}" class="element-editor"><view class="row between"><text class="strong">{{selected.type === 'photo' ? '图片设置' : selected.type === 'text' ? '文字设置' : '装饰设置'}}</text><button class="danger-text" bindtap="remove">删除元素</button></view>
      <block wx:if="{{selected.type === 'text'}}"><view class="text-content-fields"><text class="label">标题</text><input value="{{selected.title}}" data-key="title" bindinput="text" bindblur="endTextEdit" placeholder="可留空，与正文属于同一文本框" /><text class="label">正文</text><textarea auto-height value="{{selected.text}}" data-key="text" bindinput="text" bindblur="endTextEdit" maxlength="-1" /><button class="ai-button wide text-ai-action" bindtap="openAi">✧ 为这个文本框生成建议</button></view><view class="value-row"><text>文字大小</text><view class="number-field"><input class="number-input" type="number" maxlength="3" value="{{numberEditing === 'fontSize' ? numberDrafts.fontSize : selected.fontSize}}" data-key="fontSize" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="fontSize" /><text class="number-unit">px</text></view></view><slider min="12" max="64" value="{{selected.fontSize}}" data-key="fontSize" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /></block>
      <view wx:if="{{selected.type === 'photo'}}" class="ratio-locks"><text class="label">画框比例</text><view class="lock-options"><button wx:for="{{ratioLocks}}" wx:key="id" class="{{ratioMode === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="lockRatio" aria-pressed="{{ratioMode === item.id}}">{{item.name}}</button></view></view><view wx:if="{{selected.type !== 'photo' && selected.type !== 'text'}}" class="ornament-lock"><button class="{{selected.ornamentRatioLocked ? 'active' : 'quiet'}} wide" bindtap="toggleOrnamentRatio" aria-pressed="{{selected.ornamentRatioLocked}}">{{selected.ornamentRatioLocked ? '原始比例已锁定 · 点击解锁' : '锁定装饰原始比例'}}</button></view><view class="value-row"><text>宽度</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'w' ? numberDrafts.w : pixels.w}}" data-key="w" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="图片或文字宽度，整数像素" /><text class="number-unit">px</text></view></view><slider min="{{maxWidth < 60 ? maxWidth : 60}}" max="{{maxWidth}}" value="{{selected.w}}" data-key="w" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" />
      <block wx:if="{{selected.type === 'photo'}}"><view class="value-row"><text>图片高度</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'h' ? numberDrafts.h : pixels.h}}" data-key="h" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="图片高度，整数像素" /><text class="number-unit">px</text></view></view><slider min="{{maxHeight < 60 ? maxHeight : 60}}" max="{{maxHeight}}" value="{{selected.h}}" data-key="h" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /><text class="label">画面如何适配画框</text><view class="choice-row"><button class="secondary {{selected.photoFit !== 'stretch' ? 'active' : ''}}" data-id="cover" bindtap="photoFit">裁剪填充</button><button class="secondary {{selected.photoFit === 'stretch' ? 'active' : ''}}" data-id="stretch" bindtap="photoFit">拉伸画面</button></view><view class="tiny crop-description">{{selected.photoFit === 'stretch' ? '宽高分别拉伸，可压扁或拉长画面；原图文件保留。' : '保持鸟体比例，调整画框会改变可见区域。'}}</view><button class="secondary wide crop-open" bindtap="openCrop">调整裁剪与取景</button></block>
      <view class="row between rotation-label"><view class="value-row"><text>旋转</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'rotation' ? numberDrafts.rotation : selected.rotation}}" data-key="rotation" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="rotation" /><text class="number-unit">°</text></view></view><button class="text-button reset-rotation" bindtap="resetRotation" disabled="{{selected.rotation === 0}}">归零 0°</button></view><slider min="-180" max="180" value="{{selected.rotation}}" data-key="rotation" step="0.01" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /><view class="choice-row"><button data-delta="-1" bindtap="layer">下移一层</button><button data-delta="1" bindtap="layer">上移一层</button></view>
    </view>
    <text class="label">添加装饰</text><view class="decoration-grid"><button wx:for="{{decorations}}" wx:key="id" data-id="{{item.id}}" bindtap="addDecoration"><image wx:if="{{item.id !== 'tape'}}" src="/assets/decorations/{{item.id}}.png" /><view wx:else class="tape-mini" /><text>{{item.name}}</text></button></view><button class="quiet wide spaced" loading="{{exporting}}" disabled="{{busy || exporting}}" bindtap="export">导出成品图</button><button wx:if="{{exportPath}}" class="primary wide spaced" bindtap="saveExport">保存成品到手机相册</button>
  </view></scroll-view>
</view>
<view wx:if="{{error}}" class="note error page-error {{view === 'editor' ? 'editor-error' : ''}}">{{error}}</view>
<view wx:if="{{ai}}" class="modal-backdrop" catchtap="closeAi" /><scroll-view wx:if="{{ai}}" scroll-y class="ai-sheet"><view class="ai-sheet-body"><view class="handle" /><view class="row between"><view class="section-title">✧ Qwen 手帐助手</view><button class="icon-button" bindtap="closeAi"><image class="i" src="/assets/icons/close.png" /></button></view><view class="muted">{{(selected ? selected.type === 'text' : false) ? '为所选文本框组织文字' : '添加一段独立感想或图片文字'}}</view><picker range="{{purposes}}" value="{{purpose}}" data-key="purpose" bindchange="aiChoice"><view class="select-field">{{purposes[purpose]}}<view class="chevron" /></view></picker><picker range="{{placements}}" value="{{placement}}" data-key="placement" bindchange="aiChoice"><view class="select-field">{{placements[placement]}}<view class="chevron" /></view></picker>
  <view class="prompt-row"><input wx:if="{{inputMode === 'text'}}" value="{{prompt}}" bindinput="prompt" placeholder="如：照片 2 等了很久，天气很好…" /><view wx:else class="voice-input {{voiceRecording ? 'recording' : ''}}" catchtouchstart="voiceStart" catchtouchmove="voiceMove" catchtouchend="voiceEnd" catchtouchcancel="voiceCancel"><view class="wave-bars"><view /><view /><view /><view /><view /><view /><view /></view><text>{{voiceRecording ? (voiceCancelled ? '松开取消' : '松开确认 · 左滑取消') : '按住说话'}}</text></view><button class="input-toggle" bindtap="toggleInput" aria-label="切换文字或语音输入"><image class="i" src="/assets/icons/{{inputMode === 'text' ? 'mic' : 'journal'}}.png" /></button></view><view class="label">与文字有关的照片</view><view class="ai-photos"><button wx:for="{{aiPhotos}}" wx:key="id" class="ai-photo {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="aiPhoto" aria-pressed="{{item.selected}}"><image src="{{item.src}}" mode="aspectFill" /><text>{{item.selected ? '✓ ' : ''}}{{item.label}}</text></button></view><view class="note">生成时会将勾选图片的压缩副本与输入文字发送至团队 Qwen 网关（最多 4 张）。原图保留；建议先预览再应用。语音转写尚未接入。</view><view wx:if="{{bundleSummary}}" class="note">{{bundleSummary}}</view><button class="ai-button wide" loading="{{aiBusy}}" disabled="{{aiBusy}}" bindtap="prepareAi">{{aiBusy ? '正在生成，关闭可取消' : '生成文案与构图建议'}}</button><view wx:if="{{aiSuggestion}}" class="ai-result"><view class="strong">{{aiSuggestion.title}}</view><view class="ai-result-copy">{{aiSuggestion.body}}</view><view class="muted">AI 建议，请核对鸟名与观察事实。应用后可撤销。</view><button class="primary wide spaced" bindtap="applyAi">仅应用文字</button><button class="quiet wide spaced" data-design="yes" bindtap="applyAi">应用文字与建议构图</button></view><view wx:if="{{error}}" class="muted spaced">{{error}}</view>
</view></scroll-view>

<view wx:if="{{cropOpen}}" class="modal-backdrop" catchtap="cancelCrop" />
<scroll-view wx:if="{{cropOpen}}" scroll-y class="crop-sheet"><view class="crop-sheet-body">
  <view class="handle" /><view class="row between"><view class="section-title">让画面刚好合适</view><button class="icon-button" bindtap="cancelCrop" aria-label="取消裁剪"><image class="i" src="/assets/icons/close.png" /></button></view>
  <view class="muted">只调整框内显示；取消会保留原裁剪。</view>
  <view class="crop-preview-window" style="width:{{cropPreview.width}}px;height:{{cropPreview.height}}px"><image src="{{cropDraft.src}}" data-id="{{cropDraft.id}}" bindload="imageLoaded" mode="scaleToFill" style="position:absolute;width:{{cropPreview.imageW}}px;height:{{cropPreview.imageH}}px;left:{{cropPreview.imageX}}px;top:{{cropPreview.imageY}}px" /></view>
<view class="value-row"><text>放大</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'zoom' ? numberDrafts.zoom : cropDraft.zoom}}" data-key="zoom" data-scope="crop" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="zoom" /><text class="number-unit">×</text></view></view><slider min="1" max="3" step="0.01" value="{{cropDraft.zoom}}" data-key="zoom" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" />
<view class="value-row"><text>左右取景</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropX' ? numberDrafts.cropX : cropDraft.cropX}}" data-key="cropX" data-scope="crop" disabled="{{!cropPreview.canPanX}}" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropX" /><text class="number-unit">%</text></view></view><slider min="0" max="100" step="0.01" value="{{cropDraft.cropX}}" data-key="cropX" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" disabled="{{!cropPreview.canPanX}}" />
<view class="value-row"><text>上下取景</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropY' ? numberDrafts.cropY : cropDraft.cropY}}" data-key="cropY" data-scope="crop" disabled="{{!cropPreview.canPanY}}" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropY" /><text class="number-unit">%</text></view></view><slider min="0" max="100" step="0.01" value="{{cropDraft.cropY}}" data-key="cropY" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" disabled="{{!cropPreview.canPanY}}" />
<view class="tiny">放大后可以获得更多移动范围。</view><button class="text-button crop-reset" bindtap="resetCrop">重置裁剪</button><view class="choice-row crop-actions"><button class="quiet" bindtap="cancelCrop">取消</button><button class="primary" bindtap="applyCrop">确认裁剪</button></view>
</view></scroll-view>
<canvas id="journal-export" type="2d" class="export-canvas" />

<view wx:if="{{layersOpen}}" class="modal-backdrop" catchtap="closeLayers" />
<scroll-view wx:if="{{layersOpen}}" scroll-y class="layer-sheet"><view class="layer-sheet-body"><view class="handle" /><view class="row between"><view class="section-title">选择图层</view><button class="icon-button" bindtap="closeLayers" aria-label="关闭图层"><image class="i" src="/assets/icons/close.png" /></button></view><view class="muted">点选后返回画布，可选择被其他元素遮住的图层。</view><button class="layer-option {{backgroundSelected ? 'layer-current' : ''}}" bindtap="background">背景</button><button wx:for="{{labels}}" wx:key="id" class="layer-option {{item.id === selectedId ? 'layer-current' : ''}}" data-id="{{item.id}}" bindtap="select" aria-pressed="{{item.id === selectedId}}"><text>{{item.label}}</text><text class="layer-state">{{item.id === selectedId ? '已选择' : '选择'}}</text></button></view></scroll-view>

<canvas type="2d" id="journal-ai-canvas" class="export-canvas" />

<view wx:if="{{templateOpen}}" class="modal-backdrop" catchtap="closeTemplates" />
<scroll-view wx:if="{{templateOpen}}" scroll-y class="template-sheet"><view class="handle" /><view class="row between"><view class="section-title">选一个讲故事的版式</view><button class="icon-button" bindtap="closeTemplates" aria-label="关闭版式"><image class="i" src="/assets/icons/close.png" /></button></view><view class="subtitle">使用当前照片预览。原图、文字和裁剪保留；选择后可以撤销。</view><view class="template-options"><button wx:for="{{templateOptions}}" wx:key="id" class="template-option {{doc.variant === item.id ? 'template-current' : ''}}" data-id="{{item.id}}" bindtap="applyTemplate" aria-pressed="{{doc.variant === item.id}}"><view class="template-mini" style="width:{{templateWidth}}px;height:{{templateWidth * doc.height / doc.width}}px;background:{{doc.background}}"><view class="template-heading">{{doc.title}}</view><view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="index" class="template-photo" style="{{photo.style}}"><image src="{{photo.src}}" mode="scaleToFill" style="{{photo.imageStyle}}" /></view></view><text>{{item.name}}</text><view class="template-state">{{doc.variant === item.id ? '当前版式 ✓' : '使用这个版式'}}</view></button></view></scroll-view>
