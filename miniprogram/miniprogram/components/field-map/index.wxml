<view class="field {{wide ? 'field-wide' : ''}} {{compact ? 'field-compact' : ''}}" style="top:{{headerHeight}}px;height:{{fieldHeight}}px">
  <view class="map-toolbar" style="height:{{toolbarHeight}}px">
    <view class="search-row">
      <button class="place-button" bindtap="place"><image class="place-icon" src="/assets/icons/pin.png"/><text>搜地点</text></button>
      <view class="species-input"><input class="bird-input" placeholder="搜索鸟种" value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="80" aria-label="搜索鸟种名称"/><button wx:if="{{keyword || species}}" class="clear-search" bindtap="clearSpecies" aria-label="清除鸟种筛选">×</button></view>
      <button class="search-button" bindtap="search" loading="{{searching}}" aria-label="查找鸟种">查找</button>
    </view>
    <view class="filter-row">
      <picker class="filter-picker" range="{{scopes}}" value="{{scope}}" data-field="scope" bindchange="filter"><view class="filter-button"><text class="filter-text">{{scopes[scope]}}</text><view class="filter-arrow"/></view></picker>
      <picker class="filter-picker" range="{{periods}}" value="{{period}}" data-field="period" bindchange="filter"><view class="filter-button"><text class="filter-text">{{periods[period]}}</text><view class="filter-arrow"/></view></picker>
      <picker class="filter-picker" range="{{origins}}" value="{{origin}}" data-field="origin" bindchange="filter"><view class="filter-button"><text class="filter-text">{{origins[origin]}}</text><view class="filter-arrow"/></view></picker>
    </view>
  </view>
  <view class="map-canvas" style="top:{{toolbarHeight}}px;height:{{mapHeight}}px">
    <map id="field-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" bindregionchange="moved" bindupdated="mapUpdated" bindtap="closeSearch" bindmarkertap="marker" bindcallouttap="marker" class="native"/>
    <view wx:if="{{!listOpen && !compact}}" class="map-actions"><button class="map-action" bindtap="position" aria-label="定位到我的位置"><image class="action-icon" src="/assets/icons/locate.png"/></button><button class="map-action" bindtap="load" loading="{{loading}}" disabled="{{loading}}" aria-label="刷新当前地图区域"><image class="action-icon" src="/assets/icons/redo.png"/></button></view>
    <view wx:if="{{!listOpen}}" class="map-dock" style="bottom:{{creditReserve}}px">
      <view wx:if="{{error}}" class="map-notice"><text class="notice-text">{{error}}</text><button class="notice-retry" bindtap="load">重试</button></view>
      <view wx:if="{{compact}}" class="compact-actions"><button class="map-action" bindtap="position" aria-label="定位到我的位置"><image class="action-icon" src="/assets/icons/locate.png"/></button><button class="compact-records" bindtap="list" disabled="{{dirty || loading}}">{{loading ? '更新中…' : '观察 · '+total}}</button><button class="map-action" bindtap="load" loading="{{loading}}" disabled="{{loading}}" aria-label="刷新地图区域"><image class="action-icon" src="/assets/icons/redo.png"/></button><button class="map-action" bindtap="planTrip" aria-label="观鸟出行顾问"><image class="action-icon" src="/assets/icons/leaf.png"/></button></view>
      <view wx:else class="summary-card"><button class="summary-main" bindtap="list" disabled="{{dirty || loading}}"><view class="summary-copy"><text class="summary-heading">{{species ? speciesLabel : '本区域鸟讯'}}</text><text class="summary-meta">{{loading ? '正在更新区域' : total ? '查看观察记录' : '此区域暂无记录'}}{{period === 0 ? ' · 含历史记录' : ''}}</text></view><text class="record-count">{{loading ? '…' : total}}</text><text class="summary-chevron">›</text></button><button wx:if="{{species}}" class="guide-link" bindtap="guide">鸟种图鉴</button></view>
      <button wx:if="{{!compact}}" class="trip-entry" bindtap="planTrip"><view class="trip-copy"><image class="trip-icon" src="/assets/icons/leaf.png"/><text>观鸟出行顾问</text></view><text class="trip-chevron">›</text></button>
    </view>
    <view wx:if="{{listOpen}}" class="record-sheet" style="height:{{sheetHeight}}px;bottom:{{creditReserve}}px">
      <view class="sheet-header" style="height:{{sheetHeaderHeight}}px"><view class="sheet-header-copy"><text class="sheet-title">{{listTitle}}</text><text class="sheet-count">{{listTotal}} 条{{period === 0 ? ' · 含历史记录' : ''}}</text></view><button class="sheet-close" bindtap="closeList" aria-label="关闭观察列表">×</button></view>
      <scroll-view scroll-y class="record-scroll" style="height:{{listHeight}}px" bindscrolltolower="more">
        <view wx:if="{{error}}" class="list-message"><text>{{error}}</text><button class="retry-button" bindtap="retryRecords">重试加载</button></view>
        <view wx:elif="{{!selected.length}}" class="list-message">{{loading ? '正在加载观察记录…' : '没有符合筛选条件的记录'}}</view>
        <view wx:for="{{selected}}" wx:key="id" class="record-row"><button class="record-main" data-id="{{item.id}}" bindtap="go"><view class="record-heading"><text class="record-name">{{item.speciesName || '待鉴定'}}</text><text class="record-date">{{item.date || '日期未知'}}</text></view><text class="record-meta">{{item.placeName || '地点未注明'}}{{item.source ? ' · '+item.source : ''}}</text></button><button wx:if="{{item.speciesId}}" class="record-guide" data-id="{{item.speciesId}}" bindtap="guide" aria-label="查看{{item.speciesName}}图鉴">图鉴</button></view>
        <button wx:if="{{cursor}}" class="more-button" disabled="{{loading}}" bindtap="more">{{loading ? '加载中…' : '加载更多记录'}}</button><view wx:elif="{{selected.length}}" class="list-end">已显示本次查询的全部记录</view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{matches.length || searchError}}" class="search-results" style="top:{{toolbarHeight - 4}}px"><view class="results-heading"><text>{{searchError || '选择要查看的鸟种'}}</text><button class="results-close" bindtap="closeSearch" aria-label="关闭鸟种搜索">×</button></view><scroll-view scroll-y class="results-scroll"><button wx:for="{{matches}}" wx:key="id" class="species-result" data-id="{{item.id}}" data-name="{{item.name || item.english || item.scientific}}" bindtap="species"><text>{{item.name || item.english || item.scientific}}</text><text class="species-latin">{{item.scientific || ''}}</text></button></scroll-view></view>
</view>
