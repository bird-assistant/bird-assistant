<block wx:if="{{open}}"><view class="choice-shade" catchtap="close" catchtouchmove="noop"/><view class="choice-panel" aria-role="dialog" aria-label="{{title}}"><view class="choice-handle"/><view class="choice-heading"><text>{{title}}</text><button class="choice-close" bindtap="close" aria-label="关闭选择"><image class="choice-close-icon" src="/assets/icons/close.png"/></button></view><scroll-view scroll-y style="height:{{bodyHeight}}px"><view class="choice-options"><button wx:for="{{options}}" wx:key="*this" class="choice-option {{selected === index ? 'choice-selected' : ''}}" data-value="{{index}}" bindtap="choose" aria-pressed="{{selected === index}}"><text class="choice-label">{{item}}</text><view class="choice-radio"><view class="choice-radio-dot" wx:if="{{selected === index}}"/></view></button></view></scroll-view><view class="choice-safe"/></view></block>
