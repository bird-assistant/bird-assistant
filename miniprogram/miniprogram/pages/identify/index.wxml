<app-header title="{{view === 'live' ? '羽迹' : view === 'import' ? '导入素材' : '素材复核'}}" back="{{view !== 'live'}}" bindback="back" />
<view wx:if="{{view === 'live'}}" class="live-screen {{cameraShort ? 'camera-short' : ''}}" style="height:{{height}}px">
  <view class="viewfinder"><camera wx:if="{{pageVisible && !demo && !paused}}" class="native-camera" device-position="back" flash="off" resolution="high" frame-size="large" bindinitdone="cameraReady" binderror="cameraError" bindstop="cameraStopped" />
    <canvas id="vision-encoder" type="2d" class="vision-encoder" />
    <cover-view wx:for="{{liveTracks}}" wx:key="id" class="vision-box vision-{{item.appearance}}" style="{{item.style}}"><cover-view class="vision-tag">{{item.id}} · {{item.label}}</cover-view></cover-view>
    <image wx:if="{{demo}}" src="/assets/samples/live-scene.png" class="demo-scene" mode="aspectFill" style="transform:scale({{zoom}})" /><view class="view-tags"><text>{{demo ? '示例取景 · 非真实识别' : '实时取景'}}</text><button wx:if="{{expanded || demo}}" bindtap="demo">{{demo ? '使用相机' : '查看示例'}}</button></view>
    <view wx:if="{{demo ? !paused : false}}" class="bird-box"><text>树麻雀 86%</text><view class="corner tl" /><view class="corner tr" /><view class="corner bl" /><view class="corner br" /></view>
    <view wx:if="{{paused || cameraError}}" class="camera-cover"><view class="camera-cover-heading"><image class="i" src="/assets/icons/camera.png" /><text class="strong">{{paused ? '取景已暂停' : '相机暂不可用'}}</text></view><text class="camera-cover-copy">{{paused ? '需要时恢复取景，继续留下线索' : cameraError}}</text><view class="camera-cover-actions"><button bindtap="resumeOrDemo">{{paused ? '恢复取景' : '查看取景示例'}}</button><button class="quiet" bindtap="import">导入素材</button></view></view>
  </view>
  <view class="live-mode"><view class="segments"><button class="{{mode === 'quick' ? 'on' : ''}}" data-id="quick" bindtap="mode">快速识别</button><button class="{{mode === 'wait' ? 'on' : ''}}" data-id="wait" bindtap="mode">等候模式</button></view><button class="pause-button" bindtap="pause" aria-label="暂停或恢复取景"><image class="i" src="/assets/icons/{{paused ? 'video' : 'minus'}}.png" /></button></view>
  <button class="mode-caption" bindtap="help">{{mode === 'quick' ? '快速模式久用可能发热 · 查看建议' : '长时间观鸟，用等候模式 · 查看说明'}}</button>
  <view wx:if="{{help}}" class="mode-advice"><view class="strong">拍得从容，也留住瞬间</view><view>持续取景可能发热、耗电。等候模式会放慢分析频率，必要时可暂停取景。</view><view class="capture-advice">{{zoomProfile === 'pura70proplus' ? 'Pura 70 Pro+ 已加入 3.5× 快捷点。拍高速飞鸟，可先用系统相机的闪拍，再从相册导入原片。' : '拍高速移动的鸟，可用系统相机拍摄，再从相册导入原片。'}}</view><text class="advice-note">可用倍率以当前相机为准。</text><view class="advice-actions"><button data-id="wait" bindtap="mode">切换等候模式</button><button bindtap="help">知道了</button></view></view>
  <view class="live-bottom"><view wx:if="{{!paused && !cameraError}}" class="zoom-control {{zoomEnabled ? '' : 'zoom-disabled'}}">
    <button class="zoom-chip" bindtouchstart="zoomStart" bindtouchmove="zoomMove" bindtouchend="zoomEnd" bindtouchcancel="zoomEnd" catchtap="toggleZoom" aria-expanded="{{zoomOpen}}" aria-label="{{zoomOpen ? '收起变焦控制' : '展开变焦控制'}}"><text class="zoom-current">{{zoomText}}×</text><text class="zoom-swipe-hint">变焦</text><view class="control-chevron {{zoomOpen ? 'control-chevron-down' : ''}}"/></button>
    <view class="zoom-body {{zoomOpen ? 'control-open' : ''}}" aria-hidden="{{!zoomOpen}}">    <view class="zoom-presets"><button class="zoom-step" data-delta="-0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom <= 1}}" aria-label="缩小 0.1 倍">−</button><view class="zoom-preset-list"><button wx:for="{{zoomShortcuts}}" wx:key="value" class="zoom-preset {{zoom === item.value ? 'zoom-selected' : ''}}" data-zoom="{{item.value}}" catchtap="zoomPreset" disabled="{{!zoomEnabled}}">{{item.label}}</button></view><button class="zoom-step" data-delta="0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom >= (demo ? 5 : maxZoom)}}" aria-label="放大 0.1 倍">＋</button></view>

    <block><view class="zoom-scale" catchtouchstart="zoomStart" catchtouchmove="zoomMove" catchtouchend="zoomEnd" catchtouchcancel="zoomEnd" aria-label="左右滑动调整变焦，当前 {{zoomText}} 倍"><view class="zoom-track"><view class="zoom-axis"/><view wx:for="{{zoomTicks}}" wx:key="id" class="zoom-tick {{item.major ? 'zoom-major' : ''}}" data-zoom="{{item.id}}" catchtap="zoom" style="left:calc(50% + {{item.offset}}px)"><view class="zoom-tick-line"/><text wx:if="{{item.major}}">{{item.label}}</text></view><view class="zoom-centre"/></view></view><view class="zoom-range">{{zoomRange}}{{zoomEnabled ? ' · 左右滑动，± 微调' : ''}}</view></block></view>
  </view>
    <view class="clue-panel"><button class="clue-handle" catchtap="toggleClues" bindtouchstart="clueStart" bindtouchmove="clueMove" bindtouchend="clueEnd" bindtouchcancel="clueEnd" aria-expanded="{{!clueCollapsed}}"><image class="i" src="/assets/icons/{{focus === 'visual' ? 'scan' : 'mic'}}.png"/><text class="clue-handle-title">{{focus === 'visual' ? '画面线索' : '声音线索'}}</text><text class="clue-handle-status">{{focus === 'visual' ? liveText : audioRecording ? '录音中' : '私人录音'}}</text><view wx:if="{{liveActive || audioRecording}}" class="clue-dot {{audioRecording ? 'recording-dot' : ''}}"/><view class="control-chevron {{!clueCollapsed ? 'control-chevron-down' : ''}}"/></button><view class="clue-body {{!clueCollapsed ? 'control-open' : ''}}" aria-hidden="{{clueCollapsed}}"><view class="clue-tabs"><button class="{{focus === 'visual' ? 'on' : ''}}" data-id="visual" bindtap="focus"><image class="i" src="/assets/icons/scan.png"/>画面线索<view wx:if="{{liveActive}}" class="clue-dot"/></button><button class="{{focus === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="focus"><image class="i" src="/assets/icons/mic.png"/>声音线索<view wx:if="{{audioRecording}}" class="clue-dot recording-dot"/></button><button class="expand-button" bindtap="expand" aria-expanded="{{expanded}}" aria-label="{{expanded ? '收起识别线索详情' : '展开识别线索详情'}}"><image class="i {{expanded ? 'turned' : ''}}" src="/assets/icons/chevron.png"/></button></view>
      <view class="clue-summary"><view class="clue-copy"><text class="clue-title">{{focus === 'visual' ? (demo ? '示例候选 · 树麻雀' : liveText) : (audioRecording ? '正在留下鸟鸣' : '留一段鸟鸣，稍后辨认')}}</text><text class="clue-note">{{focus === 'visual' ? (demo ? '示例取景，非真实识别' : liveActive ? '候选供你复核，轻触快门保留高清照片' : '开启后分析画面，也可先拍下来') : '录音后可回听，或单独上传分析'}}</text></view><button wx:if="{{focus === 'visual' && !demo && !paused && !cameraError}}" class="vision-toggle {{liveActive ? 'vision-on' : ''}}" disabled="{{!cameraReady}}" bindtap="toggleVision">{{liveActive ? '停止' : '开启'}}</button><button wx:elif="{{focus === 'audio'}}" class="audio-capture" disabled="{{recording || busy}}" bindtap="recordAudio">{{audioRecording ? '保留' : '录音'}}</button></view>
      <scroll-view wx:if="{{expanded}}" scroll-y class="clue-detail" style="height:{{clueHeight}}px"><view class="clue-detail-content"><view wx:if="{{focus === 'audio' || !liveTracks.length}}" class="clue-detail-copy">{{focus === 'audio' ? '声音单独保留，不直接替画面下结论。录音结束后可在复核素材中回听。' : '让鸟体尽量清晰、完整。没有可靠候选时，也能保留照片，交给自己或鸟友复核。'}}</view><view wx:else class="vision-list"><view wx:for="{{liveTracks}}" wx:key="id" wx:for-item="track" class="vision-subject"><text class="strong">目标 {{track.id}} · {{track.label}}</text><text wx:if="{{track.scope}}"> · {{track.scope}}</text><view wx:if="{{track.candidates.length}}">{{track.state === 'unknown' ? '可能是 · 供人工复核' : '候选 · 相对相似度'}}</view><view wx:for="{{track.candidates}}" wx:key="rank">{{item.name}} · {{item.scoreText}}</view></view><button bindtap="keepFrame">保留本帧并复核</button></view></view></scroll-view>
    </view></view>
    <view class="capture-row"><button class="capture-side" bindtap="import"><image class="capture-icon" src="/assets/icons/image.png" /><text>相册 / 文件</text></button><button class="shutter {{recording ? 'video-recording' : ''}}" disabled="{{paused || busy}}" bindtouchstart="shutterStart" bindtouchend="shutterEnd" bindtouchcancel="shutterCancel" bindtap="shutterPhoto" aria-label="{{liveActive ? '拍摄高清照片并识别，长按录像' : '轻触拍照，长按录像'}}"><view /></button><button class="capture-side" bindtap="review"><view class="evidence-count">{{assets.length}}</view><text>复核素材</text></button></view><view class="capture-hint">{{recording ? '正在录像 '+recordSeconds+' 秒 · 松开结束' : liveActive ? '轻触快门，用高清照片识别 · 长按录像' : '轻触拍照，长按录像'}}</view>
  </view>
</view>
<view wx:elif="{{view === 'import'}}" class="page import-page {{focusedPage ? 'focused-page' : ''}}"><view class="eyebrow">先拍下来，也可以稍后辨认</view><view class="title">导入素材</view><view class="subtitle">先添加所需照片、视频和声音，再到素材复核统一选择、识别和保存。</view><view class="segments"><button class="{{importKind === 'gallery' ? 'on' : ''}}" data-id="gallery" bindtap="importKind">照片 / 视频</button><button class="{{importKind === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="importKind">音频文件</button></view><button class="import-drop" loading="{{picking}}" disabled="{{picking || batching}}" bindtap="chooseFiles"><image src="/assets/icons/{{importKind === 'audio' ? 'mic' : 'image'}}.png" /><view class="import-copy"><text class="strong">{{importKind === 'audio' ? '选择音频文件' : '从设备选择照片或视频'}}</text><text class="tiny">{{importKind === 'audio' ? 'MP3 · WAV · AAC · M4A / MP4 · OGG' : '照片与视频 · 保留原件'}}</text></view></button><view class="tiny">{{importKind === 'audio' ? '识别支持1–60秒、10 MB以内的MP3、WAV、AAC或M4A。OGG仅在本机保留。' : '照片可上传分析；视频可先私人保留，稍后复核。'}}</view><button wx:if="{{importKind === 'gallery' && photoFallback}}" class="quiet wide spaced" data-source="album" bindtap="choose">改用照片选择</button><view wx:if="{{!assets.length}}" class="import-example"><text class="tiny">没有文件？可以先看示例</text><button class="small-button" bindtap="addSample">添加图片示例</button></view><view class="row between section-title"><text>本次素材 · {{assets.length}}</text><button class="small-button" bindtap="review">编辑观察记录</button></view><scroll-view scroll-x class="evidence-strip"><view wx:for="{{assets}}" wx:key="id" class="evidence-item {{item.included ? 'evidence-selected' : ''}}" style="border-color:{{item.included ? '#285b49' : '#d8e3d2'}}"><button data-id="{{item.id}}" bindtap="previewEvidence" aria-label="{{item.name}}，{{item.selected ? '已选' : '未选'}}"><image wx:if="{{item.kind === 'photo'}}" src="{{item.path}}" mode="aspectFill"/><view wx:elif="{{item.kind === 'audio'}}" class="audio-file"><text class="audio-file-name">{{item.name}}</text><text class="audio-file-size">{{item.sizeLabel || '音频原件'}}</text></view><view wx:else class="media-icon-box"><image class="media-icon" src="/assets/icons/video.png"/></view><text wx:if="{{item.included}}" class="evidence-check" aria-hidden="true">✓</text><text class="evidence-name">{{item.sample ? '示例插画' : item.kind === 'audio' ? item.name : item.name}}</text></button><text class="evidence-state">{{item.status}}</text><button class="evidence-view" data-id="{{item.id}}" bindtap="previewEvidence" disabled="{{batching}}">{{item.kind === 'audio' ? '回听 / 复核' : '查看 / 复核'}}</button><button class="evidence-remove" data-id="{{item.id}}" bindtap="removeEvidence" disabled="{{batching}}" aria-label="移除素材">×</button></view></scroll-view><view wx:if="{{!assets.length}}" class="import-empty">导入的照片与声音会显示在这里</view><button class="primary wide spaced" bindtap="continueReview" disabled="{{picking || !assets.length}}">进入素材复核 · {{assets.length}} 份</button><view class="note">这里仅添加素材，不会上传识别。取景拍摄与外部导入的素材在同一处复核，已有结果与笔记会保留。</view></view>
<view wx:else class="page review-page {{focusedPage ? 'focused-page' : ''}}"><view class="title">留下这次发现</view><view class="subtitle">确认素材，补充感想。保存默认只对自己可见。</view><scroll-view scroll-x class="evidence-strip review-evidence-strip"><view wx:for="{{assets}}" wx:key="id" class="evidence-item {{item.included ? 'evidence-selected' : ''}} {{currentId === item.id ? 'evidence-previewed' : ''}}" style="border-color:{{item.included ? '#285b49' : '#d8e3d2'}}"><button data-id="{{item.id}}" bindtap="selectEvidence" disabled="{{batching}}"><image wx:if="{{item.kind === 'photo'}}" src="{{item.path}}" mode="aspectFill" /><view wx:elif="{{item.kind === 'audio'}}" class="audio-file"><text class="audio-file-name">{{item.name}}</text><text class="audio-file-size">{{item.sizeLabel}}</text></view><view wx:else class="media-icon-box"><image class="media-icon" src="/assets/icons/video.png"/></view><text class="evidence-name">{{item.sample ? '示例插画' : item.name}}</text></button><button wx:if="{{!item.sample && item.kind !== 'video'}}" class="review-check {{item.included ? 'review-checked' : ''}}" data-id="{{item.id}}" catchtap="toggleImportEvidence" disabled="{{batching}}" aria-label="{{item.selected ? '取消选择这份素材' : '选择这份素材'}}">{{item.included ? '✓' : '+'}}</button><text class="evidence-state">{{item.status}}</text><text wx:if="{{currentId === item.id}}" class="evidence-current">当前查看</text><button class="evidence-remove" data-id="{{item.id}}" bindtap="removeEvidence" disabled="{{batching}}" aria-label="移除素材">×</button></view></scroll-view><view class="import-modes"><button data-id="media" bindtap="importMode" disabled="{{batching}}" class="import-mode {{importMode === 'media' ? 'import-mode-on' : ''}}">仅照片</button><button data-id="audio" bindtap="importMode" disabled="{{batching}}" class="import-mode {{importMode === 'audio' ? 'import-mode-on' : ''}}">仅声音</button><button data-id="both" bindtap="importMode" disabled="{{batching}}" class="import-mode {{importMode === 'both' ? 'import-mode-on' : ''}}">照片＋声音</button></view><view class="tiny import-help">{{importMode === 'media' ? '照片默认全选，轻点卡片勾选或取消。逐张分析，结果分别保留。' : importMode === 'audio' ? '声音默认全选，轻点可取消；逐段分析，可按名称回听。' : '可选多张照片和多段声音，结果分别保留，不合并为同一只鸟。'}}</view><view class="tiny">轻点缩略图查看；左上角勾选控制识别范围。已有结果直接复核，只上传尚未分析的所选素材。</view><button class="primary wide spaced" bindtap="analyseSelected" loading="{{batching}}" disabled="{{batching || analyzing || picking || !assets.length}}">{{batching ? '正在识别所选素材' : '识别所选未分析素材'}}</button><button wx:if="{{batching || analyzing}}" class="text-button" bindtap="cancelAnalysis">取消识别</button><view wx:if="{{batchProgress}}" class="note">{{batchProgress}}</view>
  <view wx:if="{{savedDraft && !imagePath}}" class="card"><view>已存入我的观察 · {{savedDraft.speciesName}}</view><button class="primary" bindtap="shareSaved">{{savedDraft.species ? '分享这次观察' : '请鸟友帮我认'}}</button></view><view wx:elif="{{!assets.length}}" class="empty">还没有保留素材。<view>可返回取景，或导入已有照片、视频和声音。</view></view><block wx:if="{{imagePath}}"><view wx:if="{{mediaKind === 'photo' && analysis.subjects.length}}" class="review-targets" bindtap="preview"><image src="{{imagePath}}" mode="widthFix" /><view wx:for="{{analysis.subjects}}" wx:key="rank" class="vision-box" style="left:{{100*item.box.x1}}%;top:{{100*item.box.y1}}%;width:{{100*(item.box.x2-item.box.x1)}}%;height:{{100*(item.box.y2-item.box.y1)}}%"><text class="vision-tag">目标 {{item.rank}}</text></view></view><image wx:elif="{{mediaKind === 'photo'}}" class="review-photo" src="{{imagePath}}" mode="widthFix" bindtap="preview" /><video wx:elif="{{pageVisible && mediaKind === 'video'}}" class="review-video" src="{{imagePath}}" controls /><button wx:else class="wide spaced" bindtap="preview">回听 · {{currentName || '所选音频'}}</button><view class="row between review-meta"><text class="muted">{{albumStatus}}</text><button wx:if="{{source === 'camera'}}" class="text-button" bindtap="retryAlbum">重试保存相册</button></view><photo-editor wx:if="{{mediaKind === 'photo' && !isSample}}" readonly file-info="{{fileMetadata}}"/><text class="label">识别线索</text>
    <block wx:if="{{mediaKind !== 'video' && !isSample}}"><button wx:if="{{analysis}}" class="quiet wide" bindtap="analyse" disabled="{{analyzing || batching || busy}}" loading="{{analyzing}}">仅重新分析当前素材</button><view wx:else class="tiny">尚未识别。可在上方选择识别范围；也可先补充笔记并私人保存。</view></block>
    <view wx:else class="note">{{isSample ? '示例素材仅供体验' : '视觉分析支持照片，可先保留这份素材'}}</view>
    <view wx:if="{{analysis}}" class="vision-result"><view wx:if="{{analysis.kind === 'audio'}}" class="audio-candidates"><text class="strong">声音候选 · {{analysis.example ? '示例结果' : analysis.state === 'candidate' ? '供人工复核' : '暂时无法可靠识别'}}</text><text class="tiny">BirdNET分数用于候选排序，不代表鉴定正确率。照片与声音单独复核。</text><view wx:for="{{analysis.candidates}}" wx:key="rank" class="candidate-actions"><button class="vision-choice" disabled="{{analysis.example || busy || analyzing}}" data-rank="{{item.rank}}" bindtap="confirmAudioCandidate"><text>{{item.name}} · {{item.scoreText}}</text><text>{{birdName === item.name ? '已选' : '选用'}}</text></button><button class="candidate-info" disabled="{{!item.speciesId}}" data-id="{{item.speciesId}}" bindtap="speciesInfo">{{item.speciesId ? '查看资料' : '资料待补充'}}</button></view></view><view class="strong">{{analysis.example ? '示例模型结果' : analysis.state === 'candidate' ? '鸟种候选' : analysis.reason === 'no_bird_detected' ? '照片中未检出鸟类' : analysis.reason === 'subject_below_minimum_size' ? '鸟体太小，请靠近或换一张照片' : '暂时无法可靠识别'}}</view><view class="tiny">{{analysis.model.name}} · {{analysis.model.catalogVersion}}</view>
      <view wx:for="{{analysis.subjects}}" wx:key="rank" wx:for-item="subject" class="vision-subject"><bird-crop src="{{imagePath}}" box="{{subject.box}}"/><button wx:if="{{subject.candidates.length && !analysis.example}}" data-rank="{{subject.rank}}" bindtap="compareTarget">对照图鉴 · 比较候选鸟种</button><text class="strong">目标 {{subject.rank}} · {{subject.state === 'candidate' ? '候选' : '待鉴定'}}</text><view wx:if="{{subject.candidates.length}}" class="tiny">{{subject.state === 'unknown' ? '可能是 · 供人工复核' : '按相对相似度排序'}}</view><view wx:else class="tiny">可尝试放大鸟体，选用更清晰的画面。</view><view wx:for="{{subject.candidates}}" wx:key="rank" class="candidate-actions"><button class="vision-choice" disabled="{{analysis.example || busy}}" data-subject="{{subject.rank}}" data-rank="{{item.rank}}" bindtap="confirmCandidate"><text>{{item.name}} · {{item.scoreText}}</text><text>{{birdName === item.name ? '已选' : '选用'}}</text></button><button class="candidate-info" data-subject="{{subject.rank}}" data-rank="{{item.rank}}" bindtap="candidateInfo">查看资料</button></view></view>
      <button class="text-button" bindtap="clearCandidate">保留为待鉴定</button></view><text class="label">鸟名（可留空）</text><input value="{{birdName}}" bindinput="changeName" disabled="{{busy || batching}}" placeholder="待鉴定，或填写你判断的鸟名" /><text class="label">观察笔记</text><textarea auto-height value="{{notes}}" bindinput="changeNotes" disabled="{{busy || batching}}" placeholder="发生了什么？有什么想留下的？" />
    <block wx:if="{{mediaKind === 'photo' && !isSample}}"><button class="quiet wide review-share" bindtap="shareObservation">{{birdName ? '分享这次观察' : '请鸟友帮我认'}} </button><block wx:for="{{analysis.subjects}}" wx:key="rank" wx:for-item="target"><button class="text-button" wx:for="{{target.candidates}}" wx:key="rank" wx:if="{{item.speciesId}}" data-id="{{item.speciesId}}" bindtap="speciesInfo">查资料 · {{item.name}}</button></block></block>
    <view class="observation-context">
      <button class="context-toggle" bindtap="toggleContext" disabled="{{busy || batching}}" aria-label="补充或收起观察时间与地点">
        <view class="context-heading"><text class="strong">观察时间与地点 · 可选</text><text class="tiny">{{observedDate || '时间未知'}}{{observedTime ? ' '+observedTime : ''}} · {{placeName || '地点未填写'}}</text></view><text class="context-toggle-label">{{contextOpen ? '收起' : '补充'}}</text>
      </button>
      <view wx:if="{{contextOpen}}" class="context-fields">
        <block wx:if="{{mediaKind === 'photo' && !isSample}}"><button class="text-button" bindtap="usePhotoMetadata">读取照片拍摄信息</button><text class="tiny">拍摄点 WGS84 · 可选，可清空</text><input value="{{latitude}}" data-key="latitude" bindinput="changeCoordinate" placeholder="纬度" /><input value="{{longitude}}" data-key="longitude" bindinput="changeCoordinate" placeholder="经度" /></block>
        <view class="context-pickers">
          <view><text class="context-label">观察日期</text><picker mode="date" value="{{observedDate || today}}" end="{{today}}" disabled="{{busy || batching}}" data-key="observedDate" bindchange="changeContext"><view class="context-field">{{observedDate || '日期未知 · 选择'}}</view></picker></view>
          <view><text class="context-label">时刻（可选）</text><picker mode="time" value="{{observedTime || '12:00'}}" disabled="{{busy || !observedDate}}" data-key="observedTime" bindchange="changeContext"><view class="context-field {{observedDate ? '' : 'context-disabled'}}">{{observedTime || '时刻未知'}}</view></picker></view>
        </view>
        <view wx:if="{{observedDate}}" class="context-clear"><button wx:if="{{observedTime}}" class="text-button" bindtap="clearObservedTime" disabled="{{busy || batching}}">仅保留日期</button><button class="text-button" bindtap="clearObservedDate" disabled="{{busy || batching}}">清除观察时间</button></view>
        <text class="label">观察地点</text><input value="{{placeName}}" data-key="placeName" bindinput="changeContext" maxlength="80" disabled="{{busy || batching}}" placeholder="公园或区域名称（可留空）" />
        <view class="tiny context-help">时间按北京时间填写；不确定可留空。保存时间不会代替观察时间。</view>
      </view>
    </view>
    <button class="primary wide spaced" loading="{{busy}}" disabled="{{busy || picking || analyzing || batching}}" bindtap="save">保存私人观察到本机</button></block><view class="choice-row"><button bindtap="back">继续取景</button><button bindtap="import">再导入素材</button></view>
</view>
<view wx:if="{{error}}" class="recognition-error">{{error}}</view>
