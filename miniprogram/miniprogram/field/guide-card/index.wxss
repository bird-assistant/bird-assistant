:host{display:block;min-width:0}

.guide{color:#253c34;min-width:0}

.guide-heading{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}

.guide-name{font-size:19px;font-weight:600;line-height:1.35}

.guide-latin{font-size:12px;font-style:italic;color:#71816b;overflow-wrap:anywhere}

.reference-box{width:100%;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}

.reference{display:block;max-width:100%;border:1px solid #dce5d7;border-radius:10px;box-sizing:border-box;background:transparent}

.reference-fallback{width:100%;height:100%;border:1px dashed #d2dfca;border-radius:10px;display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;font-size:12px;color:#7b8974;box-sizing:border-box}

.photo-loading{position:absolute;left:0;right:0;bottom:8px;text-align:center;font-size:11px;color:#71816b}

.photo-retry{display:flex;align-items:center;justify-content:center;min-height:36px;min-width:0;margin:0;padding:7px 12px;border:1px solid #dce5d7;border-radius:10px;background:#fffef9;color:#285b49;font-size:12px;line-height:1.4}

.photo-retry::after{border:0}

.photo-credit{padding:10px 0 14px;display:flex;flex-direction:column;gap:3px}

.credit-author,.credit-link,.trait-credit{font-size:11px;line-height:1.55;color:#7b8974;overflow-wrap:anywhere}

.trait{min-height:40px;padding:10px 0;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16px;border-top:1px solid #e4eadd}

.trait-label{flex:none;font-size:13px;color:#71816b}

.trait-value{min-width:0;text-align:right;font-size:14px;color:#285b49;overflow-wrap:anywhere}

.trait-credit{padding-top:12px}

.guide-mark{padding:12px 0;font-size:13px;line-height:1.8}

.guide-status{padding:20px 0;font-size:13px;color:#71816b}

.guide-compact .guide-heading{height:54px;margin-bottom:8px;overflow:hidden}

.guide-compact .guide-name{font-size:16px}

.guide-compact .guide-latin{font-size:11px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

.reference-compact{height:164px}

.guide-compact .photo-credit{height:76px;box-sizing:border-box;overflow:hidden}

.guide-compact .credit-author{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

.guide-compact .trait{height:60px;min-height:60px;flex-direction:column;align-items:flex-start;justify-content:center;gap:4px;padding:7px 0}

.guide-compact .trait-label{font-size:11px}

.guide-compact .trait-value{text-align:left;font-size:14px;line-height:1.3;max-height:36px;overflow:hidden}

.guide-compact .trait-credit{height:68px;box-sizing:border-box;overflow:hidden}
