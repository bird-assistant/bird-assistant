<page-meta page-style="{{view === 'home' || shareOpen || calendarOpen || filterOpen || libraryToolsOpen ? 'overflow:hidden;' : 'overflow:auto;'}}"/>
<app-header title="{{headerTitle}}" back="{{view !== 'home'}}" bindback="back" />
<view wx:if="{{view === 'home'}}" class="page journal-home {{homeCompact ? 'library-compact' : ''}} {{homeTiny ? 'library-tiny' : ''}}" style="top:{{headerHeight}}px;height:{{homeHeight}}px">
  <view class="library-heading"><view><view class="library-eyebrow">FIELD NOTES / 羽迹</view><view class="library-title">我的手帐 <text>{{libraryTotal}} 份</text></view></view><button class="button-with-icon primary library-new" bindtap="newJournal" hover-class="press-feedback" hover-start-time="0" hover-stay-time="70"><image class="inline-symbol" src="/assets/icons/plus.png"/><text>新建</text></button></view>
  <button wx:if="{{doc || resumeRow}}" class="library-resume" bindtap="resume">继续编辑 <text class="resume-name">{{doc ? doc.title : resumeRow.title}}</text><image class="resume-arrow" src="/assets/icons/arrow.png"/></button>
  <view wx:if="{{!homeCompact}}" class="library-controls">  <input class="library-search" value="{{libraryText}}" bindinput="librarySearch" placeholder="搜索手帐名称" confirm-type="search" />
  <view class="library-filters"><button class="journal-choice journal-choice-libraryOrder" data-key="libraryOrder" bindtap="openJournalChoice"><view class="library-filter">{{libraryOrders[libraryOrder]}}</view></button><button class="journal-choice journal-choice-libraryRatio" data-key="libraryRatio" bindtap="openJournalChoice"><view class="library-filter">{{libraryRatios[libraryRatio]}}</view></button><button class="text-button" bindtap="clearLibraryFilters">重置</button></view>
  <view class="library-dates"><button class="date-range-trigger" data-target="library" bindtap="openCalendar">{{libraryFrom || '开始日期'}}</button><text>—</text><button class="date-range-trigger" data-target="library" bindtap="openCalendar">{{libraryTo || '结束日期'}}</button></view>
</view><button wx:else class="library-tools-button" bindtap="openLibraryTools"><image src="/assets/icons/settings.png"/><text>查找与筛选</text><text class="tiny">{{libraryOrders[libraryOrder]}} · {{libraryRatios[libraryRatio]}}</text></button>
  <view wx:if="{{libraryFrom && libraryTo && libraryFrom > libraryTo}}" class="notice-error">开始日期不能晚于结束日期。</view>
  <view wx:if="{{libraryRows.length}}" class="deck-position"><text>{{paperArmedId ? (paperDragDown ? (paperDragAction === 'delete' ? '松手，确认删除' : '继续下划，送入回收桶') : '') : paperPhase && paperPhase !== 'returning' ? '' : (deckIndex + 1)+' / '+libraryRows.length+' · 左右切换 · 长按1秒操作'}}</text></view>
  <view wx:if="{{paperArmedId || paperPhase === 'depart-share' || paperPhase === 'depart-delete'}}" class="paper-dismiss" catchtap="cancelPaper"/>
  <view wx:if="{{paperFog > 0 && !paperDragDown || paperPhase === 'depart-share'}}" class="paper-cloud" style="top:{{headerHeight}}px;height:{{paperCloudHeight}}px;opacity:{{paperFog}}" aria-hidden="true"/>

  <view wx:if="{{libraryRows.length}}" class="journal-deck-frame"><view class="journal-deck" style="height:{{deckHeight}}px"><view class="deck-track" style="transform:translateX({{deckOffset}}px);transition:{{deckSettling ? 'transform .22s cubic-bezier(.2,.7,.25,1)' : 'none'}}">
    <view wx:for="{{deckSlots}}" wx:key="id" class="deck-item {{item.slot === 0 ? 'deck-active' : item.slot < 0 ? 'deck-left' : 'deck-right'}}" style="left:{{8 + item.slot * 84}}%"><view class="deck-card {{paperArmedId === item.id ? 'paper-armed' : ''}} {{paperVisualId === item.id ? 'paper-flight paper-'+paperPhase : ''}} {{item.slot === 0 && deckArrival ? 'deck-arrival-'+deckArrival : ''}}" style="{{paperVisualId === item.id ? paperDragStyle : ''}}" data-id="{{item.id}}" data-index="{{item.index}}" catchtap="deckCard" bindtouchstart="deckTouchStart" bindtouchmove="deckTouchMove" bindtouchend="deckTouchEnd" bindtouchcancel="closePaperAction">
      <view class="deck-meta"><text>创建 {{item.createdLabel}}</text><text class="deck-ratio">{{item.ratio}}</text></view>
      <view class="deck-cover deck-composition" style="height:{{deckPreviewHeight}}px" aria-label="{{item.title}}的手帐排版预览"><image wx:if="{{deckThumbnails[item.id]}}" class="deck-bitmap" src="{{deckThumbnails[item.id]}}" mode="aspectFit" data-id="{{item.id}}" binderror="thumbnailFailed"/><button wx:elif="{{previewErrors[item.id]}}" class="text-button deck-preview-retry" data-id="{{item.id}}" catchtap="retryThumbnail">预览暂未生成 · 重试</button><view wx:else class="tiny">正在准备整页预览…</view></view>
      <view class="deck-title">{{item.title}}</view><view class="deck-footer"><text>修改 {{item.updatedLabel}}</text><view class="deck-actions" catchtouchstart="holdSheet"><button class="text-button" data-id="{{item.id}}" catchtap="shareJournal">分享</button><button class="text-button" data-id="{{item.id}}" catchtap="renameJournal">重命名</button><button class="text-button delete-journal" data-id="{{item.id}}" catchtap="deleteJournal">删除</button></view></view>
    </view></view>
  </view></view><view wx:if="{{(paperArmedId || paperPhase === 'depart-delete') && paperDragDown}}" class="paper-bin {{paperDragAction === 'delete' ? 'paper-bin-ready' : ''}}" aria-hidden="true"><view class="bin-lid"/><view class="bin-body"/></view>  <view wx:if="{{paperArmedId && !paperDragDown}}" class="paper-share-hint"><text>{{paperDragAction === 'share' ? '松手，让这一页飞向分享' : '上划分享 · 下划删除'}}</text><text class="paper-cancel-note">轻点空白处或左右划动退出</text></view><view class="deck-fade deck-fade-left" style="top:{{headerHeight}}px"/><view class="deck-fade deck-fade-right" style="top:{{headerHeight}}px"/></view>

  <view wx:if="{{!libraryRows.length}}" class="library-empty">{{libraryTotal ? '没有符合筛选条件的手帐' : '还没有手帐，从照片或观察开始。'}}</view>

  <view class="library-bottom {{paperArmedId ? 'paper-armed-bottom' : ''}}"><text>自动保存到本机</text><button class="text-button" data-count="2" bindtap="sample">试试示例构图</button></view>
</view>
<view wx:elif="{{view === 'picker'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><view class="title">挑选这次的片段</view><view class="subtitle">先选素材，再决定怎样讲述。优先选 1–2 张，让每次发现都有自己的留白；也支持组图。</view><view class="segments journal-source"><button class="{{source === 'album' ? 'on' : ''}}" data-id="album" bindtap="source">手机相册</button><button class="{{source === 'observations' ? 'on' : ''}}" data-id="observations" bindtap="source">我的观察</button><button class="{{source === 'collection' ? 'on' : ''}}" data-id="collection" bindtap="source">我的收藏</button><button class="{{source === 'sample' ? 'on' : ''}}" data-id="sample" bindtap="source">示例素材</button></view>
  <view class="date-fields"><button class="date-range-trigger" data-target="assets" bindtap="openCalendar">{{from || '开始日期'}}</button><button class="date-range-trigger" data-target="assets" bindtap="openCalendar">{{to || '结束日期'}}</button></view><view class="row between"><button class="check-option" aria-pressed="{{unknown}}" bindtap="unknown"><view class="check-square"><image wx:if="{{unknown}}" class="check-symbol" src="/assets/icons/check.png"/></view>也显示日期未知的素材</button><button wx:if="{{from || to}}" class="text-button" bindtap="clearDates">清除日期</button></view><view wx:if="{{from && to && from > to}}" class="note error">开始日期不能晚于结束日期。</view>
  <button wx:if="{{source === 'album'}}" class="button-with-icon wide spaced" bindtap="importPhotos" hover-class="press-feedback" hover-start-time="0" hover-stay-time="70"><image class="inline-symbol" src="/assets/icons/plus.png"/><text>从设备选择照片</text></button><view class="asset-grid"><button wx:for="{{assets}}" wx:key="id" class="asset {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="chooseAsset"><image src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" bindload="assetLoaded" style="height:{{assetImageHeight}}px" /><view class="tick"><image class="check-symbol" src="/assets/icons/{{item.selected ? 'check' : 'plus'}}.png"/></view><view class="strong">{{item.label}}</view><view class="tiny">{{item.date || '日期未知'}}{{item.sample ? ' · 插画' : ''}}</view></button></view><view wx:if="{{!assets.length}}" class="empty">暂无照片。可导入相册照片，<view>或切换示例素材。</view></view><view class="row between section-title"><text>已选 {{chosen}}/6</text><button class="text-button" bindtap="clearSelection">清空选择</button></view><view class="picked-list"><view wx:for="{{picked}}" wx:key="id" class="picked-row"><text>{{index+1}}. {{item.label}}</text><button class="reorder" data-id="{{item.id}}" data-delta="-1" bindtap="reorder" aria-label="前移 {{item.label}}"><image class="i" src="/assets/icons/back.png" style="transform:rotate(90deg)" /></button><button class="reorder" data-id="{{item.id}}" data-delta="1" bindtap="reorder" aria-label="后移 {{item.label}}"><image class="i" src="/assets/icons/back.png" style="transform:rotate(-90deg)" /></button></view></view><button class="primary wide" disabled="{{!chosen || (from && to && from > to)}}" bindtap="next">下一步：风格与比例</button><view class="tiny spaced">保留原件；不会为未知日期补写导入时间。</view>
</view>
<view wx:elif="{{view === 'setup'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><text class="pill">本地排版 · 原图保留</text><view class="title spaced">这一页，什么模样？</view><scroll-view scroll-x class="film"><image wx:for="{{assets}}" wx:if="{{item.selected}}" wx:key="id" src="{{item.src}}" mode="aspectFill" /></scroll-view><text class="label">手帐名称（以后可重命名）</text><input value="{{title}}" bindinput="title" /><text class="label">起始风格</text><view class="choice-row"><button wx:for="{{styles}}" wx:key="id" class="{{style === item.id ? 'active' : ''}}" data-key="style" data-id="{{item.id}}" bindtap="setting">{{item.name}}</button></view><text class="label">画布比例</text><view class="choice-row"><button wx:for="{{ratios}}" wx:key="*this" class="{{ratio === item ? 'active' : ''}}" data-key="ratio" data-id="{{item}}" bindtap="setting">{{item}}</button></view><button class="journal-choice journal-choice-period" data-key="period" bindtap="openJournalChoice"><view class="label">整理类型（仅标记草稿）</view><view class="select-field">{{periods[period]}}<view class="chevron" /></view></button><button class="check-option" aria-pressed="{{includeNotes}}" bindtap="notes"><view class="check-square"><image wx:if="{{includeNotes}}" class="check-symbol" src="/assets/icons/check.png"/></view>将所选观察的备注加入初稿</button><view class="note">三种风格是起点，画布里的图片、文字和装饰都能调整，也可以更换构图。</view><button class="primary wide" bindtap="generate">生成可编辑初稿</button><view class="photo-journal-option"><view class="strong">也可以让照片讲述这一页</view><view class="tiny">选择自己的1–4张照片，先填写想怎么写。只有点击生成建议，才会发送所选照片的压缩副本。</view><button class="ai-button wide spaced" bindtap="generateFromPhotos">打开照片AI写作</button></view></view>
<view wx:elif="{{view === 'editor'}}" class="editor-page" style="height:{{editorHeight}}px">
  <view class="stage-sticky"><view class="journal-name-row"><text>{{doc.title}}</text><button class="text-button" bindtap="shareJournal">分享</button><button class="text-button" bindtap="renameJournal">重命名</button><button class="text-button delete-journal" bindtap="deleteJournal">删除</button></view><view class="editor-toolbar"><button class="tool" disabled="{{!canUndo}}" bindtap="undo" aria-label="撤销"><image class="i" src="/assets/icons/undo.png" /></button><button class="tool" disabled="{{!canRedo}}" bindtap="redo" aria-label="重做"><image class="i" src="/assets/icons/redo.png" /></button><text class="toolbar-status">{{saveStatus || (dirty ? '更改待保存' : '已自动保存')}} · {{doc.ratio}}</text><button class="text-button" bindtap="chooseTemplate">选择版式</button><button class="save-small" loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存</button></view>
    <view class="canvas-viewport" bindtap="background" style="height:{{stageHeight}}px"><view class="journal-paper" style="margin-left:{{paperLeft}}px;transform-origin:top left;width:{{stageWidth}}px;height:{{docHeight}}px;background:{{doc.background}};transform:translateY(-{{focusY}}px) scale({{paperScale}})">
      <image wx:if="{{paperSource}}" class="paper-texture" src="{{paperSource}}" mode="scaleToFill" style="width:{{stageWidth}}px;height:{{1200 * scale}}px" />
      <view wx:for="{{renderElements}}" wx:key="id" class="journal-element {{item.id === selectedId ? 'element-selected' : ''}} {{item.type === 'photo' ? 'photo-element' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%;width:{{item.width}}%;height:{{item.height}}%;transform:rotate({{item.rotation}}deg);color:{{item.color}}" data-id="{{item.id}}" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd" catchtap="select">
        <view wx:if="{{item.type === 'photo'}}" class="photo-clip"><view wx:if="{{item.unreadable}}" class="photo-unreadable"><text>照片暂时无法读取</text><button class="text-button" data-id="{{item.id}}" catchtap="retryPhoto">重新载入</button></view><image wx:else src="{{item.src}}" mode="scaleToFill" class="element-photo" data-id="{{item.id}}" bindload="imageLoaded" binderror="imageFailed" style="position:absolute;width:{{item.imageW}}px;height:{{item.imageH}}px;left:{{item.imageX}}px;top:{{item.imageY}}px" /></view>
        <view wx:elif="{{item.type === 'text'}}" class="element-text {{item.font}}"><text wx:for="{{item.rows}}" wx:for-item="line" wx:key="index" class="text-line" style="top:{{line.y}}px;font-size:{{line.size}}px;font-weight:{{line.bold ? '600' : '400'}}">{{line.text}}</text></view>
        <view wx:elif="{{item.type === 'tape'}}" class="tape-decoration" style="background:{{item.color}}" />
        <image wx:else class="element-decoration" src="/assets/decorations/{{item.type}}.png" />
        <view wx:if="{{item.id === selectedId}}" class="selection-frame" /><view wx:if="{{item.id === selectedId}}" class="width-handle {{item.type !== 'text' ? 'size-handle' : ''}}" data-id="{{item.id}}" data-resize="yes" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd" />
      </view>
    </view><button class="editor-overview" catchtap="toggleOverview" aria-label="查看全页或聚焦元素"><image class="i" src="/assets/icons/scan.png" /></button></view><view class="stage-caption">{{backgroundSelected ? '已选：背景 · 下方选择纸色' : selectedName ? '已选：'+selectedName+' · 可拖动或调整大小' : '点选画布元素或背景；重叠时可打开图层'}}</view>
  </view>
  <scroll-view class="editor-controls" scroll-y bindscroll="onEditorScroll" style="height:{{controlsHeight}}px"><view class="editor-control-body"><view class="choice-row"><button bindtap="addPhoto" class="button-with-icon" hover-class="press-feedback" hover-start-time="0" hover-stay-time="70"><image class="inline-symbol" src="/assets/icons/plus.png"/><text>图片</text></button><button bindtap="addText" class="button-with-icon" hover-class="press-feedback" hover-start-time="0" hover-stay-time="70"><image class="inline-symbol" src="/assets/icons/plus.png"/><text>文字</text></button><button class="ai-button" bindtap="openAi">AI 写作</button></view><view class="choice-row"><button bindtap="background">背景</button><button bindtap="layoutRatio">纸张比例</button><button bindtap="chooseTemplate">选择版式</button></view><button class="text-button editor-record-entry" bindtap="openAiRecords">查看这份手帐的 AI建议记录</button><view class="tiny edit-history-hint">撤销与重做保存在本机，可跨次打开继续，最多保留20步。</view><view class="composition-summary"><view><text class="composition-name">{{composition}}</text><text class="muted">{{doc.ratio}} · 先预览再选版式，支持撤销</text></view><button class="secondary small-button" bindtap="changeStyle">更换风格</button></view><view class="selection-summary"><text class="selection-name">{{selectedName || '点选画布元素'}}</text><button class="secondary small-button" bindtap="openLayers">图层 · {{labels.length}}</button></view>
    <view wx:if="{{backgroundSelected}}" class="element-editor background-editor"><view class="strong">纸张与纹理</view><view class="paper-options"><button wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" bindtap="paper" class="{{(doc.paper || 'plain') === item.id ? 'active' : ''}}" aria-pressed="{{(doc.paper || 'plain') === item.id}}">{{item.name}}</button></view><view class="label">纸色</view><view class="paper-colors"><button wx:for="{{paperColors}}" wx:key="*this" data-color="{{item}}" bindtap="backgroundColor" aria-label="选择纸色 {{item}}" aria-pressed="{{doc.background === item}}" class="{{doc.background === item ? 'color-current' : ''}}"><view style="background:{{item}}" /><text>{{doc.background === item ? '当前颜色' : '选择'}}</text></button></view></view><view wx:if="{{selected}}" class="element-editor"><view class="row between"><text class="strong">{{selected.type === 'photo' ? '图片设置' : selected.type === 'text' ? '文字设置' : '装饰设置'}}</text><button class="danger-text" bindtap="remove">删除元素</button></view>
      <block wx:if="{{selected.type === 'text'}}"><view class="text-content-fields"><text class="label">标题</text><input value="{{selected.title}}" data-key="title" bindinput="text" bindblur="endTextEdit" placeholder="可留空，与正文属于同一文本框" /><text class="label">正文</text><textarea auto-height value="{{selected.text}}" data-key="text" bindinput="text" bindblur="endTextEdit" maxlength="-1" /><button class="ai-button wide text-ai-action" bindtap="openAi">为这个文本框生成建议</button></view><view class="value-row"><text>文字大小</text><view class="number-field"><input class="number-input" type="number" maxlength="3" value="{{numberEditing === 'fontSize' ? numberDrafts.fontSize : selected.fontSize}}" data-key="fontSize" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="fontSize" /><text class="number-unit">px</text></view></view><slider min="12" max="64" value="{{selected.fontSize}}" data-key="fontSize" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /></block>
      <view wx:if="{{selected.type === 'photo'}}" class="ratio-locks"><text class="label">画框比例</text><view class="lock-options"><button wx:for="{{ratioLocks}}" wx:key="id" class="{{ratioMode === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="lockRatio" aria-pressed="{{ratioMode === item.id}}">{{item.name}}</button></view></view><view wx:if="{{selected.type !== 'photo' && selected.type !== 'text'}}" class="ornament-lock"><button class="{{selected.ornamentRatioLocked ? 'active' : 'quiet'}} wide" bindtap="toggleOrnamentRatio" aria-pressed="{{selected.ornamentRatioLocked}}">{{selected.ornamentRatioLocked ? '原始比例已锁定 · 点击解锁' : '锁定装饰原始比例'}}</button></view><view class="value-row"><text>宽度</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'w' ? numberDrafts.w : pixels.w}}" data-key="w" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="图片或文字宽度，整数像素" /><text class="number-unit">px</text></view></view><slider min="{{maxWidth < 60 ? maxWidth : 60}}" max="{{maxWidth}}" value="{{selected.w}}" data-key="w" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" />
      <block wx:if="{{selected.type === 'photo'}}"><view class="value-row"><text>图片高度</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'h' ? numberDrafts.h : pixels.h}}" data-key="h" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="图片高度，整数像素" /><text class="number-unit">px</text></view></view><slider min="{{maxHeight < 60 ? maxHeight : 60}}" max="{{maxHeight}}" value="{{selected.h}}" data-key="h" step="1" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /><text class="label">画面如何适配画框</text><view class="choice-row"><button class="secondary {{selected.photoFit !== 'stretch' ? 'active' : ''}}" data-id="cover" bindtap="photoFit">裁剪填充</button><button class="secondary {{selected.photoFit === 'stretch' ? 'active' : ''}}" data-id="stretch" bindtap="photoFit">拉伸画面</button></view><view class="tiny crop-description">{{selected.photoFit === 'stretch' ? '宽高分别拉伸，可压扁或拉长画面；原图文件保留。' : '保持鸟体比例，调整画框会改变可见区域。'}}</view><button class="secondary wide crop-open" bindtap="openCrop">调整裁剪与取景</button></block>
      <view class="row between rotation-label"><view class="value-row"><text>旋转</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'rotation' ? numberDrafts.rotation : selected.rotation}}" data-key="rotation" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="rotation" /><text class="number-unit">°</text></view></view><button class="text-button reset-rotation" bindtap="resetRotation" disabled="{{selected.rotation === 0}}">归零 0°</button></view><slider min="-180" max="180" value="{{selected.rotation}}" data-key="rotation" step="0.01" data-control="slider" bindchanging="previewAdjust" bindchange="adjust" bindtouchcancel="cancelAdjustment" activeColor="#285b49" /><view class="choice-row"><button data-delta="-1" bindtap="layer">下移一层</button><button data-delta="1" bindtap="layer">上移一层</button></view>
    </view>
    <text class="label">添加装饰</text><view class="decoration-grid"><button wx:for="{{decorations}}" wx:key="id" data-id="{{item.id}}" bindtap="addDecoration"><image wx:if="{{item.id !== 'tape'}}" src="/assets/decorations/{{item.id}}.png" /><view wx:else class="tape-mini" /><text>{{item.name}}</text></button></view><button class="quiet wide spaced" loading="{{exporting}}" disabled="{{busy || exporting}}" bindtap="export">导出成品图</button><button wx:if="{{exportPath}}" class="primary wide spaced" bindtap="saveExport">保存成品到手机相册</button>
  </view></scroll-view>
</view>
<view wx:if="{{error}}" class="note error page-error {{view === 'editor' ? 'editor-error' : ''}}">{{error}}</view>
<view wx:if="{{ai && !aiHistoryOpen}}" class="modal-backdrop" catchtap="closeAi" catchtouchmove="holdSheet" />
<view wx:if="{{ai && !aiHistoryOpen}}" class="ai-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="journal0" catchtouchmove="holdSheet"><view class="handle"/><view class="row between"><view class="section-title">Qwen 手帐助手</view><button class="text-button ai-history-entry" bindtap="openAiHistory">AI建议记录</button><button class="icon-button" bindtap="closeAi" aria-label="关闭手帐助手"><image class="i" src="/assets/icons/close.png"/></button></view></view>
<scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journal0 || 240}}px"><view data-sheet-id="journal0" class="sheet-measure ai-sheet-body">
  <view class="label">这次写什么</view><button class="journal-choice journal-choice-purpose" data-key="purpose" bindtap="openJournalChoice"><view class="select-field">{{purposes[purpose]}}<view class="chevron"/></view></button>
  <view class="label">应用到哪里</view><view class="tiny">只决定建议放在哪里；生成后仍可切换，应用前会再次说明。</view><view class="ai-destinations"><button wx:for="{{aiDestinations}}" wx:key="id" class="{{aiDestination === item.id ? 'chosen-destination' : ''}}" data-id="{{item.id}}" disabled="{{item.id === 'selected' && !aiSelectedAvailable}}" bindtap="chooseAiDestination">{{item.name}}</button></view>
  <view class="ai-destination-help">{{aiDestination === 'new' ? '新增文字框：保留现有文字，添加一段独立正文。' : aiDestination === 'selected' ? '所选文本框：只改写你在画布上选中的文字。' : '页首概述：改写这一页开头的概述，手帐名称不变。'}}</view><view wx:if="{{aiDestination === 'selected'}}" class="ai-source">所选文字：{{selected.title}} {{selected.text}}</view>
  <button wx:if="{{aiDestination === 'new'}}" class="journal-choice journal-choice-placement" data-key="placement" bindtap="openJournalChoice"><view class="select-field">{{placements[placement]}}<view class="chevron"/></view></button>
  <button class="check-option" bindtap="aiTitle" aria-pressed="{{aiIncludeTitle}}"><view class="check-square"><image wx:if="{{aiIncludeTitle}}" class="check-symbol" src="/assets/icons/check.png"/></view>{{aiDestination === 'overview' ? '同时更新页首小标题（不改手帐名称）' : '同时应用建议小标题'}}</button>
  <view class="tiny ai-prompt-help">写作要求（选填）：有关联照片时，留空会根据照片写简短、自然的记录；也可填写你的具体想法。</view><view class="prompt-row"><textarea wx:if="{{inputMode === 'text'}}" auto-height maxlength="1800" value="{{prompt}}" bindinput="prompt" placeholder="例如：写两句照片说明，不猜鸟名，也不补写时间地点。"/><text wx:else class="tiny">语音补充写作要求</text><button class="input-toggle" bindtap="toggleInput" aria-label="切换文字或语音输入"><image class="i" src="/assets/icons/{{inputMode === 'text' ? 'mic' : 'journal'}}.png"/></button></view>
  <speech-note wx:if="{{inputMode === 'voice'}}" id="journal-speech" accepted-id="{{speechApplied}}" bindconfirm="confirmSpeech"/>
  <view class="row between"><view class="label">关联照片 · {{aiPhotoCount}}/4</view><button class="text-button" bindtap="aiPhotosAll">{{aiPhotoCount === aiPhotos.length ? '取消全选' : aiPhotos.length > 4 ? '选前4张' : '全选'}}</button></view>
  <view class="ai-photos"><button wx:for="{{aiPhotos}}" wx:key="id" class="ai-photo {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="aiPhoto" aria-pressed="{{item.selected}}"><image src="{{item.src}}" mode="aspectFill"/><text><image wx:if="{{item.selected}}" class="check-symbol" src="/assets/icons/check.png"/>{{item.label}}</text></button></view>
  <view class="note">只发送勾选照片的压缩副本与文字要求，原图保留。先预览，再决定如何应用。</view>
  <view wx:if="{{aiPhotoCount > 4 || error}}" class="ai-validation" role="alert"><view class="strong">{{aiPhotoCount > 4 ? '关联照片超出上限' : '写作建议尚未完成'}}</view><view>{{aiPhotoCount > 4 ? '每次最多关联4张照片，请取消多余照片后再生成。' : error}}</view></view>
  <view wx:if="{{bundleSummary}}" class="note">{{bundleSummary}}</view><view wx:if="{{aiHistoryNotice}}" class="note">{{aiHistoryNotice}}</view>
  <button class="ai-button wide" loading="{{aiBusy}}" disabled="{{aiBusy || aiPhotoCount > 4}}" bindtap="prepareAi">{{aiBusy ? '正在生成，关闭可取消' : aiPhotoCount > 4 ? '请先减少关联照片' : '生成写作建议'}}</button>
  <view wx:if="{{aiSuggestion}}" class="ai-result"><view class="label">建议内容（可直接修改）</view><input maxlength="40" value="{{aiSuggestion.title}}" data-key="title" bindinput="editAiSuggestion" placeholder="建议小标题"/><textarea class="ai-result-editor" auto-height maxlength="600" value="{{aiSuggestion.body}}" data-key="body" bindinput="editAiSuggestion"/>
    <view wx:for="{{aiCaptionPreviews}}" wx:key="id" class="ai-caption-preview"><text>{{item.label}}</text><textarea auto-height maxlength="80" value="{{item.text}}" data-id="{{item.id}}" bindinput="editAiCaption"/></view>
    <button wx:if="{{aiCaptionPreviews.length}}" class="check-option" bindtap="aiCaptions" aria-pressed="{{aiIncludeCaptions}}"><view class="check-square"><image wx:if="{{aiIncludeCaptions}}" class="check-symbol" src="/assets/icons/check.png"/></view>同时更新所选照片的说明文字</button>
    <view wx:if="{{purpose === 3 && !aiCaptionPreviews.length}}" class="note">本次建议未返回逐图说明，可先应用概述。</view>
    <view class="ai-target-summary">{{aiTargetLabel}}</view><view class="muted">请核对观察事实。应用后可撤销，手帐名称保持不变。</view>
    <button class="primary wide spaced" bindtap="applyAi">应用文字到上述位置</button><button class="quiet wide spaced" data-design="yes" bindtap="applyAi">应用文字与建议构图</button>
  </view>
</view></scroll-view></view>
<view wx:if="{{aiHistoryOpen}}" class="writing-history-backdrop" catchtap="closeAiHistory" catchtouchmove="holdSheet"/>
<view wx:if="{{aiHistoryOpen}}" class="writing-history-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="journal1" catchtouchmove="holdSheet"><view class="handle"/><view class="row between"><view class="section-title">这份手帐的AI建议记录</view><button class="icon-button" bindtap="closeAiHistory"><image class="i" src="/assets/icons/close.png"/></button></view></view><scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journal1 || 240}}px"><view data-sheet-id="journal1" class="sheet-measure writing-history-body"><view class="tiny">这里保留每次生成时的要求和AI建议。载入只放回预览，不改手帐，也不会重新生成。撤销与重做用来恢复编辑步骤，和这里的建议记录分开。</view><view wx:if="{{!aiHistory.length}}" class="empty">这份手帐还没有成功生成的AI建议。生成成功后会自动保存在这里；旧版本未保存的结果无法补回。</view><view wx:for="{{aiHistory}}" wx:key="id" class="writing-history-card"><view class="tiny">{{item.dateLabel}} · {{item.purpose}} · {{item.applied ? '已应用' : '未应用'}}</view><view class="strong">{{item.suggestion.title}}</view><view class="history-prompt">{{item.displayPrompt}}</view><view class="history-answer">{{item.suggestion.body}}</view><view class="row"><button data-id="{{item.id}}" bindtap="restoreAiHistory">载入建议</button><button class="text-button" data-id="{{item.id}}" bindtap="deleteAiHistory">删除记录</button></view></view></view></scroll-view></view>
<view wx:if="{{cropOpen}}" class="modal-backdrop" catchtap="cancelCrop"  catchtouchmove="holdSheet" />
<view wx:if="{{cropOpen}}" class="crop-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="journal2" catchtouchmove="holdSheet">
  <view class="handle" /><view class="row between"><view class="section-title">让画面刚好合适</view><button class="icon-button" bindtap="cancelCrop" aria-label="取消裁剪"><image class="i" src="/assets/icons/close.png" /></button></view></view><scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journal2 || 240}}px"><view data-sheet-id="journal2" class="sheet-measure crop-sheet-body">
  <view class="muted">只调整框内显示；取消会保留原裁剪。</view>
  <view class="crop-preview-window" style="width:{{cropPreview.width}}px;height:{{cropPreview.height}}px"><image src="{{cropDraft.src}}" data-id="{{cropDraft.id}}" bindload="imageLoaded" mode="scaleToFill" style="position:absolute;width:{{cropPreview.imageW}}px;height:{{cropPreview.imageH}}px;left:{{cropPreview.imageX}}px;top:{{cropPreview.imageY}}px" /></view>
<view class="value-row"><text>放大</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'zoom' ? numberDrafts.zoom : cropDraft.zoom}}" data-key="zoom" data-scope="crop" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="zoom" /><text class="number-unit">×</text></view></view><slider min="1" max="3" step="0.01" value="{{cropDraft.zoom}}" data-key="zoom" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" />
<view class="value-row"><text>左右取景</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropX' ? numberDrafts.cropX : cropDraft.cropX}}" data-key="cropX" data-scope="crop" disabled="{{!cropPreview.canPanX}}" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropX" /><text class="number-unit">%</text></view></view><slider min="0" max="100" step="0.01" value="{{cropDraft.cropX}}" data-key="cropX" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" disabled="{{!cropPreview.canPanX}}" />
<view class="value-row"><text>上下取景</text><view class="number-field"><input class="number-input" type="text" maxlength="16" value="{{numberEditing === 'cropY' ? numberDrafts.cropY : cropDraft.cropY}}" data-key="cropY" data-scope="crop" disabled="{{!cropPreview.canPanY}}" bindinput="numberInput" bindblur="numberCommit" bindconfirm="numberCommit" confirm-type="done" aria-label="cropY" /><text class="number-unit">%</text></view></view><slider min="0" max="100" step="0.01" value="{{cropDraft.cropY}}" data-key="cropY" data-control="slider" bindchanging="previewCrop" bindchange="finishCropPreview" activeColor="#285b49" disabled="{{!cropPreview.canPanY}}" />
<view class="tiny">放大后可以获得更多移动范围。</view><button class="text-button crop-reset" bindtap="resetCrop">重置裁剪</button><view class="choice-row crop-actions"><button class="quiet" bindtap="cancelCrop">取消</button><button class="primary" bindtap="applyCrop">确认裁剪</button></view>
</view></scroll-view></view>
<canvas id="journal-export" type="2d" class="export-canvas" />

<view wx:if="{{layersOpen}}" class="modal-backdrop" catchtap="closeLayers"  catchtouchmove="holdSheet" />
<view wx:if="{{layersOpen}}" class="layer-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="journal3" catchtouchmove="holdSheet"><view class="handle" /><view class="row between"><view class="section-title">选择图层</view><button class="icon-button" bindtap="closeLayers" aria-label="关闭图层"><image class="i" src="/assets/icons/close.png" /></button></view></view><scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journal3 || 240}}px"><view data-sheet-id="journal3" class="sheet-measure layer-sheet-body"><view class="muted">点选后返回画布，可选择被其他元素遮住的图层。</view><button class="layer-option {{backgroundSelected ? 'layer-current' : ''}}" bindtap="background">背景</button><button wx:for="{{labels}}" wx:key="id" class="layer-option {{item.id === selectedId ? 'layer-current' : ''}}" data-id="{{item.id}}" bindtap="select" aria-pressed="{{item.id === selectedId}}"><text>{{item.label}}</text><text class="layer-state">{{item.id === selectedId ? '已选择' : '选择'}}</text></button></view></scroll-view></view>

<canvas type="2d" id="journal-ai-canvas" class="export-canvas" />

<view wx:if="{{templateOpen}}" class="modal-backdrop" catchtap="closeTemplates"  catchtouchmove="holdSheet" />
<view wx:if="{{templateOpen}}" class="template-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="journal4" catchtouchmove="holdSheet"><view class="handle" /><view class="row between"><view class="section-title">选一个讲故事的版式</view><button class="icon-button" bindtap="closeTemplates" aria-label="关闭版式"><image class="i" src="/assets/icons/close.png" /></button></view></view><scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journal4 || 240}}px"><view data-sheet-id="journal4" class="sheet-measure template-sheet-body"><view class="subtitle">使用当前照片预览。原图、文字和裁剪保留；选择后可以撤销。</view><view class="template-options"><button wx:for="{{templateOptions}}" wx:key="id" class="template-option {{doc.variant === item.id ? 'template-current' : ''}}" data-id="{{item.id}}" bindtap="applyTemplate" aria-pressed="{{doc.variant === item.id}}"><view class="template-mini" style="width:{{templateWidth}}px;height:{{templateWidth * doc.height / doc.width}}px;background:{{doc.background}}"><view class="template-heading">{{doc.title}}</view><view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="index" class="template-photo" style="{{photo.style}}"><image src="{{photo.src}}" mode="scaleToFill" style="{{photo.imageStyle}}" /></view></view><text>{{item.name}}</text><view class="template-state">{{doc.variant === item.id ? '当前版式' : '使用这个版式'}}</view></button></view></view></scroll-view></view>

<canvas id="journal-thumbnail-export" type="2d" class="export-canvas" aria-hidden="true"/>

<view wx:if="{{shareOpen}}" class="modal-backdrop" catchtap="closeShare" catchtouchmove="holdSheet"/>
<view wx:if="{{shareOpen}}" class="journal-share sheet-frame sheet-enter" aria-role="dialog" aria-label="分享手帐">
  <view class="sheet-header-fixed" data-sheet-id="journalShare" catchtouchmove="holdSheet"><view class="handle"/><view class="row between"><view class="section-title">分享这一页</view><button class="icon-button" bindtap="closeShare" aria-label="关闭分享"><image class="i" src="/assets/icons/close.png"/></button></view></view>
  <scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.journalShare || 360}}px"><view class="sheet-measure journal-share-body" data-sheet-id="journalShare">
    <view class="journal-share-summary"><image wx:if="{{shareBitmap}}" class="journal-share-bitmap" style="width:{{sharePreviewWidth}}px;height:{{sharePreviewHeight}}px" src="{{shareBitmap}}" mode="aspectFit" binderror="sharePreviewFailed"/><view wx:elif="{{sharePreview}}" class="share-page" style="width:{{sharePreview.width}}px;height:{{sharePreview.height}}px;background:{{sharePreview.background}}"><image wx:if="{{sharePreview.paper}}" class="share-paper-texture" src="{{sharePreview.paper}}" mode="scaleToFill"/><view wx:for="{{sharePreview.elements}}" wx:key="id" class="share-page-part" style="{{item.style}};color:{{item.color}}"><view wx:if="{{item.type === 'photo'}}" class="share-photo-clip"><image src="{{item.src}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view><view wx:elif="{{item.type === 'text'}}" class="share-text {{item.font}}"><text wx:for="{{item.rows}}" wx:for-item="line" wx:key="index" style="{{line.style}}">{{line.text}}</text></view><view wx:elif="{{item.type === 'tape'}}" class="share-tape"/><image wx:else class="share-decoration" src="{{item.src}}"/></view></view><view class="journal-share-copy"><view class="strong">{{shareTitle}}</view><view class="tiny">{{shareRatio}} · 整页成品</view><view class="tiny">可编辑原件保留在手帐中</view></view></view>
    <button class="journal-share-option" disabled="{{exporting}}" data-destination="0" bindtap="chooseShare" hover-class="press-feedback"><view class="share-option-icon"><image src="/assets/icons/image.png"/></view><view><text>保存到相册</text><text class="tiny">PNG整页图片</text></view><image class="share-option-arrow" src="/assets/icons/arrow.png"/></button>
    <button class="journal-share-option" disabled="{{exporting}}" data-destination="1" bindtap="chooseShare" hover-class="press-feedback"><view class="share-option-icon"><image src="/assets/icons/journal.png"/></view><view><text>分享讨论</text><text class="tiny">加入帖子草稿，预览后发布</text></view><image class="share-option-arrow" src="/assets/icons/arrow.png"/></button>
    <button class="journal-share-option" disabled="{{exporting}}" data-destination="2" bindtap="chooseShare" hover-class="press-feedback"><view class="share-option-icon"><image src="/assets/icons/chat.png"/></view><view><text>微信分享</text><text class="tiny">打开系统图片分享</text></view><image class="share-option-arrow" src="/assets/icons/arrow.png"/></button>
    <view wx:if="{{exporting || shareStatus}}" class="tiny share-status" aria-live="polite">{{exporting ? '正在准备成品图…' : shareStatus}}</view><view wx:if="{{shareError}}" class="note error">{{shareError}}</view>
  </view></scroll-view>
</view>

<choice-sheet open="{{filterOpen}}" title="{{filterTitle}}" options="{{filterOptions}}" selected="{{filterSelected}}" bindchange="chooseJournalChoice" bindclose="closeJournalChoice"/>
<date-calendar open="{{calendarOpen}}" from="{{calendarFrom}}" to="{{calendarTo}}" bindchange="calendarChange" bindclose="closeCalendar"/>

<view wx:if="{{libraryToolsOpen}}" class="modal-backdrop" catchtap="closeLibraryTools" catchtouchmove="holdSheet"/><view wx:if="{{libraryToolsOpen}}" class="library-tools-sheet sheet-frame"><view class="sheet-header-fixed" data-sheet-id="libraryFilters"><view class="row between"><text class="strong">查找与筛选</text><button class="sheet-close" bindtap="closeLibraryTools" aria-label="关闭手帐筛选"><image class="close-icon" src="/assets/icons/close.png"/></button></view></view><scroll-view scroll-y class="sheet-scroll" style="height:{{sheetHeights.libraryFilters || 250}}px"><view class="sheet-measure library-tools-body" data-sheet-id="libraryFilters">  <input class="library-search" value="{{libraryText}}" bindinput="librarySearch" placeholder="搜索手帐名称" confirm-type="search" />
  <view class="library-filters"><button class="journal-choice journal-choice-libraryOrder" data-key="libraryOrder" bindtap="openJournalChoice"><view class="library-filter">{{libraryOrders[libraryOrder]}}</view></button><button class="journal-choice journal-choice-libraryRatio" data-key="libraryRatio" bindtap="openJournalChoice"><view class="library-filter">{{libraryRatios[libraryRatio]}}</view></button><button class="text-button" bindtap="clearLibraryFilters">重置</button></view>
  <view class="library-dates"><button class="date-range-trigger" data-target="library" bindtap="openCalendar">{{libraryFrom || '开始日期'}}</button><text>—</text><button class="date-range-trigger" data-target="library" bindtap="openCalendar">{{libraryTo || '结束日期'}}</button></view>
</view></scroll-view></view>
