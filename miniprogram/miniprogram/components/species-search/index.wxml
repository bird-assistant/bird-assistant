<view class="search-shell"><view class="search-field"><image class="search-icon" src="/assets/icons/search.png"/><input class="search-input" value="{{query}}" placeholder="{{placeholder}}" bindinput="input" bindconfirm="search" maxlength="80" confirm-type="search"/><button wx:if="{{query}}" class="search-clear" bindtap="clear" aria-label="清空鸟种搜索"><image class="inline-symbol" src="/assets/icons/close.png"/></button></view>
<view wx:if="{{query && (matches.length || searching || searchError)}}" class="search-panel {{above ? 'search-panel-above' : ''}}"><view class="search-heading"><text>{{searching && !matches.length ? '正在查找…' : '选择鸟种'}}</text><button class="search-close" bindtap="close" aria-label="收起鸟种搜索"><image class="inline-symbol" src="/assets/icons/close.png"/></button></view><scroll-view class="search-scroll" scroll-y style="height:{{listHeight}}px" bindscrolltolower="more"><button wx:for="{{matches}}" wx:key="id" class="search-option" data-id="{{item.id}}" bindtap="select"><view class="search-copy"><text class="option-name">{{item.name || item.english || item.scientific}}</text><text class="option-latin">{{item.scientific}}</text></view><text wx:if="{{item.chosen}}" class="option-action">已选</text><image wx:else class="check-symbol" src="/assets/icons/plus.png"/></button><view wx:if="{{searchError}}" class="search-message">{{searchError}}<button class="search-retry" bindtap="search">重试</button></view><button wx:elif="{{searchMore}}" class="search-more" bindtap="more" disabled="{{searching}}">{{searching ? '加载中…' : '加载更多'}}</button></scroll-view></view></view>
