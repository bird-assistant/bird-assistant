<app-header title="{{view === 'live' ? '羽迹' : view === 'import' ? '导入识别' : '素材复核'}}" back="{{view !== 'live'}}" bindback="back" />
<view wx:if="{{view === 'live'}}" class="live-screen" style="height:{{height}}px">
  <view class="viewfinder"><camera wx:if="{{demo ? false : !paused}}" class="native-camera" device-position="back" flash="off" resolution="medium" frame-size="small" bindinitdone="cameraReady" binderror="cameraError" bindstop="cameraStopped" />
    <image wx:if="{{demo}}" src="/assets/samples/live-scene.png" class="demo-scene" mode="aspectFill" style="transform:scale({{zoom}})" /><view class="view-tags"><text>{{demo ? '示例取景 · 非真实识别' : '实时取景 · 识别服务待接入'}}</text><button bindtap="demo">{{demo ? '使用相机' : '查看示例'}}</button></view>
    <view wx:if="{{demo ? !paused : false}}" class="bird-box"><text>树麻雀 86%</text><view class="corner tl" /><view class="corner tr" /><view class="corner bl" /><view class="corner br" /></view>
    <view wx:if="{{paused || cameraError}}" class="camera-cover"><view class="camera-cover-heading"><image class="i" src="/assets/icons/camera.png" /><text class="strong">{{paused ? '取景已暂停' : '相机暂不可用'}}</text></view><text class="camera-cover-copy">{{paused ? '需要时恢复取景，继续留下线索' : cameraError}}</text><view class="camera-cover-actions"><button bindtap="resumeOrDemo">{{paused ? '恢复取景' : '查看取景示例'}}</button><button class="quiet" bindtap="import">导入素材</button></view></view>
  </view>
  <view class="live-mode"><view class="segments"><button class="{{mode === 'quick' ? 'on' : ''}}" data-id="quick" bindtap="mode">快速识别</button><button class="{{mode === 'wait' ? 'on' : ''}}" data-id="wait" bindtap="mode">等候模式</button></view><button class="pause-button" bindtap="pause" aria-label="暂停或恢复取景"><image class="i" src="/assets/icons/{{paused ? 'video' : 'minus'}}.png" /></button></view>
  <button class="mode-caption" bindtap="help">{{mode === 'quick' ? '快速模式久用可能发热 · 查看建议' : '长时间观鸟，用等候模式 · 查看说明'}}</button>
  <view wx:if="{{help}}" class="mode-advice"><view class="strong">长时间观鸟，建议切换等候模式</view><view>持续取景和分析可能增加发热与耗电，手机可能变慢。必要时可暂停取景；实际抽帧策略待后端与真机验证。</view><button data-id="wait" bindtap="mode">切换等候模式</button></view>
  <view class="live-bottom"><view wx:if="{{!paused && !cameraError}}" class="zoom-control {{zoomEnabled ? '' : 'zoom-disabled'}}">
    <view class="zoom-presets"><button class="zoom-step" data-delta="-0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom <= 1}}" aria-label="缩小 0.1 倍">−</button><view class="zoom-preset-list"><button wx:for="{{zoomShortcuts}}" wx:key="value" class="zoom-preset {{zoom === item.value ? 'zoom-selected' : ''}}" data-zoom="{{item.value}}" bindtap="zoom" disabled="{{!zoomEnabled}}">{{item.label}}</button></view><button class="zoom-step" data-delta="0.1" bindtap="zoomNudge" disabled="{{!zoomEnabled || zoom >= (demo ? 5 : maxZoom)}}" aria-label="放大 0.1 倍">＋</button></view>
    <view class="zoom-scale" catchtouchstart="zoomStart" catchtouchmove="zoomMove" catchtouchend="zoomEnd" catchtouchcancel="zoomEnd" aria-label="左右滑动调整变焦，当前 {{zoomText}} 倍"><view class="zoom-readout">{{zoomText}}<text>×</text></view><view class="zoom-track"><view class="zoom-axis" /><view wx:for="{{zoomTicks}}" wx:key="id" class="zoom-tick {{item.major ? 'zoom-major' : ''}}" style="left:calc(50% + {{item.offset}}px)"><view class="zoom-tick-line" /><text wx:if="{{item.major}}">{{item.label}}</text></view><view class="zoom-centre" /></view></view>
    <view class="zoom-range">{{zoomRange}}{{zoomEnabled ? ' · 滑动刻度，± 微调' : ''}}</view>
  </view>
    <view class="clue-panel"><view class="clue-tabs"><button class="{{focus === 'visual' ? 'on' : ''}}" data-id="visual" bindtap="focus"><image class="i" src="/assets/icons/scan.png" />画面线索</button><button class="{{focus === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="focus"><image class="i" src="/assets/icons/mic.png" />声音线索<view class="audio-dot {{audio ? '' : 'off'}}" /></button><button class="expand-button" bindtap="expand" aria-label="展开或收起线索"><view class="chevron {{expanded ? 'up' : ''}}" /></button></view>
      <view class="clue-summary"><text class="strong">{{focus === 'visual' ? (demo ? '树麻雀 · 86%' : '等待识别服务接入') : (audio ? '声音线索待接入' : '声音线索已暂停')}}</text><text class="tiny">{{demo ? '示例匹配度，非正确率' : '可先拍摄或导入，稍后辨认'}}</text></view>
      <view wx:if="{{expanded}}" class="clue-detail"><block wx:if="{{focus === 'audio'}}"><view>声音单独分析，不直接替画面下结论。</view><view class="row spaced"><button bindtap="toggleAudio">{{audio ? '暂停声音线索' : '开启声音线索'}}</button><button disabled="{{!audio}}" bindtap="recordAudio">{{audioRecording ? '停止并保留' : '留鸟鸣'}}</button></view></block><text wx:else>匹配分数不代表正确概率；切换展示不关闭声音识别。当前没有向服务器发送画面。</text></view>
    </view>
    <view class="capture-row"><button class="capture-side" bindtap="import"><image class="capture-icon" src="/assets/icons/image.png" /><text>相册 / 文件</text></button><button class="shutter {{recording ? 'video-recording' : ''}}" disabled="{{paused || busy}}" bindtouchstart="shutterStart" bindtouchend="shutterEnd" bindtouchcancel="shutterCancel" bindtap="shutterPhoto" aria-label="轻触拍照，长按录像"><view /></button><button class="capture-side" bindtap="review"><view class="evidence-count">{{assets.length}}</view><text>复核素材</text></button></view><view class="capture-hint">{{recording ? '正在录像 '+recordSeconds+' 秒 · 松开结束' : '轻触拍照，长按录像'}}</view>
  </view>
</view>
<view wx:elif="{{view === 'import'}}" class="page {{focusedPage ? 'focused-page' : ''}}"><view class="eyebrow">先拍下来，也可以稍后辨认</view><view class="title">导入识别</view><view class="subtitle">保留系统相机拍摄的原件。导入不改动设备文件。</view><view class="segments"><button class="{{importKind === 'gallery' ? 'on' : ''}}" data-id="gallery" bindtap="importKind">照片 / 视频</button><button class="{{importKind === 'audio' ? 'on' : ''}}" data-id="audio" bindtap="importKind">音频文件</button></view><button class="import-drop" loading="{{picking}}" disabled="{{picking}}" bindtap="chooseFiles"><image src="/assets/icons/{{importKind === 'audio' ? 'mic' : 'image'}}.png" /><text class="strong">{{importKind === 'audio' ? '选择音频文件' : '从设备选择照片或视频'}}</text><text class="tiny">{{importKind === 'audio' ? 'MP3 · WAV · AAC · M4A / MP4 · OGG' : '照片与视频 · 保留原件'}}</text></button><view class="tiny">{{importKind === 'audio' ? '以上音频格式可保留原件。OGG 目前仅支持本机保留；识别服务尚未开放。' : '照片与视频保留设备原件。识别服务尚未开放，可先私人保存。'}}</view><button wx:if="{{importKind === 'gallery'}}" class="quiet wide spaced" data-source="album" bindtap="choose">单张照片入口</button><view class="divider" /><view class="muted">没有文件？先用明确标注的示例体验</view><button class="small-button spaced" bindtap="addSample">添加图片示例</button><view class="row between section-title"><text>本次素材 · {{assets.length}}</text><button class="primary small-button" bindtap="review">复核所选素材</button></view><view class="note">拍摄时间、地点未知时保持未知，不套用当前天气或位置。</view></view>
<view wx:else class="page {{focusedPage ? 'focused-page' : ''}}"><view class="title">留下这次发现</view><view class="subtitle">确认素材，补充感想。保存默认只对自己可见。</view><scroll-view scroll-x class="evidence-strip"><view wx:for="{{assets}}" wx:key="id" class="evidence-item {{currentId === item.id ? 'evidence-selected' : ''}}"><button data-id="{{item.id}}" bindtap="selectEvidence"><image wx:if="{{item.kind === 'photo'}}" src="{{item.path}}" mode="aspectFill" /><view wx:else class="media-icon-box"><image class="media-icon" mode="aspectFit" src="/assets/icons/{{item.kind === 'audio' ? 'mic' : 'video'}}.png" /></view><text>{{item.sample ? '示例插画' : item.kind === 'photo' ? '照片' : item.kind === 'video' ? '视频' : '音频'}}</text></button><button class="evidence-remove" data-id="{{item.id}}" bindtap="removeEvidence" aria-label="移除素材">×</button></view></scroll-view>
  <view wx:if="{{!assets.length}}" class="empty">还没有保留素材。<view>可返回取景，或导入已有照片、视频和声音。</view></view><block wx:if="{{imagePath}}"><image wx:if="{{mediaKind === 'photo'}}" class="review-photo" src="{{imagePath}}" mode="aspectFit" bindtap="preview" /><video wx:elif="{{mediaKind === 'video'}}" class="review-photo" src="{{imagePath}}" controls /><button wx:else class="wide spaced" bindtap="preview">回听所选音频</button><view class="row between"><text class="muted">{{albumStatus}}</text><button wx:if="{{source === 'camera'}}" class="text-button" bindtap="retryAlbum">重试保存相册</button></view><text class="label">识别线索</text><button class="quiet wide" bindtap="analyse">分析所选素材</button><view class="note">识别服务尚未接入，没有实际分析或候选分数。可先保留为待鉴定。</view><text class="label">鸟名（可留空）</text><input value="{{birdName}}" bindinput="changeName" disabled="{{busy}}" placeholder="待鉴定，或填写你判断的鸟名" /><text class="label">观察笔记</text><textarea auto-height value="{{notes}}" bindinput="changeNotes" disabled="{{busy}}" placeholder="发生了什么？有什么想留下的？" />
    <view class="observation-context">
      <button class="context-toggle" bindtap="toggleContext" disabled="{{busy}}" aria-label="补充或收起观察时间与地点">
        <view class="context-heading"><text class="strong">观察时间与地点 · 可选</text><text class="tiny">{{observedDate || '时间未知'}}{{observedTime ? ' '+observedTime : ''}} · {{placeName || '地点未填写'}}</text></view><text class="context-toggle-label">{{contextOpen ? '收起' : '补充'}}</text>
      </button>
      <view wx:if="{{contextOpen}}" class="context-fields">
        <view class="context-pickers">
          <view><text class="context-label">观察日期</text><picker mode="date" value="{{observedDate || today}}" end="{{today}}" disabled="{{busy}}" data-key="observedDate" bindchange="changeContext"><view class="context-field">{{observedDate || '日期未知 · 选择'}}</view></picker></view>
          <view><text class="context-label">时刻（可选）</text><picker mode="time" value="{{observedTime || '12:00'}}" disabled="{{busy || !observedDate}}" data-key="observedTime" bindchange="changeContext"><view class="context-field {{observedDate ? '' : 'context-disabled'}}">{{observedTime || '时刻未知'}}</view></picker></view>
        </view>
        <view wx:if="{{observedDate}}" class="context-clear"><button wx:if="{{observedTime}}" class="text-button" bindtap="clearObservedTime" disabled="{{busy}}">仅保留日期</button><button class="text-button" bindtap="clearObservedDate" disabled="{{busy}}">清除观察时间</button></view>
        <text class="label">观察地点</text><input value="{{placeName}}" data-key="placeName" bindinput="changeContext" maxlength="80" disabled="{{busy}}" placeholder="公园或区域名称（可留空）" />
        <view class="tiny context-help">时间按北京时间填写；不确定可留空。保存时间不会代替观察时间。</view>
      </view>
    </view>
    <button class="primary wide spaced" loading="{{busy}}" disabled="{{busy || picking}}" bindtap="save">保存私人观察到本机</button></block><view class="choice-row"><button bindtap="back">继续取景</button><button bindtap="import">再导入素材</button></view>
</view>
<view wx:if="{{error}}" class="recognition-error">{{error}}</view>
