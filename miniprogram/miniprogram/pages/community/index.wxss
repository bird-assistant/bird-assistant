.post-card{padding:16px;background:#fffef9;border:1px solid #e1e7d9;border-radius:15px;margin:18px 0}.author-avatar{display:flex;align-items:center;justify-content:center;background:#e6eddb;border-radius:50%;width:39px;height:39px;flex-shrink:0;font-size:11px;color:#59724e}.post-title{font-size:17px;line-height:1.6;font-weight:600;margin:17px 0 8px}.post-body{font-size:13px;line-height:1.9;white-space:pre-wrap;color:#6c7c65;margin:10px 0 14px}.post-photo{width:100%;height:190px;border-radius:10px;background:#e6eddb}.art-caption{text-align:right;font-size:9px;margin-top:3px}.post-actions{display:flex;justify-content:space-between;gap:7px;margin-top:9px}.post-actions button{display:flex;align-items:center;gap:5px;background:none;font-size:11px;color:#7b8972;padding:8px 0;min-height:40px}.post-actions .i{width:18px;height:18px;opacity:.7}.post-actions .is-on{color:#285b49;font-weight:600}.post-detail-title{font-size:26px;margin:25px 0 15px}.reply{padding:14px 0;border-bottom:1px solid #dfe7d8;font-size:13px;line-height:1.9}.reply .strong{font-size:12px;margin-bottom:4px}
.compose-body{min-height:112px;line-height:1.8}.post-writing-entry{min-height:44px}
.post-writing-sheet{position:fixed;z-index:150;bottom:0;left:0;right:0;width:100%;height:78vh;background:#fafbf5;border-radius:22px 22px 0 0;overflow:hidden}
.post-writing-body{padding:10px 19px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box}
.post-writing-body .section-title{font-size:17px;margin:8px 0}.post-writing-body .muted{font-size:12px;line-height:1.8}.post-writing-body textarea{min-height:90px;line-height:1.8}
.writing-image-option{display:flex;align-items:center;justify-content:flex-start;gap:10px;width:100%;min-height:64px;margin-top:14px;padding:10px;background:#edf3e7;font-size:12px;text-align:left}
.writing-image-option image{width:44px;height:44px;flex:none;border-radius:7px}.writing-checkbox{width:19px;height:19px;flex:none;display:flex;align-items:center;justify-content:center;border:1px solid #a8bba0;border-radius:4px;background:#fffef9;color:#285b49}
.writing-summary{padding:14px;background:#eef2e8;border:1px solid #d6e0ce;border-radius:12px;color:#385b43;font-size:12px;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}
