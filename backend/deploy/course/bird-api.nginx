location ^~ /api/v1/journal/ {
    client_max_body_size 6m;
    proxy_pass http://127.0.0.1:8200;
}
location = /api/v1/vision/auth/wechat {
    proxy_pass http://127.0.0.1:8200;
}
location = /api/v1/observations {
    proxy_pass http://127.0.0.1:8200;
}
location ^~ /api/v1/observations/ {
    proxy_pass http://127.0.0.1:8200;
}
location = /api/v1/vision/readyz {
    proxy_pass http://127.0.0.1:18000/readyz;
}
location = /api/v1/vision/analyses {
    client_max_body_size 7m;
    proxy_pass http://127.0.0.1:18000;
}
location = /api/v1/vision/sessions {
    proxy_pass http://127.0.0.1:18000;
}
location ^~ /api/v1/vision/sessions/ {
    client_max_body_size 7m;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
    proxy_pass http://127.0.0.1:18000;
}
