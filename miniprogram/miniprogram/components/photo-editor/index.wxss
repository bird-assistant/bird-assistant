.photo-editor{margin:16px 0;border:1px solid #dce5d5;border-radius:15px;background:#f3f6ed;overflow:hidden}.details-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:64px;padding:12px 14px;background:transparent;text-align:left;color:#285b49}.details-toggle::after{border:0}.details-toggle>view:first-child{display:flex;flex-direction:column;gap:4px}.details-title{font-size:14px;font-weight:600}.details-note{font-size:11px;color:#7d8f72}.details-chevron{width:8px;height:8px;border-right:1.7px solid #6d8564;border-bottom:1.7px solid #6d8564;transform:rotate(45deg);transition:transform .2s}.details-chevron.opened{transform:rotate(225deg)}.details-fields{padding:0 14px 14px;animation:details-arrive .18s ease-out}.details-policy{display:block;font-size:11px;color:#7d8f72;line-height:1.7;margin-bottom:10px}.details-field{display:flex;align-items:center;gap:10px;border-top:1px solid #e1e8da;min-height:46px}.details-field>text{width:78px;flex:none;font-size:12px;color:#697d5e}.details-field>input{flex:1;min-width:0;height:42px;font-size:13px;color:#285b49}@keyframes details-arrive{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.details-fields{animation:none}}
