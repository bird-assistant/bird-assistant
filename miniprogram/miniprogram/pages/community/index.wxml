<app-header title="{{view === 'feed' ? '羽迹' : '写一篇帖子'}}" back="{{view !== 'feed'}}" bindback="back" />
<view class="page {{focusedPage ? 'focused-page' : ''}}"><block wx:if="{{view === 'feed'}}"><view class="eyebrow">发现，也可以一起分享</view><view class="title">鸟友讨论</view><view class="subtitle">一条鸟讯，一个问题，一段观察故事。</view><button class="wide" bindtap="compose">＋ 写一篇帖子</button><view class="choice-row"><button data-screen="friends" bindtap="section">找鸟友</button><button data-screen="inbox" bindtap="section">消息</button><button data-screen="groups" bindtap="section">群聊</button></view><button class="text-button spaced" bindtap="loadDraft">继续本机草稿</button>
  <view class="choice-row"><button data-screen="library" bindtap="section">鸟种资料库</button><button data-screen="external" bindtap="section">外部鸟讯</button><button data-screen="mine" bindtap="section">我的发布</button></view>
  <view wx:for="{{remotePosts}}" wx:key="id" class="post-card" data-id="{{item.id}}" data-screen="record" bindtap="section"><view class="tiny">{{item.publicName}} · {{item.date || '鸟友讨论'}}</view><view class="post-title">{{item.title}}</view><view class="post-body">{{item.body}}</view><image wx:if="{{item.image}}" class="post-photo" src="{{item.image}}" mode="aspectFill"/></view>
  <view wx:if="{{!remotePosts.length && !feedLoading && !error}}" class="tiny spaced">还没有已公开的帖子。</view><button loading="{{feedLoading}}" bindtap="refreshFeed">刷新讨论</button><button wx:if="{{more}}" bindtap="nextPage">更多帖子</button>
</block>
<block wx:else><view class="title">把发现分享给鸟友</view><view class="subtitle">公开发布与私人观察分别管理。</view><text class="label">标题</text><input value="{{title}}" data-key="title" bindinput="change" placeholder="给这次发现一个标题" /><text class="label">内容</text><textarea class="compose-body" auto-height value="{{body}}" data-key="body" bindinput="change" maxlength="-1" placeholder="一段观察、一点疑问，或你的感想…" /><button class="ai-button wide spaced post-writing-entry" bindtap="openWriting">✧ AI 辅助写作</button><image wx:if="{{image}}" src="{{image}}" class="post-photo spaced" mode="aspectFill" /><button class="quiet wide spaced" bindtap="attach">＋ 添加照片</button><view class="choice-row"><button bindtap="saveDraft">保存本机草稿</button><button class="primary" bindtap="publish">发布到讨论</button></view><view class="tiny">下一步可预览公开内容。</view></block>
<view wx:if="{{error}}" class="note error">{{error}}</view></view>

<view wx:if="{{writingOpen}}" class="modal-backdrop" catchtap="closeWriting" />
<scroll-view wx:if="{{writingOpen}}" scroll-y class="post-writing-sheet"><view class="post-writing-body"><view class="handle" /><view class="row between"><view class="section-title">✧ 帖子写作助手</view><button class="icon-button" bindtap="closeWriting" aria-label="关闭写作助手"><image class="i" src="/assets/icons/close.png" /></button></view><view class="muted">先留下你的观察和想法，再整理成适合分享的文字。</view><view class="label">想怎么写</view><picker range="{{writingPurposes}}" value="{{writingPurpose}}" bindchange="writingPurpose"><view class="select-field">{{writingPurposes[writingPurpose]}}<view class="chevron" /></view></picker><view class="label">补充想法或要求</view><textarea auto-height value="{{writingInstructions}}" bindinput="writingInstructions" maxlength="1200" placeholder="如：想问鸟友是不是同一种鸟，语气自然一点，不补写未知地点。" /><button wx:if="{{image}}" class="writing-image-option" bindtap="writingImage" aria-pressed="{{writingIncludeImage}}"><view class="writing-checkbox">{{writingIncludeImage ? '✓' : ''}}</view><image src="{{image}}" mode="aspectFill" /><text>关联当前照片</text></button><view class="note">生成时会将当前标题、正文、写作要求及明确勾选的照片副本发送至团队 Qwen 网关。建议先预览，再由你应用和发布。</view><view wx:if="{{writingSummary}}" class="writing-summary">{{writingSummary}}</view><view wx:if="{{writingError}}" class="note error">{{writingError}}</view><button class="ai-button wide spaced" loading="{{writingBusy}}" disabled="{{writingBusy}}" bindtap="prepareWriting">生成写作建议</button><view wx:if="{{writingSuggestion}}" class="note"><view class="strong">{{writingSuggestion.title}}</view><view>{{writingSuggestion.body}}</view><button class="primary wide spaced" bindtap="applyWriting">采用建议，返回编辑</button></view><button class="quiet wide spaced" bindtap="closeWriting">返回帖子继续编辑</button></view></scroll-view>

<canvas id="journal-ai-canvas" type="2d" class="post-ai-canvas" />
