:host{display:block}.photo-card{max-width:100%;margin:12px auto 0;color:#285b49}.photo-stage{position:relative;width:100%;perspective:1100px;border-radius:15px}.photo-face{position:absolute;inset:0;overflow:hidden;border-radius:15px;border:1px solid #dce5d7;background:#eef2e7;box-sizing:border-box;backface-visibility:hidden;transition:transform .38s ease,opacity .22s ease}.photo-front{transform:rotateY(0);opacity:1}.photo-back{pointer-events:none;transform:rotateY(180deg);opacity:0}.photo-flipped .photo-front{transform:rotateY(-180deg);opacity:0;pointer-events:none}.photo-flipped .photo-back{pointer-events:auto;transform:rotateY(0);opacity:1}.photo-image{width:100%;height:100%;display:block;background:#fafbf5}.photo-hint{position:absolute;bottom:12px;left:12px;padding:5px 9px;border-radius:15px;background:#173e32b8;color:#fffef9;font-size:10px;pointer-events:none}.photo-watermark{position:absolute;inset:0;width:100%;height:100%;opacity:.12}.photo-data{position:relative;box-sizing:border-box;padding:18px}.photo-back-heading{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:600;margin-bottom:16px}.photo-camera{width:20px;height:20px}.photo-provenance{display:block;color:#7a8e70;font-size:10px;margin-bottom:4px}.photo-device{display:block;font-size:15px;font-weight:600}.photo-model{display:block;font-size:11px;margin-top:3px;color:#71836a}.photo-parameters{display:flex;flex-wrap:wrap;margin:12px -6px 0}.photo-parameter{width:50%;padding:7px 6px;box-sizing:border-box;display:flex;flex-direction:column;gap:4px}.photo-param-label{font-size:10px;color:#75876b}.photo-param-value{font-size:13px;line-height:1.5;overflow-wrap:break-word}.manual-provenance{margin-top:18px;padding-top:14px;border-top:1px solid #d3ddcc}.photo-copy,.photo-return{display:block;margin-top:14px;font-size:10px;color:#7d8f72;line-height:1.7}.photo-return{padding-bottom:20px;text-align:center}.photo-caption{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;padding-top:3px;font-size:10px;color:#7d8f72}.photo-expand{display:flex;align-items:center;justify-content:center;gap:5px;min-width:72px;min-height:36px;margin:0;padding:0 3px;border:0;border-radius:8px;background:transparent;color:#617f54;font-size:10px;line-height:1.4}.photo-expand::after{border:0}.photo-expand-icon{width:13px;height:13px}@media(prefers-reduced-motion:reduce){.photo-face{transition:none}}

.photo-caption-save{grid-template-columns:minmax(0,1fr) 88px minmax(0,1fr)}.photo-caption-label{min-width:0;justify-self:start}.photo-save{justify-self:center}.photo-preview{justify-self:end}.photo-data{touch-action:pan-y}.photo-return{width:100%;min-height:40px;margin-top:16px;border:0;background:transparent;color:#526f49;font-size:12px}

.photo-back-heading{padding-right:72px}.photo-return{position:absolute;z-index:4;right:8px;top:8px;width:auto;min-height:34px;margin:0;padding:6px 10px;border:1px solid #d6e1cf;border-radius:10px;background:#fffef9ed;color:#285b49;font-size:11px;line-height:20px}.photo-return::after{border:0}
