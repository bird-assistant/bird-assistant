<view class="page"><view wx:if="{{subject}}" class="own"><text>这次拍到的鸟</text><bird-crop src="{{subject.src}}" box="{{subject.box}}"/></view><view wx:if="{{ids.length<3}}" class="row"><input placeholder="添加对比鸟种" value="{{term}}" bindinput="input" bindconfirm="search"/><button size="mini" bindtap="search">搜索</button></view>
<button wx:for="{{matches}}" wx:key="id" data-id="{{item.id}}" bindtap="add">＋ {{item.name || item.english}}</button><view wx:if="{{notice}}">{{notice}}</view>
<scroll-view scroll-x><view class="columns"><view wx:for="{{ids}}" wx:key="*this" class="column"><guide-card bird-id="{{item}}"/><button wx:for="{{candidates}}" wx:for-item="candidate" wx:key="*this" wx:if="{{candidate === item}}" data-id="{{item}}" bindtap="choose">选用此候选</button><button data-id="{{item}}" bindtap="detail">出现地点与讨论</button><button size="mini" data-id="{{item}}" bindtap="remove">移出对比</button></view></view></scroll-view></view>
