@import "../../styles/writing-feedback.wxss";
.poll-preview{display:flex;flex-direction:column;gap:4px;margin:8px 0;padding:10px 12px;background:#edf4e9;border-radius:10px;color:#264c35;font-weight:600}
.poll-preview-tally{font-size:13px;font-weight:400;line-height:1.5}
.post-writing-sheet{position:fixed;z-index:150;bottom:0;left:0;right:0;width:100%;height:78vh;background:#fafbf5;border-radius:22px 22px 0 0;overflow:hidden}

.post-writing-body{padding:10px 19px calc(28px + env(safe-area-inset-bottom));box-sizing:border-box}

.post-writing-body .section-title{font-size:17px;margin:8px 0}
.post-writing-body .muted{font-size:12px;line-height:1.8}
.post-writing-body textarea{min-height:90px;line-height:1.8}

.writing-image-option{display:flex;align-items:center;justify-content:flex-start;gap:10px;width:100%;min-height:64px;margin-top:14px;padding:10px;background:#edf3e7;font-size:12px;text-align:left}

.writing-image-option image{width:44px;height:44px;flex:none;border-radius:7px}
.writing-checkbox{width:19px;height:19px;flex:none;display:flex;align-items:center;justify-content:center;border:1px solid #a8bba0;border-radius:4px;background:#fffef9;color:#285b49}

.writing-summary{padding:14px;background:#eef2e8;border:1px solid #d6e0ce;border-radius:12px;color:#385b43;font-size:12px;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}

.post-ai-canvas{position:fixed;left:-10000px;top:-10000px;width:1px;height:1px;pointer-events:none}

/* The discussion tab is a feed; secondary tools sit behind its compact menu. */
.forum-page{max-width:720px;padding:12px 16px calc(108px + env(safe-area-inset-bottom));background:#fafbf5}
.forum-topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.forum-caption{font-size:13px;color:#7b8974}
.forum-tools{display:flex;align-items:center;gap:8px}
.feed-refresh,.new-post,.forum-tab,.post-action,.feed-more,.inline-retry,.compose-tool,.save-post,.publish-post{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;margin:0;line-height:1.4}
.feed-refresh{width:42px;height:42px;min-height:42px;padding:10px;background:transparent}
.tool-icon{width:20px;height:20px;flex:none}
.new-post{height:40px;min-height:40px;padding:0 14px;background:#285b49;color:white;font-size:13px}
.forum-tabs{display:flex;align-items:center;gap:6px;padding:4px;border:1px solid #e2e9da;background:#edf3e7;border-radius:12px;margin-bottom:16px}
.forum-tab{flex:1;width:0;min-height:36px;padding:7px 2px;background:transparent;font-size:12px;color:#71816b;white-space:nowrap;border-radius:9px}
.forum-tab.selected{background:#fffef9;color:#285b49;font-weight:600;box-shadow:0 1px 4px #253c3410}
.post-card{padding:14px;margin:0 0 12px;border:1px solid #dce5d7;border-radius:15px;background:#fffef9}
.post-author{display:flex;align-items:center;gap:9px}
.author-avatar{height:34px;width:34px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#edf3e7;color:#597652;font-size:13px}
.author-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:2px}
.author-name{font-size:13px;font-weight:600;color:#385444;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.post-time{font-size:11px;color:#8a9682}
.post-topic{flex:none;font-size:10px;border:1px solid #dce5d7;border-radius:6px;padding:2px 6px;color:#72866b}
.post-open{display:flex;align-items:flex-start;gap:12px;margin-top:12px;min-width:0}
.post-copy{min-width:0;flex:1}
.post-title{font-size:17px;font-weight:600;line-height:1.55;margin:0 0 6px;color:#253c34;overflow-wrap:anywhere}
.post-body{font-size:14px;line-height:1.75;white-space:pre-wrap;color:#6b7e64;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.feed-thumbnail{width:90px;height:90px;flex:none;display:block;border:1px solid #e2e9da;border-radius:10px;background:transparent}
.post-actions{display:flex;gap:4px;margin-top:12px;padding-top:7px;border-top:1px solid #edf1e7}
.post-actions .post-action{flex:1;width:0;min-height:38px;gap:6px;padding:7px 0;background:transparent;font-size:12px;color:#7b8974}
.post-actions .action-icon{width:17px;height:17px;opacity:.65}
.post-actions .is-on{color:#285b49;font-weight:600}
.post-actions .is-on .action-icon{opacity:1}
.feed-more{width:100%;min-height:44px;padding:10px;background:transparent;border:1px solid #dce5d7;color:#285b49;font-size:13px}
.feed-status{padding:20px 0;text-align:center;font-size:12px;color:#899680}
.forum-error{padding:12px 14px;border:1px solid #ead6c5;border-radius:12px;background:#fff6ee;color:#8a5f45;font-size:13px;line-height:1.7;margin-bottom:12px}
.inline-retry{min-height:34px;padding:4px 10px;background:transparent;color:#8a5f45;display:inline-flex}
.forum-empty{display:flex;flex-direction:column;align-items:center;gap:12px;padding:42px 18px;border:1px dashed #d7e2d2;border-radius:16px;font-size:13px;color:#829178;text-align:center}
.empty-chat{width:34px;height:34px;opacity:.45}
.empty-title{font-size:17px;font-weight:600;color:#526f49}
.forum-empty .new-post{margin-top:6px}
.compose-intro{font-size:13px;color:#829178;margin:4px 0 14px}
.compose-title{height:50px;min-height:50px;padding:0 12px;font-size:18px;font-weight:600;line-height:50px;background:#fffef9;border:1px solid #dce5d7}
.compose-body{width:100%;min-height:220px;max-height:420px;box-sizing:border-box;margin-top:12px;padding:12px;background:#fffef9;border:1px solid #dce5d7;border-radius:12px;font-size:15px;line-height:1.85}
.compose-counter{text-align:right;font-size:11px;color:#8a9682;margin:6px 2px 12px}
.compose-tools{display:flex;gap:10px}
.compose-tool{flex:1;width:0;min-height:44px;gap:6px;padding:10px 6px;font-size:13px;border:1px solid #dce5d7;background:#fffef9}
.compose-photo{display:block;max-width:100%;width:100%;height:200px;background:transparent;margin-top:14px;border:1px solid #dce5d7;border-radius:12px}
.compose-footer{display:flex;gap:10px;margin:22px 0 10px}
.save-post{flex:1;min-height:46px;background:#edf3e7;color:#285b49;font-size:13px}
.publish-post{flex:1.65;min-height:46px;background:#285b49;color:white;font-size:14px}
.compose-note{display:block;font-size:12px;line-height:1.8;color:#829178}
.forum-page.focused-page{padding-bottom:calc(28px + env(safe-area-inset-bottom))}

/* Three small silhouettes cross the refresh control in a staggered flight. */
.flight-loader{position:relative;width:42px;height:26px;overflow:hidden}
.flight-bird{position:absolute;left:-12px;top:10px;width:14px;height:7px;animation:bird-flight 1.5s ease-in-out infinite;opacity:0}
.flight-bird::before,.flight-bird::after{content:"";position:absolute;top:1px;width:8px;height:5px;border-top:2px solid #285b49;border-radius:50%}
.flight-bird::before{left:0;transform:rotate(22deg)}.flight-bird::after{right:0;transform:rotate(-22deg)}
.bird-two{animation-delay:.2s;top:6px}.bird-three{animation-delay:.4s;top:12px}
@keyframes bird-flight{0%{transform:translate(0,3px);opacity:0}20%{opacity:1}55%{transform:translate(28px,-2px);opacity:1}100%{transform:translate(60px,1px);opacity:0}}
@media (prefers-reduced-motion:reduce){.flight-bird{animation:none;opacity:1;left:0}.bird-two{left:14px}.bird-three{left:28px}}
.forum-menu-backdrop{position:fixed;inset:0;z-index:170;background:#17352b65}
.forum-menu{position:fixed;z-index:171;bottom:0;left:0;right:0;margin:auto;max-width:620px;padding:10px 18px calc(22px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0;background:#fafbf5;box-sizing:border-box;box-shadow:0 -8px 32px #17352b20}
.menu-handle{height:3px;width:32px;margin:0 auto 15px;border-radius:3px;background:#cbd7c3}
.menu-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.menu-title{display:block;font-size:20px;font-weight:600;color:#285b49}.menu-subtitle{display:block;font-size:12px;line-height:1.7;color:#819076;margin-top:4px}
.menu-close{width:38px;height:38px;min-height:38px;padding:0;margin:0;line-height:36px;border-radius:50%;background:#edf3e7;color:#597652;font-size:24px;flex:none}
.menu-grid{display:flex;flex-wrap:wrap;gap:10px}.menu-item{width:calc(50% - 5px);height:78px;min-height:78px;display:flex;align-items:center;gap:10px;margin:0;padding:12px 10px;border:1px solid #dce5d7;background:#fffef9;border-radius:14px;text-align:left;box-sizing:border-box;line-height:1.5}
.menu-icon-wrap{width:32px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#edf3e7;flex:none}.menu-icon{width:20px;height:20px}.menu-copy{min-width:0;display:flex;flex-direction:column;gap:3px}.menu-label{font-size:13px;font-weight:600;color:#385444}.menu-hint{font-size:10px;color:#829178;white-space:nowrap}.menu-dismiss{margin:16px 0 0;width:100%;min-height:42px;background:#edf3e7;color:#597652;font-size:13px}

.forum-scroll{width:100%;box-sizing:border-box}.pull-refresh{height:64px;display:flex;align-items:center;justify-content:center;gap:14px;box-sizing:border-box;color:#73876a;font-size:12px;background:#fafbf5}.pull-flight{width:58px;height:28px;flex:none}.pull-flight .flight-bird{animation-play-state:paused;opacity:1;top:10px}.pull-flight .bird-one{left:3px}.pull-flight .bird-two{left:20px;top:7px}.pull-flight .bird-three{left:37px}.pull-flight.is-flying .flight-bird{left:-12px;animation-play-state:running}.forum-page{padding-bottom:28px}.post-card{animation:post-arrive .18s ease-out}@keyframes post-arrive{from{opacity:.5;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.post-card{animation:none}}

@media(prefers-reduced-motion:reduce){.pull-flight.is-flying .flight-bird{animation:none;opacity:1;left:3px}.pull-flight.is-flying .bird-two{left:20px}.pull-flight.is-flying .bird-three{left:37px}}

.post-action-hover{background:#edf3e7}

.compose-tools{flex-wrap:wrap;gap:8px}.compose-tools .compose-tool{flex:1;min-width:90px;padding:10px 6px}.compose-footer{margin-top:22px}

.drafts-entry{width:auto;min-height:38px;margin:0;padding:8px 11px;font-size:12px;background:#e9f0e2;border:1px solid #cfddc5;color:#385d45}.draft-resume{width:100%;min-height:38px;margin:4px 0 14px;padding:9px 12px;background:#edf3e7;color:#285b49;text-align:left;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.draft-shelf-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:4px 0 18px}.draft-shelf-top>view{flex:1;min-width:0}.draft-shelf-top button{width:auto;min-width:90px;margin:0;padding:10px;font-size:12px}.draft-shelf-card{border:1px solid #dce5d7;border-radius:14px;background:#fffef9;padding:14px;margin:12px 0}.draft-shelf-content{display:flex;gap:12px;align-items:flex-start}.draft-shelf-content>view{flex:1;min-width:0}.draft-shelf-cover{width:72px;height:80px;flex:none;border-radius:8px;background:#edf1e5}.draft-excerpt{font-size:13px;line-height:1.7;color:#71836a;margin:6px 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.draft-card-actions{display:flex;gap:10px;margin-top:12px}.draft-card-actions button{flex:1;width:0;min-width:0;min-height:36px;padding:8px;font-size:12px}.draft-compose-status{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#819175;gap:12px;margin-bottom:8px}.draft-compose-status button{width:auto;margin:0;min-height:30px;padding:5px 8px;font-size:12px}.post-writing-photos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:10px 0}.writing-photo{width:100%;min-width:0;padding:7px;background:#f3f6ed;border:1px solid #d5e1cc;text-align:left;font-size:12px;line-height:1.5}.writing-photo-selected{border:2px solid #285b49;padding:6px;background:#eaf1e2}.writing-photo image{display:block;width:100%;height:96px;border-radius:7px;margin-bottom:6px}.post-ai-answer{font-size:14px;line-height:1.9;white-space:pre-wrap;margin:12px 0}

.ai-result-editor,.ai-caption-preview textarea,.post-ai-answer{box-sizing:border-box;width:100%;min-height:70px;font-size:14px;line-height:1.85;background:#fffef9;border:1px solid #d8e3d1;border-radius:10px;padding:10px 12px;margin:10px 0;white-space:pre-wrap}

/* Native button defaults use a row; give each association card its own column. */
.writing-photo{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;height:140px;min-height:140px;white-space:normal}.writing-photo image{flex:none;width:100%;height:96px}.writing-photo-label{display:block;width:100%;min-width:0;height:20px;min-height:20px;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left}.draft-times{font-size:11px;line-height:1.7;color:#819175;margin:7px 0}.draft-times view{white-space:normal;overflow-wrap:break-word}
.menu-close{display:flex;align-items:center;justify-content:center;line-height:1;padding:0;align-self:flex-start}.menu-close .menu-close-icon{display:block;width:18px;height:18px;margin:0;flex:none}.forum-menu{animation:discovery-arrive .24s cubic-bezier(.2,.7,.25,1)}@keyframes discovery-arrive{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.forum-menu{animation:none}}

.forum-menu{padding:0}.forum-menu .menu-top{padding:10px 18px 0}.menu-content{padding:0 18px calc(22px + env(safe-area-inset-bottom))}.menu-item{height:auto;min-height:78px}.menu-hint{white-space:normal}.menu-heading>view{min-width:0;flex:1}.menu-heading{align-items:flex-start}.menu-title{line-height:1.5}.menu-close{margin:1px 0 0;transform:none}.discovery-scroll{width:100%}
