x-height:128px;height:auto;padding:11px 12px;font-size:14px;line-height:1.7}.social .composer button{flex:none;min-width:62px;min-height:44px;margin:0;font-size:14px}.bubble{border:1px solid #e0e8d9;line-height:1.8;overflow-wrap:anywhere}.bubble.own{border-color:#d0dfc6}.social .line>button{flex:none}.identity>view{min-width:0}.social .identity .title{font-size:23px;overflow-wrap:anywhere}
