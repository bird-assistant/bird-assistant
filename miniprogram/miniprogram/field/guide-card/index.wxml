<view class="guide"><block wx:if="{{bird}}">
  <view class="name">{{bird.name || bird.english}}</view><view class="latin">{{bird.scientific}}</view>
  <image wx:if="{{src}}" class="reference" src="{{src}}" mode="aspectFit" bindtap="showPhoto" />
  <view wx:if="{{photo}}" class="credit" data-url="{{photo.sourceUrl}}" bindtap="copySource">{{photo.credit}} · {{photo.license}} · iNaturalist ↗</view>
  <button wx:else size="mini" loading="{{busy}}" bindtap="findPhoto">查找参考照片</button>
  <view wx:if="{{bird.guide.mark}}" class="mark" data-url="{{bird.guide.markUrl}}" bindtap="copySource">{{bird.guide.mark}} · RSPB ↗</view>
  <view wx:for="{{bird.guide.fields}}" wx:key="key" class="trait"><text>{{item.label}}</text><text>{{item.value}}</text></view>
  <view wx:if="{{bird.guide.fields.length}}" class="credit" data-url="{{bird.guide.sourceUrl}}" bindtap="copySource">物种平均值{{bird.guide.inferred ? '，含推定性状' : ''}} · {{bird.guide.source}} ↗</view>
  <view wx:else class="credit">此鸟种的形态和生态资料待补充。</view>
</block><view wx:if="{{notice}}" class="credit">{{notice}}</view><button wx:if="{{notice && !bird}}" size="mini" bindtap="loadBird">重新加载</button></view>
