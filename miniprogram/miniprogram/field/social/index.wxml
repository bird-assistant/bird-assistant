<app-header title="{{pageTitle}}" back bindback="back"/>
<view class="page social">
  <view wx:if="{{error}}" class="note error">{{error}} <button size="mini" bindtap="start">重新加载</button></view>
  <view wx:if="{{!ready}}" class="note">正在获取账号…</view>
  <view wx:elif="{{!active}}" class="card">
    <view class="title">加入鸟友社区</view><view class="muted">使用当前微信账号登录，首次登录可创建鸟友号。</view>
    <button class="primary" loading="{{working}}" bindtap="login">微信登录 / 注册</button>
  </view>
  <view wx:elif="{{error && !registered && !self}}" class="note">请重新加载账号资料。</view>
  <view wx:elif="{{!registered || editing}}" class="card">
    <view class="title">{{registered ? '编辑社区资料' : '创建鸟友账号'}}</view>
    <view class="label">社区昵称</view><input maxlength="24" value="{{form.nickname}}" data-field="nickname" bindinput="formInput" placeholder="鸟友看到的名字" />
    <view class="label">鸟友号</view><input maxlength="24" value="{{form.handle}}" data-field="handle" bindinput="formInput" placeholder="3–24 位字母、数字或下划线" />
    <view class="label">个人简介</view><textarea maxlength="160" value="{{form.bio}}" data-field="bio" bindinput="formInput" placeholder="喜欢在哪里观鸟？" />
    <view class="label">社区头像</view><view class="choices"><button wx:for="{{avatars}}" wx:key="*this" class="avatar-choice {{form.avatar === item ? 'picked' : ''}}" data-field="avatar" data-value="{{item}}" bindtap="choice"><profile-avatar avatar="{{item}}" name="{{form.nickname}}" size="42"/></button></view>
    <view class="line"><text>允许通过鸟友号或昵称搜索</text><switch checked="{{form.discoverable}}" bindchange="toggleSearch" color="#285b49" /></view>
    <view class="label">允许谁发私信</view><view class="choices"><button class="{{form.dm === 'friends' ? 'picked' : ''}}" data-field="dm" data-value="friends" bindtap="choice">好友</button><button class="{{form.dm === 'everyone' ? 'picked' : ''}}" data-field="dm" data-value="everyone" bindtap="choice">所有鸟友</button></view>
    <view class="label">谁能查看我收藏的公开内容</view><view class="choices"><button wx:for="{{visibilities}}" wx:key="*this" class="{{form.bookmarks === item ? 'picked' : ''}}" data-field="bookmarks" data-value="{{item}}" bindtap="choice">{{visibilityNames[index]}}</button></view>
    <button class="primary" bindtap="save" loading="{{working}}">{{registered ? '保存修改' : '完成注册'}}</button>
    <button wx:if="{{editing}}" bindtap="cancel">取消</button><button wx:else bindtap="logout">退出本机账号</button>
  </view>
  <block wx:elif="{{screen === 'account'}}">
    <view class="card identity"><profile-avatar avatar="{{account.avatar}}" name="{{account.nickname}}" size="64"/><view><view class="title">{{account.nickname}}</view><view>@{{account.handle}}</view><view class="muted">{{account.bio}}</view></view></view>
    <button class="primary" bindtap="edit">编辑社区资料与隐私</button>
    <view class="choices"><button data-screen="member" data-id="{{self}}" bindtap="go">我的主页</button><button data-screen="friends" bindtap="go">我的好友</button><button data-screen="inbox" bindtap="go">私信与通知</button><button data-screen="groups" bindtap="go">我的群聊</button><button data-screen="blocked" bindtap="go">屏蔽名单</button></view>
    <button bindtap="logout">退出本机账号</button>
  </block>
  <block wx:elif="{{screen === 'friends'}}">
    <view class="line"><input maxlength="64" value="{{term}}" data-field="term" bindinput="input" bindconfirm="search" placeholder="搜索昵称或完整鸟友号"/><button bindtap="search">搜索</button></view>
    <view wx:if="{{searched}}" class="card"><view class="strong">搜索结果</view><button wx:for="{{matches}}" wx:key="id" data-screen="member" data-id="{{item.id}}" bindtap="go">{{item.nickname}} · @{{item.handle}}</button><view wx:if="{{!matches.length}}" class="muted">没有找到可搜索的鸟友。</view></view>
    <view class="social-tabs"><button class="{{friendTab === 'accepted' ? 'social-tab-on' : ''}}" data-tab="accepted" bindtap="friendTab">鸟友 {{accepted.length}}</button><button class="{{friendTab === 'incoming' ? 'social-tab-on' : ''}}" data-tab="incoming" bindtap="friendTab">收到申请 {{incoming.length}}</button><button class="{{friendTab === 'outgoing' ? 'social-tab-on' : ''}}" data-tab="outgoing" bindtap="friendTab">已发申请 {{outgoing.length}}</button></view>
    <block wx:if="{{friendTab === 'incoming'}}"><view class="social-section-copy">认识新鸟友<text>接受后成为好友；你的私信权限仍由账号设置决定。</text></view><view class="friend-card" wx:for="{{incoming}}" wx:key="id"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view><text class="friend-state">待你确认</text></view><view class="friend-actions"><button class="friend-accept" disabled="{{working}}" data-op="accept" data-id="{{item.id}}" bindtap="mutate">接受申请</button><button disabled="{{working}}" data-op="decline" data-id="{{item.id}}" bindtap="mutate">暂不接受</button></view></view><view wx:if="{{!incoming.length}}" class="social-empty">暂时没有新申请</view></block>
    <block wx:elif="{{friendTab === 'outgoing'}}"><view class="social-section-copy">等待回应<text>申请不会直接打开私信权限，也不会自动把对方加入群聊。</text></view><view class="friend-card" wx:for="{{outgoing}}" wx:key="id"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view></view><view class="friend-actions"><text>等待对方确认</text><button disabled="{{working}}" data-op="cancel" data-id="{{item.id}}" bindtap="mutate">撤回申请</button></view></view><view wx:if="{{!outgoing.length}}" class="social-empty">没有等待中的申请</view></block>
    <block wx:else><view wx:for="{{accepted}}" wx:key="id" class="friend-card"><view class="friend-identity" data-screen="member" data-id="{{item.id}}" bindtap="go"><profile-avatar avatar="{{item.avatar}}" name="{{item.nickname}}" size="44"/><view><text class="friend-name">{{item.nickname}}</text><text class="friend-handle">@{{item.handle}}</text></view><button class="friend-message" data-screen="chat" data-id="{{item.id}}" catchtap="go" aria-label="私信{{item.nickname}}"><image src="/assets/icons/chat.png"/></button></view></view><view wx:if="{{!accepted.length}}" class="social-empty"><view>还没有鸟友</view><text>搜索鸟友号，或从讨论作者主页发起申请。</text></view></block>
  </block>
  <block wx:elif="{{screen === 'member' && member}}">
    <view class="identity card"><profile-avatar avatar="{{member.profile.avatar}}" name="{{member.profile.nickname}}" size="64"/><view><view class="title">{{member.profile.nickname}}</view><view wx:if="{{member.profile.handle}}">@{{member.profile.handle}}</view><view class="muted">{{member.profile.bio}}</view></view></view>
    <view wx:if="{{id !== self}}" class="choices">
      <button wx:if="{{member.registered && member.relationship === 'none'}}" class="picked" data-op="request" bindtap="mutate">申请加好友</button>
      <button wx:if="{{member.relationship === 'incoming'}}" data-op="accept" bindtap="mutate">接受申请</button><button wx:if="{{member.relationship === 'incoming'}}" data-op="decline" bindtap="mutate">拒绝</button>
      <button wx:if="{{member.relationship === 'outgoing'}}" data-op="cancel" bindtap="mutate">等待确认 · 撤回</button><button wx:if="{{member.canMessage}}" data-screen="chat" data-id="{{id}}" bindtap="go">发私信</button>
      <button wx:if="{{member.relationship === 'friends'}}" data-op="remove" bindtap="mutate">移除好友</button><button data-op="block" bindtap="mutate">屏蔽</button>
    </view>
    <view class="section-title">署名发布</view><button wx:for="{{member.posts}}" wx:key="id" data-screen="record" data-id="{{item.id}}" bindtap="go">{{item.title}}</button><view wx:if="{{!member.posts.length}}" class="muted">还没有公开的署名帖子。</view>
    <block wx:if="{{member.showBookmarks}}"><view class="section-title">社区书签</view><button wx:for="{{member.bookmarks}}" wx:key="id" data-screen="record" data-id="{{item.id}}" bindtap="go">{{item.title}}</button><view wx:if="{{!member.bookmarks.length}}" class="muted">还没有收藏的公开内容。</view></block>
  </block>
  <block wx:elif="{{screen === 'inbox'}}">
    <block wx:if="{{identifications.length}}"><view class="section-title">我的求鉴定帖</view><button wx:for="{{identifications}}" wx:key="post" class="conversation" data-screen="record" data-id="{{item.post}}" bindtap="go"><text>{{item.title}}</text><text class="excerpt">{{item.poll.result ? '已采纳 '+item.poll.result.name : '已有鸟友参与鉴定'}} · {{item.poll.total}} 票</text></button></block>
    <view class="notification-tools"><button data-screen="friends" bindtap="go" hover-class="press-feedback"><image src="/assets/icons/user.png"/><text>好友申请</text><text class="notification-count">{{incoming.length}}</text></button><button data-screen="groups" bindtap="go" hover-class="press-feedback"><image src="/assets/icons/chat.png"/><text>群聊邀请</text><text class="notification-count">{{invites.length}}</text></button></view>
    <view class="section-title">最近私信</view><button class="conversation conversation-with-avatar" wx:for="{{inbox}}" wx:key="peer" data-screen="chat" data-id="{{item.peer}}" bindtap="go" hover-class="press-feedback"><profile-avatar avatar="{{item.profile.avatar}}" name="{{item.profile.nickname}}" size="42"/><view class="conversation-copy"><view class="conversation-title"><text>{{item.profile.nickname}}</text><text wx:if="{{item.unread}}" class="unread">{{item.unread > 99 ? '99+' : item.unread}}</text></view><text class="excerpt">{{item.body}}</text><text class="tiny">{{item.timeLabel}}</text></view></button>
    <view wx:if="{{!inbox.length}}" class="social-empty"><image src="/assets/icons/chat.png"/><view>还没有私信</view><text>从鸟友主页发起对话，或邀请好友一起观鸟。</text></view><view class="section-title">帖子收到的回复</view><button class="conversation" wx:for="{{activity}}" wx:key="id" data-screen="record" data-id="{{item.post}}" bindtap="go" hover-class="press-feedback"><text class="strong">{{item.nickname}}</text><text class="excerpt">{{item.body}}</text><text class="tiny">{{item.timeLabel}}</text></button><view wx:if="{{!activity.length}}" class="social-empty compact-social-empty">还没有公开回复</view>
  </block>
  <block wx:elif="{{screen === 'groups'}}"><view class="social-section-copy">一起去看鸟<text>邀请须由对方确认；群内消息仅对成员开放。</text></view>
    <view class="line group-create"><input value="{{groupName}}" data-field="groupName" bindinput="input" placeholder="新群聊名称" maxlength="40"/><button bindtap="createGroup" loading="{{working}}">建群</button></view>
    <view wx:if="{{invites.length}}" class="section-title">群聊邀请</view><view wx:for="{{invites}}" wx:key="id" class="card">{{item.name}}<view class="choices"><button data-id="{{item.id}}" data-op="join" bindtap="mutate">加入</button><button data-id="{{item.id}}" data-op="reject" bindtap="mutate">拒绝</button></view></view>
    <view class="section-title">已加入的群聊</view><button class="group-row" wx:for="{{groups}}" wx:key="id" data-screen="group" data-id="{{item.id}}" bindtap="go"><image class="group-symbol" src="/assets/icons/chat.png"/><text class="group-label">{{item.name}}</text><text wx:if="{{item.unread}}" class="unread">{{item.unread}} 条未读</text></button><view wx:if="{{!groups.length}}" class="muted">创建一个群聊，再邀请鸟友加入。</view>
  </block>
  <block wx:elif="{{screen === 'chat' || screen === 'group'}}">
    <view class="conversation-context"><image src="/assets/icons/chat.png"/><text>{{screen === 'chat' ? '鸟友私信 · 仅双方可见' : '观鸟群聊 · 仅成员可见'}}</text></view><button wx:if="{{screen === 'chat'}}" data-screen="member" data-id="{{id}}" bindtap="go">查看鸟友主页</button>
    <block wx:if="{{group}}"><view class="strong">群成员 · {{group.members.length}}</view><view class="choices"><button wx:for="{{group.members}}" wx:key="id" data-screen="member" data-id="{{item.id}}" bindtap="go">{{item.nickname}}</button></view>
      <block wx:if="{{group.owner === self}}"><view class="label">邀请好友</view><view wx:if="{{!invitees.length}}" class="muted">暂无可邀请的好友。</view><view class="choices"><button wx:for="{{invitees}}" wx:key="id" data-id="{{item.id}}" data-op="invite" bindtap="mutate">邀请 {{item.nickname}}</button></view></block></block>
    <button wx:if="{{earlier}}" bindtap="older">加载更早的消息</button><view wx:if="{{!lines.length}}" class="social-empty"><image src="/assets/icons/chat.png"/><view>从一句问候开始</view><text>这里的消息仅对会话成员可见。</text></view>
    <view wx:for="{{lines}}" wx:key="id" class="bubble {{item.sender === self ? 'own' : ''}}"><view class="tiny">{{item.sender === self ? '我' : item.nickname || member.profile.nickname}} · {{item.timeLabel}}</view><text selectable="true">{{item.body}}</text><button wx:if="{{item.sender !== self}}" size="mini" data-op="report" data-id="{{item.id}}" bindtap="mutate">举报</button></view>
    <view class="composer" wx:if="{{group || member.canMessage}}"><textarea auto-height cursor-spacing="18" maxlength="2000" data-field="text" value="{{text}}" bindinput="input" placeholder="写消息…"/><button class="primary" bindtap="send" loading="{{working}}" disabled="{{!text || working}}" hover-class="press-feedback">发送</button></view>
    <button wx:if="{{group}}" data-op="{{group.owner === self ? 'disband' : 'leave'}}" bindtap="mutate">{{group.owner === self ? '解散群聊' : '退出群聊'}}</button>
  </block>
  <block wx:elif="{{screen === 'blocked'}}"><view wx:if="{{!blocked.length}}" class="muted">屏蔽名单为空。</view><view class="line card" wx:for="{{blocked}}" wx:key="id"><text>{{item.nickname}}</text><button data-op="unblock" data-id="{{item.id}}" bindtap="mutate">解除屏蔽</button></view></block>
</view>
