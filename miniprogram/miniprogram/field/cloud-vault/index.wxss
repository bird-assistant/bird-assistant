.vault-page{padding-bottom:calc(35px + env(safe-area-inset-bottom));max-width:720px}.vault-page .title{font-size:28px;line-height:1.5}.vault-page .subtitle{font-size:13px}.vault-pending{padding:25px 22px;border:1px dashed #cbdaba;background:#f0f5e9;border-radius:20px;margin:24px 0;color:#5c7c53;text-align:center}.vault-pending image{width:32px;height:32px;margin-bottom:12px}.vault-pending>view{font-size:16px;font-weight:600}.vault-pending>text{display:block;font-size:12px;line-height:1.9;color:#839578;margin-top:13px}.vault-local{margin-top:24px;background:#edf3e5}.vault-number{font-family:Georgia,serif;font-size:38px;display:block;line-height:1.5;margin:10px 0 4px}.vault-cloud-copy{font-size:19px;margin:14px 0 8px;color:#5d7953}.vault-names{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.vault-names>text{padding:5px 9px;border-radius:8px;background:#f0f4e9;color:#728b63;font-size:11px}.vault-actions{display:flex;gap:10px;margin-top:12px}.vault-actions button{flex:1;min-width:0;font-size:12px}.vault-remove{display:block;margin:20px auto 0;font-size:11px;color:#967964}.vault-page>.tiny{font-size:11px;line-height:1.9}.vault-page button.wide{font-size:13px}@media(min-width:860px){.vault-page{max-width:980px;display:grid;grid-template-columns:minmax(280px,.8fr) minmax(420px,1.2fr);column-gap:24px}.vault-page>.eyebrow,.vault-page>.title,.vault-page>.subtitle,.vault-page>.vault-pending,.vault-page>.note,.vault-page>.tiny{grid-column:1/-1}.vault-local{margin-top:0}.vault-cloud{align-self:start}}

.vault-page .tiny,.vault-page .muted,.vault-pending>text{color:#53694c;font-size:12px}.vault-names>text{color:#53694c;font-size:12px}
