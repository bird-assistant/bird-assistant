{
  "description": "羽迹 Bird Assistant native development project",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "projectname": "bird-assistant-miniprogram",
  "appid": "touristappid",
  "libVersion": "3.17.1",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "useCompilerPlugins": [
      "typescript"
    ],
    "skylineRenderEnable": false,
    "compileHotReLoad": false,
    "ignoreDevUnusedFiles": false,
    "ignoreUploadUnusedFiles": false
  },
  "packOptions": {
    "ignore": [],
    "include": []
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
